+/// \brief codes in, PCM out; state carries across calls so chunks join seamlessly
+class AudioDecoder {
+public:
+    virtual ~AudioDecoder() = default;
+    static constexpr int kCodebooks = 16;
+    static constexpr int kFrameSamples = 1920;   // 24000 Hz / 12.5 Hz
+    /// \brief forget all streaming state (start of a new utterance)
+    virtual void reset() = 0;
+    /// \brief decode `frames` frames of codes [frames][16]; appends frames*1920 samples
+    virtual void decode(const int32_t* codes, int frames, std::vector<float>& pcm) = 0;
+};
+
+/// \brief exact streaming decoder on the CPU (AVX-512), weights from the speech
+///        tokenizer's model.safetensors
+/// \param cpus logical CPUs for the decoder's thread pool; cpus[0] is the calling thread
