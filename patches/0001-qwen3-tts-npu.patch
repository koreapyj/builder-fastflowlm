+#pragma once
+// Host-side (CPU) parts of Qwen3-TTS generation: text and codec embeddings, the codec
+// and code-predictor heads, the small_to_mtp projection and sampling.
+#include <cstdint>
+#include <memory>
+#include <random>
+#include <string>
+#include <vector>
+
+#include "qwen3_tts/tts_gemm.hpp"
+
+namespace qwen3_tts {
+
+struct SamplerCfg { float temperature = 0.9f; int top_k = 50; };
+
+/// \brief HF-equivalent sampling: penalties/masks are applied by the caller
+int sample_topk(std::vector<float>& logits, const SamplerCfg& cfg, std::mt19937_64& rng);
+
+/// \brief the full sampling distribution softmax(logits / T) (masked entries -> 0), no top-k
+std::vector<double> softmax_t(const std::vector<float>& logits, float temperature);
+
+class TtsHost {
+public:
+    static constexpr int kTalkerD = 2048, kCpD = 1024, kGroups = 16, kCodeV = 2048, kTalkerV = 3072;
+    static constexpr int kEos = 2150;
+
+    /// \param prec host heads/projection: bf16 (deployable) or bf16w (fp32 compute)
+    TtsHost(const std::string& tts_safetensors, ThreadPool* pool, Prec prec = Prec::bf16);
+    const SafeTensorFile& file() const { return *f_; }
+
+    /// \brief talker logits = codec_head . h
+    void talker_logits(const float* h, std::vector<float>& out);
+    /// \brief code predictor input row = small_to_mtp_projection(v[2048])
+    void project(const float* v, float* out);
+    /// \brief predictor head k (0..14) logits from predictor hidden
+    void cp_logits(int k, const float* h, std::vector<float>& out);
+    /// \brief text_projection(text_embedding(token)) (fp32, 2048), the talker's text input
+    void text_embed(int token, float* out);
+    static constexpr int kTtsBos = 151672, kTtsEos = 151673, kTtsPad = 151671, kCodecBos = 2149;
+    /// \brief talker codec embedding of code0 (fp32, 2048)
+    void talker_embed(int code, float* out) const;
+    /// \brief predictor codec embedding k (0..14) of code (fp32, 2048)
+    void cp_embed(int k, int code, float* out) const;
+
+private:
+    std::unique_ptr<SafeTensorFile> f_;
+    ThreadPool* pool_;
+    std::vector<uint16_t> talker_emb_;             // [3072][2048]
+    const uint16_t* text_emb_ = nullptr;           // [151936][2048] bf16, mmapped
+    PackedW text_fc1_, text_fc2_;
+    std::vector<std::vector<uint16_t>> cp_emb_;    // 15 x [2048][2048]
+    PackedW codec_head_, proj_, lm_head_[15];
+    GemmInput gi_;
+};
+
