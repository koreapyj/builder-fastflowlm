+using qwen3_tts::TtsRequest;
+using qwen3_tts::TtsResult;
+using qwen3_tts::TtsSink;
+
+namespace {
+
+constexpr int kRate = Qwen3Tts::kSampleRate;
+
+/// \brief 44-byte WAV header for 16-bit mono PCM; data_bytes 0xFFFFFFFF = unknown (streaming)
+std::string wav_header(uint32_t data_bytes) {
+    std::string h(44, '\0');
+    auto u32 = [&](size_t o, uint32_t v) { for (int i = 0; i < 4; i++) h[o + i] = (char)((v >> (8 * i)) & 0xFF); };
+    auto u16 = [&](size_t o, uint16_t v) { h[o] = (char)(v & 0xFF); h[o + 1] = (char)(v >> 8); };
+    h.replace(0, 4, "RIFF");
+    u32(4, data_bytes == 0xFFFFFFFFu ? 0xFFFFFFFFu : 36 + data_bytes);
+    h.replace(8, 8, "WAVEfmt ");
+    u32(16, 16); u16(20, 1); u16(22, 1); u32(24, kRate); u32(28, kRate * 2); u16(32, 2); u16(34, 16);
+    h.replace(36, 4, "data");
+    u32(40, data_bytes);
+    return h;
+}
+
+json error_json(int code, const std::string& msg) { return json{{"error", {{"code", code}, {"message", msg}}}}; }
+
+/// \brief common request fields -> TtsRequest; "" on success, else the problem
+std::string parse_tts_fields(const json& j, Qwen3Tts& eng, TtsRequest& rq) {
+    rq.voice = j.value("voice", "");
+    rq.language = j.value("language", "");
+    if (rq.language == "Auto" || rq.language == "AUTO") rq.language = "auto";
+    if (j.contains("seed") && j["seed"].is_number_integer()) rq.seed = j["seed"].get<uint64_t>();
+    if (j.contains("temperature") && j["temperature"].is_number()) rq.temperature = j["temperature"].get<float>();
+    if (j.contains("instructions") && j["instructions"].is_string() && !j["instructions"].get<std::string>().empty())
+        return "instructions are not supported by this model build";
+    if (j.contains("task_type") && j["task_type"].is_string() && j["task_type"] != "CustomVoice")
+        return "only task_type CustomVoice is supported";
+    return eng.check_voice(rq.voice, rq.language);
+}
+
+}  // namespace
+
+std::string tts_model_dir(model_list& models, const std::string& tag, std::string* error) {
+    if (!models.is_model_supported(tag)) {
+        if (error) *error = "unknown model " + tag;
+        return "";
+    }
+    auto [resolved, info] = models.get_model_info(tag);
+    if (!Qwen3Tts::is_tts_model(info)) {
+        if (error) *error = tag + " is not a text-to-speech model";
+        return "";
+    }
+    const std::string dir = models.get_model_path(resolved);
+    for (const auto& f : info["files"]) {
+        if (!std::filesystem::exists(std::filesystem::path(dir) / f.get<std::string>())) {
+            if (error)
+                *error = "model package " + dir + " is missing " + f.get<std::string>() +
+                         "; build it with src/tools/qwen3_tts/build_package.sh (see src/tools/qwen3_tts/README.md)";
+            return "";
+        }
+    }
+    return dir;
+}
+
+TtsService::TtsService(model_list& models, const std::string& tag, flm_rt::device* device, WebServer* server)
+    : tag_(tag), server_(server) {
+    std::string err;
+    const std::string dir = tts_model_dir(models, tag, &err);
+    if (dir.empty()) throw std::runtime_error(err);
+    header_print("FLM", "Loading text-to-speech model " << tag << " ...");
+    engine_ = std::make_unique<Qwen3Tts>(device, dir);
+    const char* w = std::getenv("FLM_TTS_KEEPWARM_S");
+    const double window = w && *w ? std::atof(w) : 600.0;
+    if (window > 0) warm_ = std::thread([this, window] { keep_warm_loop(window); });
+}
+
+TtsService::~TtsService() {
+    stop_ = true;
+    if (warm_.joinable()) warm_.join();
+}
+
+void TtsService::keep_warm_loop(double window_s) {
+    // the amdxdna driver suspends the NPU after ~5 s without work; resuming costs ~135 ms
+    // of time to first audio. Dispatch every 4 s while the last utterance is recent.
+    while (!stop_) {
+        for (int i = 0; i < 40 && !stop_; i++) std::this_thread::sleep_for(std::chrono::milliseconds(100));
+        if (stop_ || engine_->faulted() || busy()) continue;
+        const double idle = engine_->idle_s();
+        if (idle < 3.0 || idle > window_s) continue;
+        // skipped while another request uses the NPU (which keeps it awake anyway); the
+        // dispatch is ~1 ms and on the TTS engine's own context, so it does not take the lock
+        if (!NPUAccessManager::is_npu_available()) continue;
+        engine_->keep_warm();
+    }
+}
+
+// Cancel callbacks run under mu_: end_utterance() takes mu_ too, so a callback never runs
+// after its utterance has ended (and its state is gone). They only set flags.
+bool TtsService::begin_utterance(bool replace, std::function<void()> cancel, uint64_t* id) {
+    std::lock_guard<std::mutex> l(mu_);
+    if (active_id_ != 0) {
+        if (!replace) return false;
+        if (active_cancel_) active_cancel_();
+    }
+    *id = next_id_++;
+    active_id_ = *id;
+    active_cancel_ = std::move(cancel);
+    return true;
+}
+
+void TtsService::end_utterance(uint64_t id) {
+    std::lock_guard<std::mutex> l(mu_);
+    if (active_id_ == id) {
+        active_id_ = 0;
+        active_cancel_ = nullptr;
+    }
+}
+
+bool TtsService::busy() const {
+    std::lock_guard<std::mutex> l(mu_);
+    return active_id_ != 0;
+}
+
+void TtsService::cancel_active() {
+    std::lock_guard<std::mutex> l(mu_);
+    if (active_cancel_) active_cancel_();
+}
+
+// ------------------------------------------------------------------ WebSocket session
+
+namespace {
+
+/// \brief one WebSocket client: text messages in, PCM16 binary frames and JSON events out.
+///
+/// client -> server (JSON text frames):
+///   {"type":"session.config", "voice", "language", "seed", "temperature", "replace", "events"}
+///   {"type":"input.text", "text": "..."}       text of the current utterance (starts one if none)
+///   {"type":"input.done"}                      no more text for this utterance
+///   {"type":"input.cancel"}                    stop the current utterance now
+///   {"type":"session.close"}
+/// server -> client:
+///   {"type":"audio.start", "utterance_index", "format":"pcm", "sample_rate":24000, "channels":1}
+///   binary frames: 16-bit little-endian mono PCM
+///   {"type":"lead", "lead": n, ...}            text tokens received but not yet spoken; keep it >= 8
+///   {"type":"segment", ...}                    per segment: text, frames, retry / check result
+///   {"type":"audio.done", "utterance_index", "total_bytes", "error", "status", "metrics"}
+///   {"type":"session.done", "utterance_index"}
+///   {"type":"error", "message"}
+class WsSession : public std::enable_shared_from_this<WsSession> {
+public:
+    WsSession(TtsService* svc, tcp::socket socket, std::function<void()> on_close)
+        : svc_(svc), ws_(on_strand(std::move(socket))), on_close_(std::move(on_close)) {}
+    ~WsSession() {
+        if (on_close_) on_close_();
+    }
+
+    void start(http::request<http::string_body> req) {
+        auto self = shared_from_this();
+        net::dispatch(ws_.get_executor(), [self, req = std::move(req)]() mutable {
+            self->ws_.set_option(websocket::stream_base::timeout::suggested(beast::role_type::server));
+            self->ws_.async_accept(req, [self](beast::error_code ec) {
+                if (ec) return;
+                self->read();
+            });
+        });
+    }
+
+private:
+    /// \brief the accepted socket re-homed on a strand of its io_context
+    static beast::tcp_stream on_strand(tcp::socket socket) {
+        tcp::socket s(net::make_strand(socket.get_executor()));
+        const auto proto = socket.local_endpoint().protocol();
+        s.assign(proto, socket.release());
+        return beast::tcp_stream(std::move(s));
+    }
+
+    struct Utterance {
+        // the thread may drop the last reference itself (session gone): never destroy it joinable
+        ~Utterance() { if (th.joinable()) th.detach(); }
+        uint64_t index = 0, activity = 0;
+        std::unique_ptr<qwen3_tts::TextInput> input;
+        std::atomic<bool> cancel{false};
+        std::atomic<bool> done{false};
+        std::thread th;
+    };
+
+    void read() {
+        auto self = shared_from_this();
+        ws_.async_read(buf_, [self](beast::error_code ec, std::size_t) {
+            if (ec) { self->closed(); return; }
+            if (self->ws_.got_text()) self->on_message(beast::buffers_to_string(self->buf_.data()));
+            self->buf_.consume(self->buf_.size());
+            if (!self->closing_) self->read();
+        });
+    }
+
+    void on_message(const std::string& text) {
+        json m = json::parse(text, nullptr, false);
+        if (!m.is_object() || !m.contains("type")) { send_json({{"type", "error"}, {"message", "expected a JSON object with a type"}}); return; }
+        const std::string type = m["type"].get<std::string>();
+        if (type == "session.config") {
+            if (cur_ && !cur_->done) { send_json({{"type", "error"}, {"message", "session.config while an utterance is active"}}); return; }
+            TtsRequest rq;
+            const std::string err = parse_tts_fields(m, svc_->engine(), rq);
+            if (!err.empty()) { send_json({{"type", "error"}, {"message", err}}); return; }
+            cfg_ = rq;
+            replace_ = m.value("replace", false);
+            events_ = m.value("events", true);
+        } else if (type == "input.text") {
+            if (!cur_ || cur_->done.load() || input_done_) {
+                if (!start_utterance(m.value("replace", replace_))) return;
+            }
+            cur_->input->push(m.value("text", ""));
+        } else if (type == "input.done") {
+            if (cur_ && !input_done_) cur_->input->finish();
+            input_done_ = true;
+        } else if (type == "input.cancel") {
+            if (cur_) { cur_->cancel = true; cur_->input->cancel(); }
+        } else if (type == "session.close") {
+            closing_ = true;
+            if (cur_) { cur_->cancel = true; cur_->input->cancel(); }
+            auto self = shared_from_this();
+            ws_.async_close(websocket::close_code::normal, [self](beast::error_code) {});
+        } else {
+            send_json({{"type", "error"}, {"message", "unknown message type " + type}});
+        }
+    }
+
+    bool start_utterance(bool replace) {
+        if (cur_ && cur_->th.joinable() && cur_->done) cur_->th.join();
+        if (cur_ && !cur_->done) {
+            // the previous utterance is still being spoken (its input was finished)
+            if (!replace) { send_json({{"type", "error"}, {"message", "an utterance is still being spoken; send input.cancel or set replace"}}); return false; }
+            cur_->cancel = true;
+            cur_->input->cancel();
+            cur_->th.join();
+        }
+        auto u = std::make_shared<Utterance>();
+        u->index = next_index_++;
+        u->input = svc_->engine().make_input();
+        Utterance* up = u.get();
+        if (!svc_->begin_utterance(replace, [up] { up->cancel = true; up->input->cancel(); }, &u->activity)) {
+            send_json({{"type", "error"}, {"message", "another utterance is being spoken; set replace to cancel it"}});
+            return false;
+        }
+        input_done_ = false;
+        cur_ = u;
+        auto self = shared_from_this();
+        TtsRequest rq = cfg_;
+        rq.events = events_;
+        u->th = std::thread([self, u, rq] { self->run(u, rq); });
+        return true;
+    }
+
+    void run(std::shared_ptr<Utterance> u, TtsRequest rq) {
+        // wait for the NPU like any other NPU request
+        while (!NPUAccessManager::try_acquire_npu_access()) {
+            if (u->cancel) break;
+            std::this_thread::sleep_for(std::chrono::milliseconds(10));
+        }
+        const bool have_npu = !u->cancel;
+        uint64_t bytes = 0;
+        bool started = false;
+        TtsResult r;
+        if (have_npu) {
+            TtsSink sink;
+            sink.audio = [&](const int16_t* pcm, size_t n) {
+                if (!started) {
+                    started = true;
+                    send_json({{"type", "audio.start"}, {"utterance_index", u->index}, {"format", "pcm"},
+                               {"sample_rate", kRate}, {"channels", 1}});
+                }
+                bytes += n * 2;
+                send_binary(std::string(reinterpret_cast<const char*>(pcm), n * 2));
+                return !closing_;
+            };
+            sink.event = [&](const json& e) { send_json(e); };
+            r = svc_->engine().speak(rq, *u->input, sink, [&] { return u->cancel.load() || closing_.load(); });
+            svc_->server()->process_next_npu_request();
+        } else {
+            r.status = TtsResult::cancelled;
+        }
+        svc_->end_utterance(u->activity);
+        const char* st = r.status == TtsResult::ok ? "ok" : r.status == TtsResult::cancelled ? "cancelled"
+                       : r.status == TtsResult::fault ? "npu_fault" : "error";
+        if (r.status == TtsResult::error || r.status == TtsResult::fault) send_json({{"type", "error"}, {"message", r.message}});
+        send_json({{"type", "audio.done"}, {"utterance_index", u->index}, {"total_bytes", bytes},
+                   {"error", r.status == TtsResult::error || r.status == TtsResult::fault}, {"status", st},
+                   {"metrics", r.metrics}});
+        send_json({{"type", "session.done"}, {"utterance_index", u->index}});
+        log_metrics("ws", r);
+        u->done = true;
+    }
+
+    void send_json(const json& j) { enqueue(false, j.dump()); }
+    void send_binary(std::string b) { enqueue(true, std::move(b)); }
+    void enqueue(bool binary, std::string data) {
+        auto self = shared_from_this();
+        net::post(ws_.get_executor(), [self, binary, d = std::make_shared<std::string>(std::move(data))] {
+            self->outq_.push_back({binary, d});
+            if (self->outq_.size() == 1) self->write_next();
+        });
+    }
+    void write_next() {
+        if (outq_.empty() || dead_) { outq_.clear(); return; }
+        auto self = shared_from_this();
+        ws_.binary(outq_.front().first);
+        ws_.async_write(net::buffer(*outq_.front().second), [self](beast::error_code ec, std::size_t) {
+            if (ec) { self->dead_ = true; self->outq_.clear(); return; }
+            self->outq_.pop_front();
+            self->write_next();
+        });
+    }
+    void closed() {
+        closing_ = true;
+        dead_ = true;
+        if (cur_) {
+            cur_->cancel = true;
+            cur_->input->cancel();
+            // the utterance thread holds a reference; let it finish on its own
+            if (cur_->th.joinable()) cur_->th.detach();
+        }
+    }
+
+public:
+    static void log_metrics(const char* via, const TtsResult& r) {
+        const auto& m = r.metrics;
+        if (!m.is_object()) return;
+        header_print("TTS", via << ": " << m.value("audio_s", 0.0) << " s audio, " << m.value("segments", 0)
+                     << " segments, retries " << m.value("retries", 0) << ", TTFA " << (int)m.value("ttfa_ms", -1.0)
+                     << " ms, status " << (int)r.status);
+    }
+
+private:
+    TtsService* svc_;
+    websocket::stream<beast::tcp_stream> ws_;   // on a strand: all handlers are serialized
+    std::function<void()> on_close_;
+    beast::flat_buffer buf_;
+    std::deque<std::pair<bool, std::shared_ptr<std::string>>> outq_;
+    TtsRequest cfg_;
+    bool replace_ = false, events_ = true, input_done_ = false;
+    std::atomic<bool> closing_{false};
+    bool dead_ = false;
+    std::shared_ptr<Utterance> cur_;
+    uint64_t next_index_ = 0;
+};
+
+}  // namespace
+
+// ------------------------------------------------------------------ routes
+
+void TtsService::register_routes(WebServer& server) {
+    TtsService* self = this;
+
+    server.register_admission_handler("POST", "/v1/audio/speech", [self](const http::request<http::string_body>& req) -> std::optional<json> {
+        if (self->engine().faulted())
+            return json{{"code", 503}, {"message", "text-to-speech stopped after an NPU fault: " + self->engine().fault_message()}};
+        json j = json::parse(req.body(), nullptr, false);
+        const bool replace = j.is_object() && j.value("replace", false);
+        if (self->busy()) {
+            if (!replace) return json{{"code", 409}, {"message", "another utterance is being spoken; set \"replace\": true to cancel it"}};
+            self->cancel_active();
+        }
+        return std::nullopt;
+    });
+
+    server.register_handler("POST", "/v1/audio/speech",
+        [self](const http::request<http::string_body>& req, std::function<void(const json&)> send_response,
+               std::function<void(const json&, bool)> send_streaming_response, std::shared_ptr<HttpSession> session,
+               std::shared_ptr<CancellationToken> token) {
+            Qwen3Tts& eng = self->engine();
+            json j = json::parse(req.body(), nullptr, false);
+            if (!j.is_object()) { send_response(error_json(400, "invalid JSON")); return; }
+            if (eng.faulted()) { send_response(error_json(503, "text-to-speech stopped after an NPU fault: " + eng.fault_message())); return; }
+            const std::string text = j.value("input", "");
+            if (text.empty()) { send_response(error_json(400, "input is required")); return; }
+            if (j.contains("model") && j["model"].is_string() && !j["model"].get<std::string>().empty() &&
+                j["model"] != self->tag() && j["model"] != "tts-1" && j["model"] != "tts-1-hd")
+                { send_response(error_json(400, "model " + j["model"].get<std::string>() + " is not loaded; this server speaks with " + self->tag())); return; }
+            const std::string fmt = j.value("response_format", "wav");
+            if (fmt != "wav" && fmt != "pcm") { send_response(error_json(400, "response_format must be wav or pcm")); return; }
+            if (j.contains("speed") && j["speed"].is_number() && std::abs(j["speed"].get<double>() - 1.0) > 1e-6)
+                { send_response(error_json(400, "only speed 1.0 is supported")); return; }
+            if (j.contains("sample_rate") && j["sample_rate"].is_number_integer() && j["sample_rate"].get<int>() != kRate)
+                { send_response(error_json(400, "only sample_rate 24000 is supported")); return; }
+            const bool stream = j.value("stream", false);
+            std::string sfmt = j.contains("stream_format") && j["stream_format"].is_string() ? j["stream_format"].get<std::string>() : "";
+            if (stream && sfmt.empty()) sfmt = "sse";
+            if (!stream && !sfmt.empty()) { send_response(error_json(400, "stream_format needs stream: true")); return; }
+            if (!sfmt.empty() && sfmt != "audio" && sfmt != "sse") { send_response(error_json(400, "stream_format must be audio or sse")); return; }
+            TtsRequest rq;
+            const std::string err = parse_tts_fields(j, eng, rq);
+            if (!err.empty()) { send_response(error_json(400, err)); return; }
+
+            std::atomic<bool> cancel{false};
+            uint64_t act = 0;
+            self->begin_utterance(true, [&cancel] { cancel = true; }, &act);
+            auto in = eng.make_input();
+            in->push(text);
+            in->finish();
+
+            const std::vector<std::pair<std::string, std::string>> hdr = {
+                {"x-audio-sample-rate", std::to_string(kRate)}, {"x-audio-channels", "1"}};
+            const std::string ctype = fmt == "wav" ? "audio/wav" : "audio/pcm";
+            std::vector<int16_t> all;
+            bool started = false;
+            TtsSink sink;
+            if (sfmt == "audio") {
+                sink.audio = [&](const int16_t* pcm, size_t n) {
+                    if (!started) {
+                        started = true;
+                        if (!session->write_raw_head(200, ctype, hdr, true)) return false;
+                        if (fmt == "wav") { auto h = wav_header(0xFFFFFFFFu); if (!session->write_raw_chunk(h.data(), h.size())) return false; }
+                    }
+                    return session->write_raw_chunk(pcm, n * 2);
+                };
+            } else if (sfmt == "sse") {
+                sink.audio = [&](const int16_t* pcm, size_t n) {
+                    started = true;
+                    json ev = {{"type", "speech.audio.delta"},
+                               {"audio", base64::to_base64(std::string_view(reinterpret_cast<const char*>(pcm), n * 2))},
+                               {"response_format", "pcm"}, {"sample_rate", kRate}, {"channels", 1}};
+                    send_streaming_response("event: speech.audio.delta\ndata: " + ev.dump() + "\n\n", false);
+                    return !token->cancelled();
+                };
+            } else {
+                sink.audio = [&](const int16_t* pcm, size_t n) { all.insert(all.end(), pcm, pcm + n); return true; };
+            }
+            auto r = eng.speak(rq, *in, sink, [&] { return cancel.load() || token->cancelled(); });
+            self->end_utterance(act);
+            WsSession::log_metrics("http", r);
+            const bool failed = r.status == TtsResult::error || r.status == TtsResult::fault;
+            if (sfmt == "audio") {
+                if (started) { session->write_raw_end(); return; }
+                if (failed) { send_response(error_json(r.status == TtsResult::fault ? 503 : 500, r.message)); return; }
+                session->write_raw_head(200, ctype, hdr, false, fmt == "wav" ? 44 : 0);
+                if (fmt == "wav") { auto h = wav_header(0); session->write_raw_chunk(h.data(), h.size()); }
+                session->write_raw_end();
+                return;
+            }
+            if (sfmt == "sse") {
+                if (failed) {
+                    json ev = {{"type", "speech.audio.error"}, {"error", {{"message", r.message}, {"type", "server_error"}, {"code", r.status == TtsResult::fault ? 503 : 500}}}};
+                    send_streaming_response("event: speech.audio.error\ndata: " + ev.dump() + "\n\n", true);
+                } else {
+                    json ev = {{"type", "speech.audio.done"}, {"usage", {{"output_audio_seconds", r.metrics.value("audio_s", 0.0)}}}, {"metrics", r.metrics}};
+                    send_streaming_response("event: speech.audio.done\ndata: " + ev.dump() + "\n\n", true);
+                }
+                return;
+            }
+            if (failed) { send_response(error_json(r.status == TtsResult::fault ? 503 : 500, r.message)); return; }
+            if (r.status == TtsResult::cancelled && token->cancelled()) return;   // client is gone
+            std::string body = fmt == "wav" ? wav_header((uint32_t)(all.size() * 2)) : std::string();
+            body.append(reinterpret_cast<const char*>(all.data()), all.size() * 2);
+            auto h2 = hdr;
+            json m = r.metrics;
+            m.erase("segment_log");
+            h2.push_back({"x-flm-tts-metrics", m.dump()});
+            if (session->write_raw_head(200, ctype, h2, false, body.size())) session->write_raw_chunk(body.data(), body.size());
+            session->write_raw_end();
+        });
+
+    server.register_handler("GET", "/v1/audio/voices",
+        [self](const http::request<http::string_body>&, std::function<void(const json&)> send_response,
+               std::function<void(const json&, bool)>, std::shared_ptr<HttpSession>, std::shared_ptr<CancellationToken>) {
+            send_response(json{{"model", self->tag()}, {"voices", self->engine().voices()},
+                               {"languages", self->engine().languages()}, {"default_voice", self->engine().default_voice()},
+                               {"sample_rate", kRate}});
+        });
+
+    server.register_handler("POST", "/v1/audio/speech/cancel",
+        [self](const http::request<http::string_body>&, std::function<void(const json&)> send_response,
+               std::function<void(const json&, bool)>, std::shared_ptr<HttpSession>, std::shared_ptr<CancellationToken>) {
+            const bool was = self->busy();
+            self->cancel_active();
+            send_response(json{{"cancelled", was}});
+        });
+
+    server.register_upgrade_handler("/v1/audio/speech/stream",
+        [self](tcp::socket socket, http::request<http::string_body> req, std::function<void()> on_close) {
+            std::make_shared<WsSession>(self, std::move(socket), std::move(on_close))->start(std::move(req));
+        });
+}
+
+#endif  // FLM_QWEN3_TTS
