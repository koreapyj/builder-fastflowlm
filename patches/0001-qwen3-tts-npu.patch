+/* Symbols flm exports so the prebuilt qwen3_npu engine's PLT calls reach the Qwen3-TTS
+   load-time capture (common/qwen3_tts/xrt_interpose.cpp, xrt_capture.cpp). Linker
+   --dynamic-list: only these, not -rdynamic, so no other flm symbol can preempt an
+   engine library's own. */
+{
+  _ZN11SafeTensors12load_weightsER5bytesNSt7__cxx1112basic_stringIcSt11char_traitsIcESaIcEEE;
+  _ZN3xrt3elfC1EPKvm;
+  _ZN3xrt6moduleC1ERKNS_3elfE;
+  _ZN3xrt3ext6kernelC1ERKNS_10hw_contextERKNS_6moduleERKNSt7__cxx1112basic_stringIcSt11char_traitsIcESaIcEEE;
+  _ZN3xrt3runC1ERKNS_6kernelE;
+  _ZN3xrt3run16set_arg_at_indexEiRKNS_2boE;
+  _ZN3xrt3run16set_arg_at_indexEiPKvm;
+  _ZN3xrt7runlist3addEONS_3runE;
+  _ZN3xrt2bo4syncE18xclBOSyncDirectionmm;
+};
