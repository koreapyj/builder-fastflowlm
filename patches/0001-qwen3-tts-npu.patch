+uint64_t mix(uint64_t x) {
+    x += 0x9E3779B97F4A7C15ull;
+    x = (x ^ (x >> 30)) * 0xBF58476D1CE4E5B9ull;
+    x = (x ^ (x >> 27)) * 0x94D049BB133111EBull;
+    return x ^ (x >> 31);
+}
+
+double unix_now() {
+    return std::chrono::duration<double>(std::chrono::system_clock::now().time_since_epoch()).count();
+}
+
+/// \brief level of the voiced part of a signal: RMS over 20 ms blocks above -50 dBFS
+double active_rms(const float* x, size_t n) {
+    constexpr size_t B = 480;
+    double acc = 0;
+    size_t blocks = 0;
+    for (size_t i = 0; i + B <= n; i += B) {
+        double s = 0;
+        for (size_t j = 0; j < B; j++) s += (double)x[i + j] * x[i + j];
+        s /= B;
+        if (s > 1e-5) { acc += s; blocks++; }
+    }
+    return blocks < 25 ? 0.0 : std::sqrt(acc / blocks);   // needs >= 0.5 s of voice
+}
+
+// ------------------------------------------------------------------ watchdog
+
+/// \brief follows the kernel log (journalctl -k -f) and reports amdxdna errors
+class KernelLogWatch {
+public:
+    explicit KernelLogWatch(std::function<void(const std::string&)> on_error) : on_error_(std::move(on_error)) {
+        int fd[2];
+        if (pipe(fd) != 0) return;
+        posix_spawn_file_actions_t fa;
+        posix_spawn_file_actions_init(&fa);
+        posix_spawn_file_actions_adddup2(&fa, fd[1], 1);
+        posix_spawn_file_actions_addclose(&fa, fd[0]);
+        posix_spawn_file_actions_addopen(&fa, 2, "/dev/null", O_WRONLY, 0);
+        const char* argv[] = {"journalctl", "-k", "-f", "-n", "0", "-o", "short-iso", nullptr};
+        if (posix_spawnp(&pid_, "journalctl", &fa, nullptr, const_cast<char**>(argv), environ) != 0) pid_ = -1;
+        posix_spawn_file_actions_destroy(&fa);
+        close(fd[1]);
+        if (pid_ <= 0) {
+            close(fd[0]);
+            std::cerr << "[qwen3-tts] warning: journalctl not available; NPU faults are detected from XRT errors only\n";
+            return;
+        }
+        fd_ = fd[0];
+        th_ = std::thread([this] { loop(); });
+    }
+    ~KernelLogWatch() {
+        stopping_ = true;
+        if (pid_ > 0) { kill(pid_, SIGTERM); waitpid(pid_, nullptr, 0); }
+        if (th_.joinable()) th_.join();
+        if (fd_ >= 0) close(fd_);
+    }
+    bool active() const { return pid_ > 0; }
+
+private:
+    void loop() {
+        std::string line;
+        char buf[4096];
+        for (;;) {
+            const ssize_t n = read(fd_, buf, sizeof buf);
+            if (n <= 0) {
+                if (!stopping_)
+                    std::cerr << "[qwen3-tts] warning: the kernel-log watch (journalctl -k -f) ended; amdxdna errors "
+                                 "are no longer detected from the kernel log (is the journal readable by this user?)"
+                              << std::endl;
+                return;
+            }
+            for (ssize_t i = 0; i < n; i++) {
+                if (buf[i] != '\n') { line += buf[i]; continue; }
+                std::string low = line;
+                std::transform(low.begin(), low.end(), low.begin(), ::tolower);
+                if (low.find("amdxdna") != std::string::npos &&
+                    (low.find("error") != std::string::npos || low.find("fail") != std::string::npos ||
+                     low.find("timeout") != std::string::npos))
+                    on_error_(line);
+                line.clear();
+            }
+        }
+    }
+    std::function<void(const std::string&)> on_error_;
+    std::atomic<bool> stopping_{false};
+    pid_t pid_ = -1;
+    int fd_ = -1;
+    std::thread th_;
+};
+
+// ------------------------------------------------------------------ speech decoder thread
+
+/// \brief decodes one attempt's frames on a persistent thread as they arrive: the first
+///        chunk is one frame, later chunks are whatever has accumulated (1..4 frames), so
+///        chunks only grow when decoding falls behind
+class DecodeWorker {
+public:
+    explicit DecodeWorker(AudioDecoder* dec) : dec_(dec), th_([this] { loop(); }) {}
+    ~DecodeWorker() {
+        { std::lock_guard<std::mutex> l(mu_); quit_ = true; }
+        cv_.notify_all();
+        th_.join();
+    }
+    double first_decode_ms = -1;   // decode time of the first chunk of the current attempt
+    void start(std::function<void(const float*, size_t)> out) {
+        std::lock_guard<std::mutex> l(mu_);
+        out_ = std::move(out);
+        first_decode_ms = -1;
+        first_done_ = false;
+        frames_.clear();
+        taken_ = 0;
+        done_ = abort_ = false;
+        reset_ = true;
+        active_ = true;
+        cv_.notify_all();
+    }
+    void push(const int32_t* c) {
+        { std::lock_guard<std::mutex> l(mu_); frames_.insert(frames_.end(), c, c + 16); }
+        cv_.notify_all();
+    }
+    /// \brief wait until the first chunk of the current attempt is decoded (or the attempt ends)
+    void wait_first_chunk() {
+        std::unique_lock<std::mutex> l(mu_);
+        cv_.wait(l, [&] { return !active_ || first_done_; });
+    }
+    /// \brief decode what is queued, then stop (abort: drop what is queued); waits until idle
+    void finish(bool abort = false) {
+        std::unique_lock<std::mutex> l(mu_);
+        if (!active_) return;
+        done_ = true;
+        abort_ = abort;
+        cv_.notify_all();
+        cv_.wait(l, [&] { return !active_; });
+    }
+
+private:
+    void loop() {
+        std::vector<int32_t> buf;
+        std::vector<float> pcm;
+        std::unique_lock<std::mutex> l(mu_);
+        for (;;) {
+            cv_.wait(l, [&] { return quit_ || (active_ && (done_ || (int)(frames_.size() / 16) > taken_)); });
+            if (quit_) return;
+            if (reset_) { reset_ = false; l.unlock(); dec_->reset(); l.lock(); }
+            const int avail = (int)(frames_.size() / 16) - taken_;
+            if (abort_ || (avail == 0 && done_)) {
+                active_ = false;
+                cv_.notify_all();
+                continue;
+            }
+            if (avail == 0) continue;
+            const int n = std::min(avail, taken_ == 0 ? 1 : 4);
+            buf.assign(frames_.begin() + (size_t)taken_ * 16, frames_.begin() + (size_t)(taken_ + n) * 16);
+            taken_ += n;
+            const bool first = first_decode_ms < 0;
+            auto out = out_;
+            l.unlock();
+            pcm.clear();
+            const auto t0 = clk::now();
+            dec_->decode(buf.data(), n, pcm);
+            if (first) first_decode_ms = ms_since(t0);
+            out(pcm.data(), pcm.size());
+            l.lock();
+            if (first) { first_done_ = true; cv_.notify_all(); }
+        }
+    }
+    AudioDecoder* dec_;
+    std::function<void(const float*, size_t)> out_;
+    std::mutex mu_;
+    std::condition_variable cv_;
+    std::vector<int32_t> frames_;
+    int taken_ = 0;
+    bool done_ = false, abort_ = false, active_ = false, reset_ = false, quit_ = false, first_done_ = false;
+    std::thread th_;
+};
+
+// ------------------------------------------------------------------ output / playback clock
+
+/// \brief audio going to the client, with a virtual playback clock: playback starts when
+///        the first sample is sent and runs continuously, so the client has
+///        (t0 + sent / rate) - now seconds of audio left
+class Output {
+public:
+    explicit Output(TtsSink& sink) : sink_(sink) {}
+
+    /// \brief start an attempt; streaming attempts send as they decode
+    void begin(bool streaming, float gain) {
+        std::lock_guard<std::mutex> l(mu_);
+        pcm_.clear();
+        released_ = 0;
+        streaming_ = streaming;
+        stopped_ = false;
+        gain_ = gain;
+    }
+    /// \brief decoded audio of the current attempt (decoder thread)
+    void on_pcm(const float* x, size_t n) {
+        std::lock_guard<std::mutex> l(mu_);
+        if (stopped_) return;
+        pcm_.insert(pcm_.end(), x, x + n);
+        if (streaming_) release_locked();
+    }
+    bool streaming() const { std::lock_guard<std::mutex> l(mu_); return streaming_; }
+    /// \brief switch a checked attempt to streaming (sends what has been decoded so far)
+    void stream_now(float gain) {
+        std::lock_guard<std::mutex> l(mu_);
+        if (streaming_) return;
+        streaming_ = true;
+        gain_ = gain;
+        release_locked();
+    }
+    /// \brief the current attempt passed its check: send the rest
+    void commit(float gain) {
+        std::lock_guard<std::mutex> l(mu_);
+        if (!streaming_) gain_ = gain;
+        streaming_ = true;
+        release_locked();
+        stopped_ = true;
+    }
+    /// \brief the current attempt failed: send nothing more of it
+    void drop() { std::lock_guard<std::mutex> l(mu_); stopped_ = true; }
+    /// \brief samples of the current attempt already sent
+    size_t released() const { std::lock_guard<std::mutex> l(mu_); return released_; }
+    /// \brief decoded audio of the current attempt so far (copy)
+    std::vector<float> pcm() const { std::lock_guard<std::mutex> l(mu_); return pcm_; }
+    void silence(int ms) {
+        std::lock_guard<std::mutex> l(mu_);
+        std::vector<int16_t> z((size_t)ms * Qwen3Tts::kSampleRate / 1000, 0);
+        send_locked(z.data(), z.size());
+    }
+    /// \brief seconds of audio the client still has to play (0 before playback starts)
+    double ahead_s() const {
+        std::lock_guard<std::mutex> l(mu_);
+        if (!started_) return 0;
+        return t0_s_ + (double)sent_ / Qwen3Tts::kSampleRate - mono_s();
+    }
+    /// \brief virtual playback time (seconds since t0) at which sample `pos` plays
+    int64_t sent() const { std::lock_guard<std::mutex> l(mu_); return sent_; }
+    double playback_s() const { std::lock_guard<std::mutex> l(mu_); return started_ ? mono_s() - t0_s_ : 0; }
+    bool client_gone() const { return gone_; }
+    double first_audio_unix() const { return first_unix_; }
+
+private:
+    static double mono_s() {
+        return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    }
+    void release_locked() {
+        if (released_ >= pcm_.size()) return;
+        const size_t n = pcm_.size() - released_;
+        std::vector<int16_t> q(n);
+        for (size_t i = 0; i < n; i++)
+            q[i] = (int16_t)std::lrint(std::clamp(pcm_[released_ + i] * gain_, -1.0f, 1.0f) * 32767.0f);
+        released_ = pcm_.size();
+        send_locked(q.data(), n);
+    }
+    void send_locked(const int16_t* q, size_t n) {
+        if (n == 0 || gone_) return;
+        if (!started_) {
+            started_ = true;
+            t0_s_ = mono_s();
+            first_unix_ = unix_now();
+        }
+        sent_ += (int64_t)n;
+        if (!sink_.audio(q, n)) gone_ = true;
+    }
+    TtsSink& sink_;
+    mutable std::mutex mu_;
+    std::vector<float> pcm_;
+    size_t released_ = 0;
+    bool streaming_ = false, stopped_ = false, started_ = false;
+    std::atomic<bool> gone_{false};
+    float gain_ = 1.0f;
+    double t0_s_ = 0, first_unix_ = 0;
+    int64_t sent_ = 0;
+};
+
+}  // namespace
+
+// ------------------------------------------------------------------ engine
+
+struct Voice {
+    std::vector<uint8_t> kv;   // KV cache of the prefix positions
+    int len = 0;               // prefix positions (9 with a language tag, 8 without)
+};
+
+struct Qwen3Tts::Impl {
+    TtsOptions opt;
+    std::string dir;
+    std::unique_ptr<ThreadPool> pool;
+    std::unique_ptr<TtsHost> host;
+    std::unique_ptr<AudioDecoder> dec;
+    std::unique_ptr<npu_xclbin_manager> npu;
+    std::unique_ptr<NpuQwen3> talker, cp;
+    std::shared_ptr<Tokenizer> tok;
+    std::unique_ptr<DecodeWorker> dw;
+    std::map<std::string, int> spk_id, lang_id;
+    std::map<std::string, std::string> spk_dialect, spk_native;
+    std::vector<std::string> spk_order;
+    std::map<std::string, Voice> voices;   // "speaker|language"
+    std::vector<float> pad_e, eos_e, bos_codec;
+    std::atomic<double> last_active_s{0};
+    /// \brief a predictor step on zeros: wakes the NPU (every frame clears the predictor first)
+    void wake() {
+        std::vector<float> z(TtsHost::kCpD, 0.0f);
+        cp->clear();
+        cp->step(z.data());
+    }
+    /// \brief garble detector settings: package.json "detector" (written from
+    ///        src/tools/qwen3_tts/detector.json, which records why these values; recalibrate
+    ///        with calibrate_entropy.py). The defaults equal that file.
+    struct Detector {
+        float entropy_threshold = 1.7f;   // nats, mean code0 entropy over the window
+        int entropy_window = 25;          // frames
+        float length_factor = 1.8f, frames_per_token = 3.34f, length_slack = 10.0f;
+        float cap_per_token = 7.5f, cap_const = 15.0f;
+    } det;
+    /// \brief FLM_TTS_CALIBRATION_DIR: record every segment (audio, per-frame entropy) with
+    ///        the checks and retries off, for calibrate_entropy.py
+    std::string calib_dir;
+    std::mutex calib_mu;
+    uint64_t calib_utt = 0;
+    // NPU fault state
+    mutable std::mutex fault_mu;
+    std::atomic<bool> fault{false};
+    std::string fault_msg;
+    std::unique_ptr<KernelLogWatch> klog;
+    // generator thread: owns the pinned host pool and runs every NPU call
+    std::thread worker;
+    std::mutex job_mu;
+    std::condition_variable job_cv;
+    std::deque<std::function<void()>> jobs;
+    bool stop = false;
+
+    ~Impl() { stop_worker(); }
+    void stop_worker() {
+        {
+            std::lock_guard<std::mutex> l(job_mu);
+            stop = true;
+        }
+        job_cv.notify_all();
+        if (worker.joinable()) worker.join();
+    }
+
+    void run_on_worker(std::function<void()> fn) {
+        std::packaged_task<void()> task(std::move(fn));
+        auto f = task.get_future();
+        {
+            std::lock_guard<std::mutex> l(job_mu);
+            jobs.emplace_back([&task] { task(); });
+        }
+        job_cv.notify_one();
+        f.get();   // rethrows
+    }
+    void worker_loop(std::vector<int> cpus) {
+        pin_this_thread(cpus[0]);
+        for (;;) {
+            std::function<void()> job;
+            {
+                std::unique_lock<std::mutex> l(job_mu);
+                job_cv.wait(l, [&] { return stop || !jobs.empty(); });
+                if (stop && jobs.empty()) return;
+                job = std::move(jobs.front());
+                jobs.pop_front();
+            }
+            job();
+        }
+    }
+
+    void set_fault(const std::string& why) {
+        {
+            std::lock_guard<std::mutex> l(fault_mu);
+            if (fault) return;
+            fault_msg = why;
+            fault = true;
+        }
+        std::cerr << "[qwen3-tts] NPU FAULT: " << why << "\n"
+                  << "[qwen3-tts] text-to-speech is stopped. Check `journalctl -k | grep amdxdna`, reload the driver "
+                     "(sudo modprobe -r amdxdna && sudo modprobe amdxdna) if the NPU does not recover, then restart flm."
+                  << std::endl;
+    }
+
+    std::string resolve_language(const std::string& voice, const std::string& language) const {
+        std::string lang = language;
+        std::transform(lang.begin(), lang.end(), lang.begin(), ::tolower);
+        if (lang.empty()) {
+            auto it = spk_native.find(voice);
+            lang = it != spk_native.end() ? it->second : "auto";
+        }
+        // dialect speakers use their dialect tag for Chinese / auto (as the official code)
+        auto d = spk_dialect.find(voice);
+        if (d != spk_dialect.end() && !d->second.empty() && (lang == "chinese" || lang == "auto")) lang = d->second;
+        return lang;
+    }
+
+    /// \brief the talker prompt before the first text token (official CustomVoice layout):
+    ///        <|im_start|>assistant\n as text, then codec tags [think, think_bos, language,
+    ///        think_eos, speaker, pad] each added to tts_pad (tts_bos on the last)
+    std::vector<float> prefix_rows(const std::string& voice, const std::string& lang) {
+        const int D = TtsHost::kTalkerD;
+        std::vector<int> codec;
+        if (lang == "auto") codec = {kCodecNoThink, kCodecThinkBos, kCodecThinkEos};
+        else codec = {kCodecThink, kCodecThinkBos, lang_id.at(lang), kCodecThinkEos};
+        codec.push_back(spk_id.at(voice));
+        codec.push_back(kCodecPad);
+        const int n = 3 + (int)codec.size();
+        std::vector<float> rows((size_t)n * D), tmp(D), bos(D);
+        host->text_embed(kImStart, &rows[0]);
+        host->text_embed(kAssistant, &rows[(size_t)D]);
+        host->text_embed(kNewline, &rows[(size_t)2 * D]);
+        host->text_embed(TtsHost::kTtsBos, bos.data());
+        for (size_t i = 0; i < codec.size(); i++) {
+            float* r = &rows[(size_t)(3 + i) * D];
+            host->talker_embed(codec[i], tmp.data());
+            const float* t = i + 1 < codec.size() ? pad_e.data() : bos.data();
+            for (int d = 0; d < D; d++) r[d] = t[d] + tmp[d];
+        }
+        return rows;
+    }
+
+    /// \brief KV snapshot of a voice prefix (built on first use)
+    const Voice& voice_prefix(const std::string& voice, const std::string& lang) {
+        const std::string key = voice + "|" + lang;
+        auto it = voices.find(key);
+        if (it != voices.end()) return it->second;
+        auto rows = prefix_rows(voice, lang);
+        const int n = (int)(rows.size() / TtsHost::kTalkerD);
+        talker->clear();
+        for (int i = 0; i < n; i++) talker->step(&rows[(size_t)i * TtsHost::kTalkerD]);
+        Voice v;
+        v.kv = talker->fast()->snapshot_kv(n);
+        v.len = n;
+        return voices.emplace(key, std::move(v)).first->second;
+    }
+
+    TtsResult speak(const TtsRequest& req, TextInput& in, TtsSink& sink, const std::function<bool()>& cancelled);
+};
+
+TtsOptions TtsOptions::from_env() {
+    TtsOptions o;
+    o.cpus = env_or("FLM_TTS_CPUS", o.cpus.c_str());
+    o.dec_cpus = env_or("FLM_TTS_DEC_CPUS", o.dec_cpus.c_str());
+    o.temperature = std::stof(env_or("FLM_TTS_TEMPERATURE", "0.9"));
+    o.warmup = std::string(env_or("FLM_TTS_WARMUP", "1")) != "0";
+    return o;
+}
+
+bool Qwen3Tts::is_tts_model(const nlohmann::ordered_json& info) {
+    return info.is_object() && info.value("tts", false);
+}
+
+Qwen3Tts::Qwen3Tts(flm_rt::device* device, const std::string& dir, const TtsOptions& opt)
+    : p_(std::make_unique<Impl>()) {
+    Impl& P = *p_;
+    P.opt = opt;
+    P.dir = dir;
+    namespace fs = std::filesystem;
+    for (const char* f : {"config.json", "tokenizer.json", "host.safetensors", "speech_tokenizer.safetensors",
+                          "Qwen3-1.7B-NPU2/model.q4nx", "Qwen3-0.6B-NPU2/model.q4nx"})
+        if (!fs::exists(fs::path(dir) / f))
+            throw std::runtime_error("Qwen3-TTS package incomplete: missing " + (fs::path(dir) / f).string() +
+                                     " (build it with src/tools/qwen3_tts/build_package.sh)");
+    // speakers and languages
+    {
+        std::ifstream f(fs::path(dir) / "config.json");
+        auto cfg = nlohmann::json::parse(f);
+        const auto& t = cfg.at("talker_config");
+        for (auto& [k, v] : t.at("spk_id").items()) { P.spk_id[k] = v.get<int>(); P.spk_order.push_back(k); }
+        for (auto& [k, v] : t.at("codec_language_id").items()) P.lang_id[k] = v.get<int>();
+        if (t.contains("spk_is_dialect"))
+            for (auto& [k, v] : t.at("spk_is_dialect").items()) P.spk_dialect[k] = v.is_string() ? v.get<std::string>() : "";
+    }
+    // each preset speaker's own language (the official model card)
+    const std::map<std::string, std::string> native = {
+        {"vivian", "chinese"}, {"serena", "chinese"}, {"uncle_fu", "chinese"}, {"dylan", "chinese"},
+        {"eric", "chinese"}, {"ryan", "english"}, {"aiden", "english"}, {"ono_anna", "japanese"},
+        {"sohee", "korean"}};
+    for (auto& s : P.spk_order) {
+        auto it = native.find(s);
+        P.spk_native[s] = it != native.end() && P.lang_id.count(it->second) ? it->second : "auto";
+    }
+    {
+        std::ifstream f(fs::path(dir) / "package.json");
+        auto pkg = f ? nlohmann::json::parse(f, nullptr, false) : nlohmann::json();
+        if (pkg.is_object() && pkg.contains("detector") && pkg["detector"].is_object()) {
+            const auto& d = pkg["detector"];
+            auto& D = P.det;
+            D.entropy_threshold = d.value("entropy_threshold", D.entropy_threshold);
+            D.entropy_window = d.value("entropy_window", D.entropy_window);
+            D.length_factor = d.value("length_factor", D.length_factor);
+            D.frames_per_token = d.value("frames_per_token", D.frames_per_token);
+            D.length_slack = d.value("length_slack", D.length_slack);
+            D.cap_per_token = d.value("cap_per_token", D.cap_per_token);
+            D.cap_const = d.value("cap_const", D.cap_const);
+        } else {
+            std::cerr << "[qwen3-tts] warning: package.json has no detector settings; using built-in defaults" << std::endl;
+        }
+    }
+    if (const char* e = std::getenv("FLM_TTS_ENTROPY")) P.det.entropy_threshold = std::stof(e);
+
+    P.tok = std::make_shared<Tokenizer>(dir);
+    P.klog = std::make_unique<KernelLogWatch>([pp = &P](const std::string& line) { pp->set_fault("kernel: " + line); });
+
+    const auto cpus = parse_cpus(opt.cpus);
+    P.worker = std::thread([pp = &P, cpus] { pp->worker_loop(cpus); });
+    P.run_on_worker([&] {
+        auto t0 = clk::now();
+        P.pool = std::make_unique<ThreadPool>(cpus);
+        P.host = std::make_unique<TtsHost>((fs::path(dir) / "host.safetensors").string(), P.pool.get());
+        P.dec = make_cpu_decoder((fs::path(dir) / "speech_tokenizer.safetensors").string(), Prec::f32, parse_cpus(opt.dec_cpus));
+        P.dw = std::make_unique<DecodeWorker>(P.dec.get());
+        P.npu = std::make_unique<npu_xclbin_manager>(npu_device::device_npu2, device, false);
+        P.talker = std::make_unique<NpuQwen3>(P.npu.get(), (fs::path(dir) / "Qwen3-1.7B-NPU2").string(), 4096, 2048, false);
+        P.cp = std::make_unique<NpuQwen3>(P.npu.get(), (fs::path(dir) / "Qwen3-0.6B-NPU2").string(), 64, 17, true);
+        const int D = TtsHost::kTalkerD;
+        P.pad_e.resize(D); P.eos_e.resize(D); P.bos_codec.resize(D);
+        P.host->text_embed(TtsHost::kTtsPad, P.pad_e.data());
+        P.host->text_embed(TtsHost::kTtsEos, P.eos_e.data());
+        P.host->talker_embed(kCodecBos, P.bos_codec.data());
+        for (auto& s : P.spk_order) P.voice_prefix(s, P.resolve_language(s, ""));
+        P.last_active_s = std::chrono::duration<double>(clk::now().time_since_epoch()).count();
+        std::cerr << "[qwen3-tts] loaded " << dir << " in " << (int)ms_since(t0) << " ms ("
+                  << P.voices.size() << " voices, entropy threshold " << P.det.entropy_threshold << ")" << std::endl;
+    });
+    if (opt.warmup) {
+        auto in = make_input();
+        in->push("こんにちは。");
+        in->finish();
+        TtsSink sink{[](const int16_t*, size_t) { return true; }, nullptr};
+        TtsRequest rq;
+        rq.voice = default_voice();
+        rq.seed = 1;
+        auto t0 = clk::now();
+        auto r = speak(rq, *in, sink, [] { return false; });
+        std::cerr << "[qwen3-tts] warm-up " << (r.status == TtsResult::ok ? "ok" : r.message) << " in "
+                  << (int)ms_since(t0) << " ms" << std::endl;
+    }
+    // calibration recording starts after the warm-up utterance
+    if (const char* c = std::getenv("FLM_TTS_CALIBRATION_DIR")) {
+        P.calib_dir = c;
+        fs::create_directories(P.calib_dir);
+        std::cerr << "[qwen3-tts] CALIBRATION MODE: checks and retries are off; recording segments to " << P.calib_dir << std::endl;
+    }
+}
+
+Qwen3Tts::~Qwen3Tts() {
+    p_->stop_worker();
+    // NPU engines before their xclbin manager
+    p_->cp.reset();
+    p_->talker.reset();
+    p_->npu.reset();
+}
+
+std::unique_ptr<TextInput> Qwen3Tts::make_input() const {
+    auto tok = p_->tok;
+    return std::make_unique<TextInput>([tok](const std::string& s) { return tok->encode(s); });
+}
+
+std::vector<std::string> Qwen3Tts::voices() const { return p_->spk_order; }
+
+std::vector<std::string> Qwen3Tts::languages() const {
+    std::vector<std::string> v{"auto"};
+    for (auto& [k, _] : p_->lang_id)
+        if (k.find("dialect") == std::string::npos) v.push_back(k);
+    return v;
+}
+
+std::string Qwen3Tts::default_voice() const {
+    return p_->spk_id.count("ono_anna") ? "ono_anna" : p_->spk_order.front();
+}
+
+std::string Qwen3Tts::check_voice(const std::string& voice_in, const std::string& language) const {
+    std::string voice = voice_in;
+    std::transform(voice.begin(), voice.end(), voice.begin(), ::tolower);
+    if (!voice.empty() && !p_->spk_id.count(voice)) return "unknown voice '" + voice_in + "'";
+    std::string lang = language;
+    std::transform(lang.begin(), lang.end(), lang.begin(), ::tolower);
+    if (!lang.empty() && lang != "auto" && !p_->lang_id.count(lang)) return "unknown language '" + language + "'";
+    return "";
+}
+
+void Qwen3Tts::keep_warm() {
+    if (p_->fault) return;
+    p_->run_on_worker([this] {
+        try {
+            p_->wake();
+        } catch (const NpuFault& f) {
+            p_->set_fault(f.what());
+        }
+    });
+}
+
+double Qwen3Tts::idle_s() const {
+    const double now = std::chrono::duration<double>(clk::now().time_since_epoch()).count();
+    return now - p_->last_active_s.load();
+}
+
+bool Qwen3Tts::faulted() const { return p_->fault.load(); }
+
+std::string Qwen3Tts::fault_message() const {
+    std::lock_guard<std::mutex> l(p_->fault_mu);
+    return p_->fault_msg;
+}
+
+TtsResult Qwen3Tts::speak(const TtsRequest& req, TextInput& text, TtsSink& sink, const std::function<bool()>& cancelled) {
+    if (p_->fault) return {TtsResult::fault, "NPU fault: " + fault_message(), {}};
+    TtsResult r;
+    p_->run_on_worker([&] { r = p_->speak(req, text, sink, cancelled); });
+    p_->last_active_s = std::chrono::duration<double>(clk::now().time_since_epoch()).count();
+    return r;
+}
+
+// ------------------------------------------------------------------ generation
+
+TtsResult Qwen3Tts::Impl::speak(const TtsRequest& req, TextInput& in, TtsSink& sink, const std::function<bool()>& cancelled) {
+    const int D = TtsHost::kTalkerD, CD = TtsHost::kCpD;
+    std::string voice = req.voice.empty() ? (spk_id.count("ono_anna") ? "ono_anna" : spk_order.front()) : req.voice;
+    std::transform(voice.begin(), voice.end(), voice.begin(), ::tolower);
+    const std::string lang = resolve_language(voice, req.language);
+    if (!spk_id.count(voice)) return {TtsResult::error, "unknown voice '" + req.voice + "'", {}};
+    if (lang != "auto" && !lang_id.count(lang)) return {TtsResult::error, "unknown language '" + req.language + "'", {}};
+    const float T = req.temperature > 0 ? req.temperature : opt.temperature;
+    const SamplerCfg scfg{T, opt.top_k};
+    const uint64_t seed = req.seed ? req.seed : std::random_device{}() ^ ((uint64_t)std::random_device{}() << 32);
+    auto event = [&](json e) { if (req.events && sink.event) sink.event(e); };
+    auto stopping = [&] { return cancelled() || in.cancelled() || fault.load(); };
+
+    Output out(sink);
+    const double t_request = unix_now();
+    double t_first_token = 0;
+    json seg_log = json::array();
+    int segments = 0, retries = 0, streamed_unchecked = 0, failed_played = 0;
+    std::vector<float> frame_ms;   // generation time per frame (talker + predictor), excluding text waits
+    double restore_ms = -1, first_step_ms = -1, first_frame_ms = -1;   // first attempt of segment 0
+    double first_exec_ms = -1, first_build_wait_ms = -1, first_decode_ms = -1;
+    bool want_decode_ms = false;
+    double ref_level = 0;   // loudness of the first segment with enough voice
+    std::vector<double> seg_start_s;   // virtual playback time each segment started
+    auto gain_for = [&](double lvl) {
+        if (ref_level <= 0 || lvl <= 0) return 1.0f;
+        return (float)std::clamp(ref_level / lvl, std::pow(10.0, -kMaxGainDb / 20), std::pow(10.0, kMaxGainDb / 20));
+    };
+    // gain for an attempt that starts streaming before it is complete: from what it has so far
+    auto gain_now = [&] {
+        const auto pcm = out.pcm();
+        return gain_for(active_rms(pcm.data(), pcm.size()));
+    };
+
+    try {
+        const Voice& vp = voice_prefix(voice, lang);
+        talker->fast()->hint(vp.len);   // runlists for the first positions get built while text arrives
+        wake();                          // a suspended NPU resumes while the text arrives
+        std::vector<float> e(D), tmp(D), h(D), x2(2 * CD), x1(CD), logits, cpl;
+        for (size_t k = 0;; k++) {
+            // ---- wait for segment k: enough text (or closed), and at most 2 segments ahead
+            Segment seg;
+            for (;;) {
+                if (stopping()) break;
+                const uint64_t ver = in.version();
+                const bool have = in.segment(k, seg);
+                if (!have && in.past_end(k)) break;
+                const bool ready = have && !seg.tokens.empty() &&
+                                   (seg.closed || (int)seg.tokens.size() >= opt.min_lead);
+                const bool lead_ok = k < 2 || (seg_start_s.size() >= k - 1 && out.playback_s() >= seg_start_s[k - 2]);
+                if (ready && lead_ok) break;
+                if (ready && !lead_ok) {
+                    const double wait_s = seg_start_s[k - 2] - out.playback_s();
+                    std::this_thread::sleep_for(std::chrono::milliseconds(std::clamp((int)(wait_s * 1000), 1, 20)));
+                } else {
+                    in.wait(ver, 20);
+                }
+            }
+            if (stopping() || !in.segment(k, seg)) break;
+            if (t_first_token == 0) t_first_token = unix_now();
+
+            // ---- attempts
+            bool done_ok = false;
+            const bool calibrating = !calib_dir.empty();
+            const int max_attempts = calibrating ? 1 : kMaxAttempts;
+            for (int attempt = 0; attempt < max_attempts && !done_ok; attempt++) {
+                std::mt19937_64 rng(mix(seed ^ (k << 20) ^ ((uint64_t)attempt << 40)));
+                const bool last_try = attempt + 1 == max_attempts;
+                const bool stream = k == 0 || out.ahead_s() < kStreamMarginS;
+                out.begin(stream, 1.0f);
+                const int64_t att_start = out.sent();
+                dw->start([&out](const float* x, size_t n) { out.on_pcm(x, n); });
+                const auto t_att = clk::now();
+                talker->fast()->restore_kv(vp.kv, vp.len);
+                talker->set_pos(vp.len);
+                if (restore_ms < 0) restore_ms = ms_since(t_att);
+                // position after the prefix: first text token + codec_bos
+                host->text_embed(seg.tokens[0], e.data());
+                for (int i = 0; i < D; i++) e[i] += bos_codec[i];
+                size_t consumed = 1;
+                std::copy_n(talker->step(e.data()), D, h.begin());
+                if (first_step_ms < 0) {
+                    first_step_ms = ms_since(t_att);
+                    first_exec_ms = talker->fast()->last_exec_ms;
+                    first_build_wait_ms = talker->fast()->last_wait_build_ms;
+                }
+                std::set<int> hist;
+                std::vector<float> Hwin;
+                double Hsum = 0;
+                int frames = 0;
+                bool eos_fed = false;
+                double wait_ms = 0;
+                std::string fail;
+                const int pos_limit = talker->max_pos() - 2;
+                auto frame_t = clk::now();
+                for (;;) {
+                    if (stopping()) break;
+                    // code0: penalties and masks as the official generate()
+                    host->talker_logits(h.data(), logits);
+                    for (int t : hist) logits[t] = logits[t] < 0 ? logits[t] * opt.repetition_penalty : logits[t] / opt.repetition_penalty;
+                    for (int i = TtsHost::kTalkerV - 1024; i < TtsHost::kTalkerV; i++) if (i != TtsHost::kEos) logits[i] = -INFINITY;
+                    if (frames < 2) logits[TtsHost::kEos] = -INFINITY;
+                    {
+                        auto p = softmax_t(logits, T);
+                        double H = 0;
+                        for (double v : p) if (v > 0) H -= v * std::log(v);
+                        Hwin.push_back((float)H);
+                        Hsum += H;
+                        if ((int)Hwin.size() > det.entropy_window) Hsum -= Hwin[Hwin.size() - 1 - det.entropy_window];
+                    }
+                    const int code0 = sample_topk(logits, scfg, rng);
+                    if (code0 == TtsHost::kEos) break;
+                    // checks on the frame about to be produced
+                    in.segment(k, seg);
+                    const int ntok = seg.closed ? seg.total_tokens : std::max<int>(seg.total_tokens, (int)consumed);
+                    if (!calibrating && (int)Hwin.size() >= det.entropy_window && Hsum / det.entropy_window > det.entropy_threshold) fail = "entropy";
+                    else if (!calibrating && seg.closed && frames >= (int)std::ceil(det.length_factor * det.frames_per_token * ntok + det.length_slack)) fail = "length";
+                    else if (frames >= (int)std::ceil(det.cap_per_token * ntok + det.cap_const) || talker->pos() >= pos_limit) fail = "cap";
+                    if (!fail.empty()) break;
+                    hist.insert(code0);
+                    int32_t fc[16];
+                    fc[0] = code0;
+                    cp->clear();
+                    host->project(h.data(), &x2[0]);
+                    host->talker_embed(code0, tmp.data());
+                    host->project(tmp.data(), &x2[CD]);
+                    cp->step(&x2[0]);
+                    const float* ph = cp->step(&x2[CD]);
+                    for (int g = 0; g < 15; g++) {
+                        host->cp_logits(g, ph, cpl);
+                        fc[g + 1] = sample_topk(cpl, scfg, rng);
+                        if (g == 14) break;
+                        host->cp_embed(g, fc[g + 1], tmp.data());
+                        host->project(tmp.data(), x1.data());
+                        ph = cp->step(x1.data());
+                    }
+                    dw->push(fc);
+                    frames++;
+                    if (first_frame_ms < 0) { first_frame_ms = ms_since(t_att); want_decode_ms = true; }
+                    // time to first audio: let the first chunk decode without the next frame's
+                    // host work competing for memory bandwidth
+                    if (frames == 1 && out.streaming()) dw->wait_first_chunk();
+                    // next talker input: codec embeddings of this frame + the next text input
+                    host->talker_embed(code0, e.data());
+                    for (int g = 0; g < 15; g++) {
+                        host->cp_embed(g, fc[g + 1], tmp.data());
+                        for (int i = 0; i < D; i++) e[i] += tmp[i];
+                    }
+                    // text for the next step: wait for it if the segment is still open
+                    const auto wait_t = clk::now();
+                    while (consumed >= seg.tokens.size() && !seg.closed && !stopping()) {
+                        if (!out.streaming() && out.ahead_s() < kStreamMarginS) { out.stream_now(gain_now()); streamed_unchecked++; }
+                        const uint64_t ver = in.version();
+                        in.segment(k, seg);
+                        if (consumed < seg.tokens.size() || seg.closed) break;
+                        in.wait(ver, 10);
+                        in.segment(k, seg);
+                    }
+                    wait_ms = ms_since(wait_t);
+                    const float* txt;
+                    if (consumed < seg.tokens.size()) {
+                        host->text_embed(seg.tokens[consumed], tmp.data());
+                        txt = tmp.data();
+                        consumed++;
+                        if (req.events) {
+                            // text the talker has not consumed yet, over this and later segments
+                            int lead = (int)seg.tokens.size() - (int)consumed;
+                            Segment later;
+                            for (size_t j = k + 1; in.segment(j, later); j++) lead += (int)later.tokens.size();
+                            event({{"type", "lead"}, {"segment", k}, {"consumed", consumed}, {"lead", lead}});
+                        }
+                    } else if (seg.closed && !eos_fed) {
+                        txt = eos_e.data();
+                        eos_fed = true;
+                    } else {
+                        txt = pad_e.data();
+                    }
+                    for (int i = 0; i < D; i++) e[i] += txt[i];
+                    std::copy_n(talker->step(e.data()), D, h.begin());
+                    frame_ms.push_back((float)ms_since(frame_t) - (float)wait_ms);
+                    frame_t = clk::now();
+                    wait_ms = 0;
+                    // a checked attempt streams once the listener is about to run out
+                    if (!out.streaming() && out.ahead_s() < kStreamMarginS) {
+                        out.stream_now(gain_now());
+                        streamed_unchecked++;
+                    }
+                    if (out.client_gone()) break;
+                }
+                talker->fast()->hint(vp.len);   // the next attempt starts after the prefix again
+                if (want_decode_ms) { first_decode_ms = dw->first_decode_ms; want_decode_ms = false; }
+                const bool stop_now = stopping() || out.client_gone();
+                dw->finish(stop_now || (!fail.empty() && !last_try));
+                if (stop_now) { out.drop(); break; }
+                const bool ok = fail.empty() || last_try;
+                if (calibrating) {
+                    // entropy of the frames produced (the last entry belongs to the stopping step)
+                    std::vector<float> H(Hwin.begin(), Hwin.begin() + std::min<size_t>(Hwin.size(), (size_t)frames));
+                    std::lock_guard<std::mutex> l(calib_mu);
+                    const std::string id = std::to_string(calib_utt) + "_" + std::to_string(k);
+                    const auto pcm_c = out.pcm();
+                    write_wav16(calib_dir + "/" + id + ".wav", pcm_c, kSampleRate);
+                    json rec = {{"id", id}, {"seed", seed}, {"voice", voice}, {"language", lang}, {"segment", k},
+                                {"text", seg.text}, {"text_tokens", seg.total_tokens}, {"frames", frames},
+                                {"capped", fail == "cap"}, {"temperature", T}, {"entropy", H}};
+                    std::ofstream(calib_dir + "/segments.jsonl", std::ios::app) << rec.dump() << "\n";
+                }
+                // loudness: match the first segment's level (whole segment when it was checked)
+                const auto pcm = out.pcm();
+                const double lvl = active_rms(pcm.data(), pcm.size());
+                const float gain = gain_for(lvl);
+                const bool was_streaming = out.streaming();
+                if (ok) {
+                    if (seg_start_s.size() <= k) seg_start_s.push_back((double)att_start / kSampleRate);
+                    out.commit(gain);
+                    if (ref_level == 0 && lvl > 0) ref_level = lvl * (was_streaming ? 1.0 : gain);
+                    if (!fail.empty()) failed_played++;
+                    segments++;
+                    done_ok = true;
+                } else {
+                    out.drop();
+                    retries++;
+                    if (was_streaming && out.released() > 0) out.silence(kRetryGapMs);
+                }
+                json sl = {{"index", k}, {"attempt", attempt}, {"text", seg.text}, {"tokens", seg.total_tokens},
+                           {"frames", frames}, {"status", fail.empty() ? "ok" : (ok ? "failed_played" : "retry")},
+                           {"reason", fail}, {"streamed", was_streaming}, {"gain_db", 20 * std::log10(gain)}};
+                if (req.events) {
+                    json ev = {{"type", "segment"}};
+                    ev.update(sl);
+                    event(ev);
+                }
+                seg_log.push_back(sl);
+            }
+            if (stopping() || out.client_gone()) break;
+            // pause after the segment unless it is the last one
+            Segment cur;
+            in.segment(k, cur);
+            if (!(in.past_end(k + 1))) out.silence(cur.pause_ms > 0 ? cur.pause_ms : 350);
+        }
+    } catch (const NpuFault& f) {
+        dw->finish(true);
+        set_fault(f.what());
+    } catch (const std::exception& ex) {
+        dw->finish(true);
+        return {TtsResult::error, ex.what(), {}};
+    }
+    std::sort(frame_ms.begin(), frame_ms.end());
+    auto pct = [&](double q) { return frame_ms.empty() ? 0.0 : (double)frame_ms[std::min(frame_ms.size() - 1, (size_t)(q * (frame_ms.size() - 1) + 0.5))]; };
+    double fsum = 0;
+    for (float v : frame_ms) fsum += v;
+    if (!calib_dir.empty()) { std::lock_guard<std::mutex> l(calib_mu); calib_utt++; }
+    json m = {{"voice", voice}, {"language", lang}, {"seed", seed}, {"audio_s", (double)out.sent() / kSampleRate},
+              {"frames", frame_ms.size()}, {"restore_ms", restore_ms}, {"first_step_ms", first_step_ms},
+              {"first_frame_ms", first_frame_ms}, {"first_exec_ms", first_exec_ms}, {"first_build_wait_ms", first_build_wait_ms}, {"first_decode_ms", first_decode_ms}, {"frame_ms_mean", frame_ms.empty() ? 0.0 : fsum / frame_ms.size()},
+              {"frame_ms_p99", pct(0.99)}, {"frame_ms_max", frame_ms.empty() ? 0.0 : (double)frame_ms.back()},
+              {"segments", segments}, {"retries", retries}, {"streamed_unchecked", streamed_unchecked},
+              {"failed_played", failed_played},
+              {"ttfa_ms", out.first_audio_unix() > 0 && t_first_token > 0 ? 1000 * (out.first_audio_unix() - t_first_token) : -1},
+              {"ttfa_from_request_ms", out.first_audio_unix() > 0 ? 1000 * (out.first_audio_unix() - t_request) : -1},
+              {"segment_log", seg_log}};
+    if (fault) return {TtsResult::fault, "NPU fault: " + fault_msg, m};
+    if (cancelled() || in.cancelled() || out.client_gone()) return {TtsResult::cancelled, "cancelled", m};
+    return {TtsResult::ok, "", m};
+}
+
+}  // namespace qwen3_tts
