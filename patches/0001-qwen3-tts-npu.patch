+bool HttpSession::write_raw_chunk(const void* data, std::size_t n) {
+    if (n == 0) return true;
+    boost::system::error_code ec;
+    if (raw_mode_ == RawMode::chunked) {
+        std::ostringstream sz;
+        sz << std::hex << n << "\r\n";
+        const std::string head = sz.str();
+        std::array<net::const_buffer, 3> bufs{net::buffer(head), net::buffer(data, n), net::buffer("\r\n", 2)};
+        net::write(socket_, bufs, ec);
+    } else {
+        net::write(socket_, net::buffer(data, n), ec);
+    }
+    if (ec) {
+        if (cancellation_token_ && !cancellation_token_->completed()) cancellation_token_->cancel();
+        return false;
+    }
+    return true;
+}
+
+void HttpSession::write_raw_end() {
+    boost::system::error_code ec;
+    if (raw_mode_ == RawMode::chunked) net::write(socket_, net::buffer(std::string("0\r\n\r\n")), ec);
+    socket_.shutdown(tcp::socket::shutdown_both, ec);
+    server_.active_connections_.fetch_sub(1);
+}
