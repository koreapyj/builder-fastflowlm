+/// \file test_tts_text.cpp
+/// \brief Qwen3-TTS text normalization and segmentation (common/qwen3_tts/tts_text.cpp).
+/// \note  A stand-in tokenizer (one token per code point, one per ASCII word) keeps the
+///        tests free of model files; the rules under test only count tokens.
+#include "qwen3_tts/tts_text.hpp"
+
+#include <cstdio>
+#include <string>
+#include <vector>
+
+using qwen3_tts::Segment;
+using qwen3_tts::Segmenter;
+
+namespace {
+
+int failures = 0;
+
+#define CHECK(cond)                                                                 \
+    do {                                                                            \
+        if (!(cond)) {                                                              \
+            std::fprintf(stderr, "%s:%d: CHECK failed: %s\n", __FILE__, __LINE__, #cond); \
+            failures++;                                                             \
+        }                                                                           \
+    } while (0)
+
+#define CHECK_EQ(a, b)                                                              \
+    do {                                                                            \
+        const auto va = (a);                                                        \
+        const auto vb = (b);                                                        \
+        if (!(va == vb)) {                                                          \
+            std::fprintf(stderr, "%s:%d: CHECK_EQ failed: %s\n", __FILE__, __LINE__, #a " == " #b); \
+            failures++;                                                             \
+        }                                                                           \
+    } while (0)
+
+std::vector<int> fake_encode(const std::string& s) {
+    std::vector<int> out;
+    bool in_word = false;
+    for (size_t i = 0; i < s.size();) {
+        const unsigned char c = (unsigned char)s[i];
+        if (c < 0x80) {
+            const bool alnum = std::isalnum(c);
+            if (alnum && !in_word) out.push_back(c);
+            if (!alnum && c != ' ') out.push_back(c);
+            in_word = alnum;
+            i++;
+        } else {
+            in_word = false;
+            out.push_back(c);
+            i += c >= 0xF0 ? 4 : c >= 0xE0 ? 3 : 2;
+        }
+    }
+    return out;
+}
+
+std::vector<Segment> run(const std::string& text, bool one_char_at_a_time = false) {
+    Segmenter sg(fake_encode);
+    if (one_char_at_a_time) {
+        for (char c : text) sg.push(std::string(1, c));
+    } else {
+        sg.push(text);
+    }
+    sg.finish();
+    return sg.segments();
+}
+
+std::vector<std::string> texts(const std::vector<Segment>& v) {
+    std::vector<std::string> out;
+    for (auto& s : v) out.push_back(s.text);
+    return out;
+}
+
+void test_cjk_space_becomes_period() {
+    CHECK_EQ(Segmenter::normalize("いいですね 室内で遊べます", true, nullptr), std::string("いいですね。室内で遊べます"));
+    // Latin text and Korean keep their spaces
+    CHECK_EQ(Segmenter::normalize("Hello world, again", true, nullptr), std::string("Hello world, again"));
+    CHECK_EQ(Segmenter::normalize("안녕하세요 반갑습니다", true, nullptr), std::string("안녕하세요 반갑습니다"));
+    // no space after Japanese punctuation
+    CHECK_EQ(Segmenter::normalize("はい。 次です", true, nullptr), std::string("はい。次です"));
+}
+
+void test_markdown_and_bullets() {
+    CHECK_EQ(Segmenter::normalize("**大事**な点:\n- 一つ目\n- 二つ目", true, nullptr),
+             std::string("大事な点:一つ目二つ目"));
+    CHECK_EQ(Segmenter::normalize("1. first\n2. second", true, nullptr), std::string("firstsecond"));
+}
+
+void test_sentence_ends() {
+    std::vector<size_t> ends;
+    Segmenter::normalize("It costs 3.14 dollars. Dr. Smith agrees! OK", true, &ends);
+    // ends after "dollars." , "agrees!" and the final text; not after 3. or Dr.
+    CHECK_EQ(ends.size(), (size_t)3);
+    ends.clear();
+    Segmenter::normalize("今日は晴れ。「本当？」と聞いた", true, &ends);
+    CHECK_EQ(ends.size(), (size_t)3);   // 。 , ？」 (closer stays with its sentence), end
+}
+
+void test_merge_to_min_tokens() {
+    // short sentences merge until >= 17 tokens; the tail may stay short
+    auto seg = run("はい。そうです。今日はとても良い天気ですね。明日も晴れるでしょう。うん。");
+    CHECK_EQ(seg.size(), (size_t)2);
+    CHECK_EQ(seg[0].text, std::string("はい。そうです。今日はとても良い天気ですね。"));
+    CHECK(seg[0].total_tokens >= 17);
+    CHECK_EQ(seg[1].text, std::string("明日も晴れるでしょう。うん。"));
+    for (auto& s : seg) CHECK(s.closed);
+    CHECK_EQ(seg.back().pause_ms, 0);
+    CHECK_EQ(seg[0].pause_ms, 350);
+}
+
+void test_never_cut_at_commas() {
+    auto seg = run("春、夏、秋、そして冬という四つの季節があり、それぞれの季節が異なる美しさをもたらしています。");
+    CHECK_EQ(seg.size(), (size_t)1);
+}
+
+void test_overlong_cut_after_comma() {
+    std::string s;
+    for (int i = 0; i < 30; i++) s += "とても長い文章が続きます、";
+    s += "おわり。";
+    auto seg = run(s);
+    CHECK(seg.size() >= 2);
+    for (auto& g : seg) CHECK(g.total_tokens <= 200);
+    CHECK_EQ(seg[0].pause_ms, 150);
+    // the cut lands right after a comma
+    CHECK(seg[0].text.size() >= 3 && seg[0].text.substr(seg[0].text.size() - 3) == "、");
+}
+
+void test_streaming_matches_one_shot() {
+    const std::string t =
+        "いいですね 室内で楽しめる遊びはいくつかありますよ。トランプやUNOなどのカードゲームはルールが簡単です。"
+        "Hello! This is a quick test. お絵描きも、おすすめです。";
+    CHECK(texts(run(t)) == texts(run(t, true)));
+}
+
+void test_open_segment_holds_back_last_token() {
+    Segmenter sg(fake_encode);
+    sg.push("今日は");
+    CHECK_EQ(sg.segments().size(), (size_t)1);
+    CHECK(!sg.segments()[0].closed);
+    CHECK_EQ(sg.segments()[0].tokens.size(), (size_t)2);   // 3 code points, last held back
+    sg.push("晴れ");
+    CHECK_EQ(sg.segments()[0].tokens.size(), (size_t)4);
+    sg.finish();
+    CHECK(sg.segments()[0].closed);
+    CHECK_EQ(sg.segments()[0].tokens.size(), (size_t)5);
+}
+
+void test_closed_segments_are_stable() {
+    Segmenter sg(fake_encode);
+    sg.push("今日はとても良い天気ですね、散歩に行きましょう。明日も晴れるでしょう。");
+    const auto first = sg.segments();
+    CHECK(first.size() >= 1 && first[0].closed);
+    sg.push("それではまた。");
+    CHECK_EQ(sg.segments()[0].text, first[0].text);
+}
+
+}  // namespace
+
+int main() {
+    test_cjk_space_becomes_period();
+    test_markdown_and_bullets();
+    test_sentence_ends();
+    test_merge_to_min_tokens();
+    test_never_cut_at_commas();
+    test_overlong_cut_after_comma();
+    test_streaming_matches_one_shot();
+    test_open_segment_holds_back_last_token();
+    test_closed_segments_are_stable();
+    if (failures) {
+        std::fprintf(stderr, "%d check(s) failed\n", failures);
+        return 1;
+    }
+    std::printf("all tests passed\n");
+    return 0;
+}
