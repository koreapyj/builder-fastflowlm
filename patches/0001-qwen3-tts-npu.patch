@@ -0,0 +1,221 @@
+// Recording side of the load-time capture (see qwen3_tts/xrt_capture.hpp). Uses the real
+// XRT headers; xrt_interpose.cpp, which defines the interposed XRT symbols, cannot.
+#include "qwen3_tts/xrt_capture.hpp"
+
+#include <dlfcn.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <stdexcept>
+
+#include "buffer.hpp"
+#include "tensor_utils/safe_tensors.hpp"
+#include "typedef.hpp"
+#include "xrt/xrt_bo.h"
+#include "xrt/xrt_hw_context.h"
+
+namespace qwen3_tts::cap {
+
+namespace {
+
+// The output head is the one run whose instruction stream is ~420 KB; every other stream
+// of the qwen3 engine is under 60 KB.
+constexpr size_t kHeadElfMin = 300000;
+
+std::atomic<bool> g_open{false};
+std::recursive_mutex g_mu;   // the bo syncs in on_sync come back through the interposer
+
+struct State {
+    void* embed = nullptr;
+    std::vector<float> norm;
+    // handle maps for head detection
+    std::map<const void*, size_t> elf_size;           // elf -> bytes
+    std::map<const void*, const void*> module_elf;    // module -> elf
+    std::map<const void*, const void*> kernel_module; // kernel -> module
+    std::map<const void*, const void*> run_kernel;    // run -> kernel
+    std::map<int, xrt::bo> head_args;                 // latest head run's bo args
+    // build capture
+    bool building = false;
+    Build build;
+    std::map<const void*, std::vector<uint8_t>> elf_bytes;   // elf -> bytes (building only)
+    xrt::hw_context ctx;
+    std::map<const void*, Run> runs;
+    std::map<std::pair<const void*, int>, xrt::bo> run_bos;  // (run, idx) -> bo
+    std::map<std::pair<size_t, int>, xrt::bo> pos_bos;       // (runlist pos, idx) -> bo
+    // harvest
+    bool harvesting = false;
+    size_t sync_bytes = 0;
+    std::vector<std::vector<uint8_t>> h_elfs, h_syncs;
+};
+State* g = nullptr;
+
+bool is_head_run(const void* run) {
+    auto r = g->run_kernel.find(run);
+    if (r == g->run_kernel.end()) return false;
+    auto m = g->kernel_module.find(r->second);
+    if (m == g->kernel_module.end()) return false;
+    auto e = g->module_elf.find(m->second);
+    if (e == g->module_elf.end()) return false;
+    auto s = g->elf_size.find(e->second);
+    return s != g->elf_size.end() && s->second >= kHeadElfMin;
+}
+
+}  // namespace
+
+void open() {
+    std::lock_guard<std::recursive_mutex> l(g_mu);
+    if (g) throw std::runtime_error("qwen3_tts: capture scope already open");
+    g = new State();
+    g_open = true;
+}
+
+void close() {
+    std::lock_guard<std::recursive_mutex> l(g_mu);
+    g_open = false;
+    delete g;
+    g = nullptr;
+}
+
+bool is_open() { return g_open.load(std::memory_order_relaxed); }
+
+void* embed_buffer() { return g ? g->embed : nullptr; }
+const std::vector<float>& final_norm() {
+    static const std::vector<float> empty;
+    return g ? g->norm : empty;
+}
+
+void build_begin() {
+    std::lock_guard<std::recursive_mutex> l(g_mu);
+    g->build = Build{};
+    g->runs.clear();
+    g->run_bos.clear();
+    g->pos_bos.clear();
+    g->building = true;
+}
+
+const Build& build_end() {
+    std::lock_guard<std::recursive_mutex> l(g_mu);
+    g->building = false;
+    return g->build;
+}
+
+const void* build_ctx() { return &g->ctx; }
+const void* build_bo(size_t pos, int idx) { return &g->pos_bos.at({pos, idx}); }
+
+void harvest_begin(size_t sync_bytes) {
+    std::lock_guard<std::recursive_mutex> l(g_mu);
+    g->h_elfs.clear();
+    g->h_syncs.clear();
+    g->sync_bytes = sync_bytes;
+    g->harvesting = true;
+}
+
+void harvest_end(std::vector<std::vector<uint8_t>>& elfs, std::vector<std::vector<uint8_t>>& syncs) {
+    std::lock_guard<std::recursive_mutex> l(g_mu);
+    g->harvesting = false;
+    elfs = std::move(g->h_elfs);
+    syncs = std::move(g->h_syncs);
+}
+
+const void* head_bo(int idx) {
+    auto it = g->head_args.find(idx);
+    if (it == g->head_args.end()) throw std::runtime_error("qwen3_tts: output head buffer not captured");
+    return &it->second;
+}
+
+void on_load_weights(const std::string& name, void* bytes_obj, const uint8_t* data, size_t size) {
+    std::lock_guard<std::recursive_mutex> l(g_mu);
+    if (!g) return;
+    if (name == "model.embed_tokens.weight") g->embed = bytes_obj;
+    if (name == "model.norm.weight") {
+        const bf16* p = reinterpret_cast<const bf16*>(data);
+        g->norm.resize(size / 2);
+        for (size_t i = 0; i < g->norm.size(); i++) g->norm[i] = (float)p[i];
+    }
+}
+
+void on_elf(const void* elf, const void* data, size_t size) {
+    std::lock_guard<std::recursive_mutex> l(g_mu);
+    if (!g) return;
+    g->elf_size[elf] = size;
+    auto* p = static_cast<const uint8_t*>(data);
+    if (g->building) g->elf_bytes[elf].assign(p, p + size);
+    if (g->harvesting) g->h_elfs.emplace_back(p, p + size);
+}
+
+void on_module(const void* module, const void* elf) {
+    std::lock_guard<std::recursive_mutex> l(g_mu);
+    if (g) g->module_elf[module] = elf;
+}
+
+void on_kernel(const void* kernel, const void* ctx_obj, const void* module, const std::string& name) {
+    std::lock_guard<std::recursive_mutex> l(g_mu);
+    if (!g) return;
+    g->kernel_module[kernel] = module;
+    if (!g->building) return;
+    g->ctx = *reinterpret_cast<const xrt::hw_context*>(ctx_obj);
+    g->build.kernels.push_back(kernel);
+    g->build.names.push_back(name);
+    auto e = g->module_elf.find(module);
+    g->build.elfs.push_back(e != g->module_elf.end() ? g->elf_bytes[e->second] : std::vector<uint8_t>());
+}
+
+void on_run(const void* run, const void* kernel) {
+    std::lock_guard<std::recursive_mutex> l(g_mu);
+    if (!g) return;
+    g->run_kernel[run] = kernel;
+    if (g->building) g->runs[run] = Run{kernel, {}, {}};
+}
+
+void on_arg_bo(const void* run, int idx, const void* bo_obj) {
+    std::lock_guard<std::recursive_mutex> l(g_mu);
+    if (!g) return;
+    if (is_head_run(run)) g->head_args[idx] = *reinterpret_cast<const xrt::bo*>(bo_obj);   // shares the handle
+    if (!g->building || !g->runs.count(run)) return;
+    g->runs[run].bo_idx.push_back(idx);
+    g->run_bos[{run, idx}] = *reinterpret_cast<const xrt::bo*>(bo_obj);
+}
+
+void on_arg_scalar(const void* run, int idx, const void* val, size_t bytes) {
+    std::lock_guard<std::recursive_mutex> l(g_mu);
+    if (!g || !g->building || !g->runs.count(run)) return;
+    uint32_t v = 0;
+    std::memcpy(&v, val, std::min<size_t>(bytes, 4));
+    g->runs[run].scalars.push_back({idx, v});
+}
+
+void on_runlist_add(const void* run) {
+    std::lock_guard<std::recursive_mutex> l(g_mu);
+    if (!g || !g->building || !g->runs.count(run)) return;
+    // rekey the bo copies by runlist position (the run handle dies after add)
+    const size_t pos = g->build.runs.size();
+    Run r = g->runs[run];
+    for (int idx : r.bo_idx) g->pos_bos[{pos, idx}] = g->run_bos[{run, idx}];
+    g->build.runs.push_back(std::move(r));
+}
+
+void on_sync(const void* bo_obj, int dir, size_t size, size_t off) {
+    std::lock_guard<std::recursive_mutex> l(g_mu);
+    if (!g || !g->harvesting || dir != XCL_BO_SYNC_BO_TO_DEVICE) return;
+    auto& b = *reinterpret_cast<xrt::bo*>(const_cast<void*>(bo_obj));
+    const uint8_t* p = b.map<uint8_t*>() + off;
+    (void)size;
+    g->h_syncs.emplace_back(p, p + std::min(g->sync_bytes, b.size() - off));
+}
+
+}  // namespace qwen3_tts::cap
+
+// The engine .so loads its tensors through SafeTensors::load_weights@plt; flm exports this
+// definition (interpose.dynlist), so those calls arrive here and are forwarded to the real
+// function in libq4_npu_eXpress. Only the 2-argument overload is used by qwen3_npu.
+using load_fn_t = std::string (*)(SafeTensors*, bytes&, std::string);
+std::string SafeTensors::load_weights(bytes& b, std::string name) {
+    static load_fn_t real = reinterpret_cast<load_fn_t>(dlsym(
+        RTLD_NEXT, "_ZN11SafeTensors12load_weightsER5bytesNSt7__cxx1112basic_stringIcSt11char_traitsIcESaIcEEE"));
+    std::string r = real(this, b, name);
+    if (qwen3_tts::cap::is_open()) qwen3_tts::cap::on_load_weights(name, &b, b.data(), b.size());
+    return r;
+}
diff --git a/src/common/qwen3_tts/xrt_interpose.cpp b/src/common/qwen3_tts/xrt_interpose.cpp
new file mode 100644
index 00000000..46ec47a5
--- /dev/null
+++ b/src/common/qwen3_tts/xrt_interpose.cpp
@@ -0,0 +1,85 @@
+// Interposed XRT entry points (see qwen3_tts/xrt_capture.hpp).
+//
+// Defined by their mangled names, so this file must not include the XRT headers. Each
+// wrapper forwards to the real function (dlsym RTLD_NEXT) and, only while a capture scope
+// is open, reports the call to xrt_capture.cpp. Objects are identified by their pimpl
+// handle (the first pointer inside every xrt:: handle class), which survives copies.
+#include <dlfcn.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+
+#include "qwen3_tts/xrt_capture.hpp"
+
+namespace {
+
+template <class F> F real(const char* sym) {
+    void* p = dlsym(RTLD_NEXT, sym);
+    if (!p) {
+        fprintf(stderr, "qwen3_tts: dlsym(%s) failed\n", sym);
+        std::abort();
+    }
+    return reinterpret_cast<F>(p);
+}
+
+const void* H(const void* obj) { return obj ? *reinterpret_cast<void* const*>(obj) : nullptr; }
+
+namespace cap = qwen3_tts::cap;
+
+}  // namespace
+
+extern "C" {
+
+void _ZN3xrt3elfC1EPKvm(void* self, const void* data, unsigned long size) {
+    static auto f = real<void (*)(void*, const void*, unsigned long)>("_ZN3xrt3elfC1EPKvm");
+    f(self, data, size);
+    if (cap::is_open()) cap::on_elf(H(self), data, size);
+}
+
+void _ZN3xrt6moduleC1ERKNS_3elfE(void* self, const void* elf) {
+    static auto f = real<void (*)(void*, const void*)>("_ZN3xrt6moduleC1ERKNS_3elfE");
+    f(self, elf);
+    if (cap::is_open()) cap::on_module(H(self), H(elf));
+}
+
+void _ZN3xrt3ext6kernelC1ERKNS_10hw_contextERKNS_6moduleERKNSt7__cxx1112basic_stringIcSt11char_traitsIcESaIcEEE(
+        void* self, const void* ctx, const void* mod, const std::string& name) {
+    static auto f = real<void (*)(void*, const void*, const void*, const std::string&)>(
+        "_ZN3xrt3ext6kernelC1ERKNS_10hw_contextERKNS_6moduleERKNSt7__cxx1112basic_stringIcSt11char_traitsIcESaIcEEE");
+    f(self, ctx, mod, name);
+    if (cap::is_open()) cap::on_kernel(H(self), ctx, H(mod), name);
+}
+
+void _ZN3xrt3runC1ERKNS_6kernelE(void* self, const void* kernel) {
+    static auto f = real<void (*)(void*, const void*)>("_ZN3xrt3runC1ERKNS_6kernelE");
+    f(self, kernel);
+    if (cap::is_open()) cap::on_run(H(self), H(kernel));
+}
+
+void _ZN3xrt3run16set_arg_at_indexEiRKNS_2boE(void* self, int idx, const void* bo) {
+    static auto f = real<void (*)(void*, int, const void*)>("_ZN3xrt3run16set_arg_at_indexEiRKNS_2boE");
+    f(self, idx, bo);
+    if (cap::is_open()) cap::on_arg_bo(H(self), idx, bo);
+}
+
+void _ZN3xrt3run16set_arg_at_indexEiPKvm(void* self, int idx, const void* val, unsigned long bytes) {
+    static auto f = real<void (*)(void*, int, const void*, unsigned long)>("_ZN3xrt3run16set_arg_at_indexEiPKvm");
+    f(self, idx, val, bytes);
+    if (cap::is_open()) cap::on_arg_scalar(H(self), idx, val, bytes);
+}
+
+void _ZN3xrt7runlist3addEONS_3runE(void* self, void* run) {
+    static auto f = real<void (*)(void*, void*)>("_ZN3xrt7runlist3addEONS_3runE");
+    const void* r = H(run);   // before the move empties it
+    if (cap::is_open()) cap::on_runlist_add(r);
+    f(self, run);
+}
+
+void _ZN3xrt2bo4syncE18xclBOSyncDirectionmm(void* self, int dir, unsigned long size, unsigned long off) {
+    static auto f = real<void (*)(void*, int, unsigned long, unsigned long)>("_ZN3xrt2bo4syncE18xclBOSyncDirectionmm");
+    f(self, dir, size, off);
+    if (cap::is_open()) cap::on_sync(self, dir, size, off);
+}
+
+}  // extern "C"
