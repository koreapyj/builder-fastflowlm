diff --git a/src/runner/tts_cli.cpp b/src/runner/tts_cli.cpp
new file mode 100644
index 00000000..12ce9695
--- /dev/null
+++ b/src/runner/tts_cli.cpp
@@ -0,0 +1,126 @@
+/*!
+ * \file tts_cli.cpp
+ * \brief `flm run <text-to-speech model>` (see tts_cli.hpp)
+ */
+#include "tts_cli.hpp"
+
+#include <cstdlib>
+#include <fstream>
+#include <iomanip>
+#include <iostream>
+#include <sstream>
+
+#include "utils/debug_utils.hpp"
+
+#ifdef FLM_QWEN3_TTS
+#include "qwen3_tts/qwen3_tts.hpp"
+#include "qwen3_tts/tts_common.hpp"
+#include "tts_service.hpp"
+
+namespace {
+
+using qwen3_tts::Qwen3Tts;
+
+bool speak_to_wav(Qwen3Tts& tts, const qwen3_tts::TtsRequest& rq, const std::string& text, const std::string& path) {
+    auto in = tts.make_input();
+    in->push(text);
+    in->finish();
+    std::vector<float> pcm;
+    qwen3_tts::TtsSink sink;
+    sink.audio = [&](const int16_t* x, size_t n) {
+        for (size_t i = 0; i < n; i++) pcm.push_back(x[i] / 32768.0f);
+        return true;
+    };
+    const auto t0 = std::chrono::steady_clock::now();
+    auto r = tts.speak(rq, *in, sink, [] { return false; });
+    const double wall = std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+    if (r.status != qwen3_tts::TtsResult::ok) {
+        header_print("ERROR", r.message);
+        return false;
+    }
+    qwen3_tts::write_wav16(path, pcm, Qwen3Tts::kSampleRate);
+    const double audio = (double)pcm.size() / Qwen3Tts::kSampleRate;
+    std::cout << std::fixed << std::setprecision(2) << "  -> " << path << ": " << audio << " s audio in " << wall
+              << " s (RTF " << (audio > 0 ? wall / audio : 0) << "), TTFA " << std::setprecision(0)
+              << r.metrics.value("ttfa_ms", -1.0) << " ms, " << r.metrics.value("segments", 0) << " segments, "
+              << r.metrics.value("retries", 0) << " retries" << std::endl;
+    if (std::getenv("FLM_TTS_DEBUG"))
+        for (const auto& s : r.metrics["segment_log"]) std::cout << "     " << s.dump() << std::endl;
+    return true;
+}
+
+}  // namespace
+
+int run_tts_cli(model_list& models, program_args_t& args, flm_rt::device* device) {
+    std::string err;
+    const std::string dir = tts_model_dir(models, args.model_tag, &err);
+    if (dir.empty()) {
+        header_print("ERROR", err);
+        return 1;
+    }
+    if (!device) {
+        header_print("ERROR", "No NPU device available");
+        return 1;
+    }
+    std::unique_ptr<Qwen3Tts> tts;
+    try {
+        tts = std::make_unique<Qwen3Tts>(device, dir);
+    } catch (const std::exception& e) {
+        header_print("ERROR", "Failed to load " << args.model_tag << ": " << e.what());
+        return 1;
+    }
+    qwen3_tts::TtsRequest rq;
+    rq.voice = tts->default_voice();
+    if (!args.input_file_name.empty()) {
+        std::ifstream f(args.input_file_name);
+        if (!f) { header_print("ERROR", "cannot read " << args.input_file_name); return 1; }
+        std::stringstream ss;
+        ss << f.rdbuf();
+        return speak_to_wav(*tts, rq, ss.str(), args.input_file_name + ".wav") ? 0 : 1;
+    }
+    std::cout << "Text-to-speech: each line is spoken to a WAV file. Commands: /voice <name>, /lang <language|auto>, "
+                 "/seed <n>, /voices, /bye" << std::endl;
+    int n = 0;
+    std::string line;
+    for (;;) {
+        std::cout << "[" << rq.voice << (rq.language.empty() ? "" : "/" + rq.language) << "] >>> " << std::flush;
+        if (!std::getline(std::cin, line)) break;
+        if (line.empty()) continue;
+        if (line[0] == '/') {
+            std::istringstream ss(line);
+            std::string cmd, a;
+            ss >> cmd >> a;
+            if (cmd == "/bye" || cmd == "/exit" || cmd == "/quit") break;
+            if (cmd == "/voices") {
+                for (auto& v : tts->voices()) std::cout << "  " << v << std::endl;
+                std::cout << "  languages:";
+                for (auto& l : tts->languages()) std::cout << " " << l;
+                std::cout << std::endl;
+            } else if (cmd == "/voice" || cmd == "/lang") {
+                const std::string e = cmd == "/voice" ? tts->check_voice(a, rq.language) : tts->check_voice(rq.voice, a);
+                if (!e.empty()) std::cout << "  " << e << std::endl;
+                else if (cmd == "/voice") rq.voice = a;
+                else rq.language = a;
+            } else if (cmd == "/seed") {
+                rq.seed = a.empty() ? 0 : std::stoull(a);
+            } else {
+                std::cout << "  unknown command" << std::endl;
+            }
+            continue;
+        }
+        std::ostringstream path;
+        path << "flm_tts_" << std::setw(3) << std::setfill('0') << n++ << ".wav";
+        speak_to_wav(*tts, rq, line, path.str());
+        if (tts->faulted()) return 2;
+    }
+    return 0;
+}
+
