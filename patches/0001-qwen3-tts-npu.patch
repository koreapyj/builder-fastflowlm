+/*!
+ * \file tts_service.hpp
+ * \brief Text-to-speech endpoints (Qwen3-TTS on the NPU)
+ *
+ *  POST /v1/audio/speech         OpenAI / vLLM-Omni request shape; WAV or PCM, whole or streamed
+ *  GET  /v1/audio/speech/stream  WebSocket: text in as it is produced (LLM output), audio out
+ *  GET  /v1/audio/voices         voices and languages
+ *  POST /v1/audio/speech/cancel  stop the utterance being spoken
+ *
+ * One utterance at a time: a new request while one is being spoken is rejected (409)
+ * unless it asks for cancel-and-replace ("replace": true). Every utterance holds FLM's
+ * NPU lock while it runs, like any other NPU request.
+ */
+#pragma once
+
+#ifdef FLM_QWEN3_TTS
+
+#include <atomic>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+
+#include "model_list.hpp"
+#include "qwen3_tts/qwen3_tts.hpp"
+
+class WebServer;
+
+class TtsService {
+public:
+    /// \brief loads the model (throws if the package is missing or the NPU fails)
+    TtsService(model_list& models, const std::string& tag, flm_rt::device* device, WebServer* server);
+    ~TtsService();
+    void register_routes(WebServer& server);
+
+    // one utterance at a time across HTTP and WebSocket clients
+    /// \return false if another utterance is active and replace is false
+    bool begin_utterance(bool replace, std::function<void()> cancel, uint64_t* id);
+    void end_utterance(uint64_t id);
+    bool busy() const;
+    void cancel_active();
+
+    qwen3_tts::Qwen3Tts& engine() { return *engine_; }
+    const std::string& tag() const { return tag_; }
+    WebServer* server() { return server_; }
+
+private:
+    std::string tag_;
+    WebServer* server_;
+    std::unique_ptr<qwen3_tts::Qwen3Tts> engine_;
+    mutable std::mutex mu_;
+    uint64_t active_id_ = 0, next_id_ = 1;
+    std::function<void()> active_cancel_;
+    // keep-warm: a tiny NPU dispatch every few seconds for a while after each utterance
+    std::thread warm_;
+    std::atomic<bool> stop_{false};
+    void keep_warm_loop(double window_s);
+};
+
+/// \brief the model directory of a TTS tag, or "" with a message when the package is missing
+std::string tts_model_dir(model_list& models, const std::string& tag, std::string* error);
+
+#endif  // FLM_QWEN3_TTS
