+#include "qwen3_tts/tts_host.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <numeric>
+#include <random>
+#include <stdexcept>
+
+namespace qwen3_tts {
+
+int sample_topk(std::vector<float>& logits, const SamplerCfg& cfg, std::mt19937_64& rng) {
+    const int V = (int)logits.size();
+    const int k = std::min(cfg.top_k, V);
+    std::vector<int> idx(V);
+    std::iota(idx.begin(), idx.end(), 0);
+    std::partial_sort(idx.begin(), idx.begin() + k, idx.end(), [&](int a, int b) { return logits[a] > logits[b]; });
+    const float mx = logits[idx[0]] / cfg.temperature;
+    std::vector<double> p(k);
+    double sum = 0;
+    for (int i = 0; i < k; i++) {
+        const float l = logits[idx[i]];
+        p[i] = std::isinf(l) && l < 0 ? 0.0 : std::exp(l / cfg.temperature - mx);
+        sum += p[i];
+    }
+    double u = std::uniform_real_distribution<double>(0.0, sum)(rng);
+    for (int i = 0; i < k; i++) {
+        if ((u -= p[i]) <= 0) return idx[i];
+    }
+    return idx[k - 1];
+}
+
+std::vector<double> softmax_t(const std::vector<float>& logits, float T) {
+    std::vector<double> p(logits.size());
+    double mx = -1e300, sum = 0;
+    for (float l : logits) if (!std::isinf(l)) mx = std::max(mx, (double)l / T);
+    for (size_t i = 0; i < logits.size(); i++) {
+        p[i] = std::isinf(logits[i]) ? 0.0 : std::exp(logits[i] / T - mx);
+        sum += p[i];
+    }
+    for (auto& v : p) v /= sum;
+    return p;
+}
+
+TtsHost::TtsHost(const std::string& path, ThreadPool* pool, Prec prec)
+    : f_(std::make_unique<SafeTensorFile>(path)), pool_(pool) {
+    const SafeTensorFile& f = *f_;
+    talker_emb_ = f.bf16("talker.model.codec_embedding.weight");
+    text_emb_ = reinterpret_cast<const uint16_t*>(f.info("talker.model.text_embedding.weight").data);
+    {
+        auto b1 = f.f32("talker.text_projection.linear_fc1.bias"), b2 = f.f32("talker.text_projection.linear_fc2.bias");
+        pack_linear_bf16(text_fc1_, f.bf16("talker.text_projection.linear_fc1.weight").data(), kTalkerD, kTalkerD, b1.data(), prec);
+        pack_linear_bf16(text_fc2_, f.bf16("talker.text_projection.linear_fc2.weight").data(), kTalkerD, kTalkerD, b2.data(), prec);
+    }
+    pack_linear_bf16(codec_head_, f.bf16("talker.codec_head.weight").data(), kTalkerD, kTalkerV, nullptr, prec);
+    auto pb = f.f32("talker.code_predictor.small_to_mtp_projection.bias");
+    pack_linear_bf16(proj_, f.bf16("talker.code_predictor.small_to_mtp_projection.weight").data(), kTalkerD, kCpD, pb.data(), prec);
+    cp_emb_.resize(15);
+    for (int k = 0; k < 15; k++) {
+        cp_emb_[k] = f.bf16("talker.code_predictor.model.codec_embedding." + std::to_string(k) + ".weight");
+        pack_linear_bf16(lm_head_[k], f.bf16("talker.code_predictor.lm_head." + std::to_string(k) + ".weight").data(),
+                         kCpD, kCodeV, nullptr, prec);
+    }
+}
+
+void TtsHost::talker_logits(const float* h, std::vector<float>& out) {
+    out.resize(kTalkerV);
+    gemm(codec_head_, gi_.prepare(codec_head_, h, kTalkerD, nullptr), kTalkerD, 1, 1, out.data(), kTalkerV, false, pool_);
+}
+
+void TtsHost::project(const float* v, float* out) {
+    gemm(proj_, gi_.prepare(proj_, v, kTalkerD, nullptr), kTalkerD, 1, 1, out, kCpD, false, pool_);
+}
+
+void TtsHost::cp_logits(int k, const float* h, std::vector<float>& out) {
+    out.resize(kCodeV);
+    gemm(lm_head_[k], gi_.prepare(lm_head_[k], h, kCpD, nullptr), kCpD, 1, 1, out.data(), kCodeV, false, pool_);
+}
+
+void TtsHost::text_embed(int token, float* out) {
+    std::vector<float> x(kTalkerD), h(kTalkerD);
+    const uint16_t* r = text_emb_ + (size_t)token * kTalkerD;
+    for (int i = 0; i < kTalkerD; i++) x[i] = bf2f(r[i]);
+    gemm(text_fc1_, gi_.prepare(text_fc1_, x.data(), kTalkerD, nullptr), kTalkerD, 1, 1, h.data(), kTalkerD, false, pool_);
+    for (auto& v : h) v = v / (1.0f + std::exp(-v));   // silu
+    gemm(text_fc2_, gi_.prepare(text_fc2_, h.data(), kTalkerD, nullptr), kTalkerD, 1, 1, out, kTalkerD, false, pool_);
+}
+
+void TtsHost::talker_embed(int code, float* out) const {
+    const uint16_t* r = &talker_emb_[(size_t)code * kTalkerD];
+    for (int i = 0; i < kTalkerD; i++) out[i] = bf2f(r[i]);
+}
+
+void TtsHost::cp_embed(int k, int code, float* out) const {
+    const uint16_t* r = &cp_emb_[k][(size_t)code * kTalkerD];
+    for (int i = 0; i < kTalkerD; i++) out[i] = bf2f(r[i]);
+}
+
+}  // namespace qwen3_tts
