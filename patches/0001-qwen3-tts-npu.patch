diff --git a/src/include/qwen3_tts/tts_gemm.hpp b/src/include/qwen3_tts/tts_gemm.hpp
new file mode 100644
index 00000000..9ba45b62
--- /dev/null
+++ b/src/include/qwen3_tts/tts_gemm.hpp
@@ -0,0 +1,53 @@
+#pragma once
+// Multi-tap GEMM for convolutions and linears, AVX-512 (BF16 dot products or FP32 FMA).
+//
+//   Y[m][n] = (accumulate ? Y[m][n] : 0) + bias[n]
+//           + sum_{tap, k} X[(m + tap*dil) * ldx + k] * W[tap][k][n]
+//
+// X is time-major and starts at the oldest history row a causal conv needs, so a
+// k-tap conv with dilation d reads rows m .. m + (k-1)*d for output row m. A linear
+// layer is the 1-tap case.
+#include <cstdint>
+#include <functional>
+#include <vector>
+
+#include "qwen3_tts/tts_common.hpp"
+
+namespace qwen3_tts {
+
+/// bf16:  bf16 weights x bf16 activations (vdpbf16ps), fp32 accumulate
+/// f32:   fp32 weights x fp32 activations
+/// bf16w: bf16 weights widened exactly to fp32 x fp32 activations -- what an fp32
+///        PyTorch model computes from a bf16 checkpoint
+enum class Prec { bf16, f32, bf16w };
+
+struct PackedW {
+    int K = 0, N = 0, taps = 1, nblocks = 0;
+    Prec prec = Prec::bf16;
+    std::vector<uint16_t> wb;   // bf16: [nb][tap][K/2][32][2]; bf16w: [nb][tap][K][32]
+    std::vector<float> wf;      // f32:  [nb][tap][K][32]
+    std::vector<float> bias;    // [nblocks*32], zero padded
+    bool has_bias = false;
+};
+
+/// \brief pack W given as w(tap, k, n)
+void pack_weights(PackedW& P, int K, int N, int taps, Prec prec,
+                  const std::function<float(int, int, int)>& w, const float* bias);
+
+/// \brief pack a Linear weight stored [N][K] (row-major, out x in)
+void pack_linear(PackedW& P, const float* w_nk, int K, int N, Prec prec, const float* bias);
+void pack_linear_bf16(PackedW& P, const uint16_t* w_nk, int K, int N, const float* bias,
+                      Prec prec = Prec::bf16);
+
+/// \brief run the GEMM; X is bf16 (uint16_t) when P.prec == bf16, else float
+void gemm(const PackedW& P, const void* X, int ldx, int M, int dil, float* Y, int ldy,
+          bool accumulate, ThreadPool* pool);
+
+/// \brief activations for a GEMM in the precision the weights want
+/// \note bf16: converts rows [0, rows) of src into a bf16 scratch buffer
+struct GemmInput {
+    std::vector<uint16_t> b;
+    const void* prepare(const PackedW& P, const float* src, size_t n_elems, ThreadPool* pool);
+};
+
+}  // namespace qwen3_tts
