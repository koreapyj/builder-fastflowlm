diff --git a/src/include/qwen3_tts/tts_text.hpp b/src/include/qwen3_tts/tts_text.hpp
new file mode 100644
index 00000000..ccb96565
--- /dev/null
+++ b/src/include/qwen3_tts/tts_text.hpp
@@ -0,0 +1,81 @@
+#pragma once
+// Text side of Qwen3-TTS serving: incremental normalization and segmentation of text that
+// may arrive in pieces (LLM output).
+//
+// Normalization: markdown symbols and list bullets are dropped, whitespace runs collapse
+// to one space, and a space between two CJK (kana / ideograph) characters becomes 。
+// (LLMs sometimes separate Japanese sentences with spaces only).
+// Segmentation: segments end only at sentence ends (。！？…!? and ASCII . ! ? followed by
+// whitespace, or a newline), never at commas. Sentences are merged until a segment has at
+// least min_tokens TTS tokens; the last segment of a text may be shorter. A segment that
+// grows past max_tokens without a sentence end is cut after its last comma (the only
+// exception), so the talker's position range is never exceeded.
+//
+// Decisions only depend on the text received so far plus a bounded lookahead, so closed
+// segments never change when more text arrives.
+#include <condition_variable>
+#include <cstdint>
+#include <functional>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace qwen3_tts {
+
+struct Segment {
+    std::string text;
+    std::vector<int> tokens;   // closed: all tokens; open: all but the last (BPE may still merge it)
+    int total_tokens = 0;      // token count of the text so far
+    bool closed = false;
+    int pause_ms = 0;          // silence after this segment (closed, not last)
+};
+
+class Segmenter {
+public:
+    using Encode = std::function<std::vector<int>(const std::string&)>;
+    Segmenter(Encode encode, int min_tokens = 17, int max_tokens = 200);
+    void push(const std::string& utf8);
+    void finish();
+    bool finished() const { return finished_; }
+    /// \brief current segments; all but possibly the last are closed
+    const std::vector<Segment>& segments() const { return segs_; }
+
+    /// \brief normalized text and confirmed sentence ends (for tests)
+    static std::string normalize(const std::string& raw, bool final, std::vector<size_t>* ends);
+
+private:
+    void update();
+    Encode encode_;
+    int min_tokens_, max_tokens_;
+    std::string raw_;
+    bool finished_ = false;
+    std::vector<Segment> segs_;
+};
+
+/// \brief thread-safe text input of one utterance: the network side pushes, the generator
+///        reads segments and waits for changes
+class TextInput {
+public:
+    explicit TextInput(Segmenter::Encode encode);
+    void push(const std::string& utf8);
+    void finish();
+    void cancel();
+    bool cancelled() const;
+    /// \brief copy of segment k if it exists; returns false if not (yet)
+    bool segment(size_t k, Segment& out) const;
+    /// \brief all text has arrived and segment k does not exist
+    bool past_end(size_t k) const;
+    /// \brief changes on every push / finish / cancel
+    uint64_t version() const;
+    /// \brief wait until version() != seen or the timeout passes
+    void wait(uint64_t seen, int timeout_ms);
+
+private:
+    mutable std::mutex mu_;
+    std::condition_variable cv_;
+    Segmenter seg_;
+    uint64_t version_ = 0;
+    bool cancelled_ = false;
+};
+
+}  // namespace qwen3_tts
diff --git a/src/include/qwen3_tts/xrt_capture.hpp b/src/include/qwen3_tts/xrt_capture.hpp
new file mode 100644
index 00000000..c176e410
--- /dev/null
+++ b/src/include/qwen3_tts/xrt_capture.hpp
@@ -0,0 +1,68 @@
+#pragma once
+// Load-time capture of what a stock qwen3_npu engine builds, for FastDecode.
+//
+// The engine .so calls XRT (and SafeTensors::load_weights) through its PLT. flm defines
+// the same mangled symbols and exports them (common/qwen3_tts/interpose.dynlist), so those
+// calls land in xrt_interpose.cpp, which forwards every call to the real function. While a
+// capture scope is open (only during NpuQwen3 construction) it also records the engine's
+// kernels, runs, buffer arguments, instruction ELFs and RoPE syncs. Outside a scope the
+// wrappers only forward, so other models in the process are unaffected.
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace qwen3_tts::cap {
+
+/// \brief open / close the capture scope; close() frees every recorded object
+void open();
+void close();
+bool is_open();
+
+// ---- weights: SafeTensors::load_weights results seen while the scope is open ----
+/// \brief host buffer (bytes*) the engine loaded model.embed_tokens.weight into
+void* embed_buffer();
+/// \brief model.norm.weight as fp32
+const std::vector<float>& final_norm();
+
+// ---- build capture: what the engine wires into one runlist ----
+struct Run {
+    const void* kernel = nullptr;                 // kernel handle
+    std::vector<std::pair<int, uint32_t>> scalars;
+    std::vector<int> bo_idx;                      // bo argument indices
+};
+struct Build {
+    std::vector<const void*> kernels;             // kernel handles in creation order
+    std::vector<std::string> names;
+    std::vector<std::vector<uint8_t>> elfs;       // instruction ELF per kernel
+    std::vector<Run> runs;                        // in runlist order
+};
+/// \brief record kernels/runs/args/runlist adds until build_end()
+void build_begin();
+const Build& build_end();
+/// \brief opaque xrt::hw_context* of the captured kernels
+const void* build_ctx();
+/// \brief opaque xrt::bo* of bo argument idx of the captured run at runlist position pos
+const void* build_bo(size_t pos, int idx);
+
+// ---- harvest: instruction ELFs and to-device sync heads of one set_context_length() ----
+void harvest_begin(size_t sync_bytes);
+void harvest_end(std::vector<std::vector<uint8_t>>& elfs, std::vector<std::vector<uint8_t>>& syncs);
+
+/// \brief opaque xrt::bo* of bo argument idx of the output-head run (the run whose
+///        instruction ELF is ~420 KB); its arg5 holds the pre-norm hidden state
+const void* head_bo(int idx);
+
+// ---- called by xrt_interpose.cpp (scope open only) ----
+void on_load_weights(const std::string& name, void* bytes_obj, const uint8_t* data, size_t size);
+void on_elf(const void* elf, const void* data, size_t size);
+void on_module(const void* module, const void* elf);
+void on_kernel(const void* kernel, const void* ctx_obj, const void* module, const std::string& name);
+void on_run(const void* run, const void* kernel);
+void on_arg_bo(const void* run, int idx, const void* bo_obj);
+void on_arg_scalar(const void* run, int idx, const void* val, size_t bytes);
+void on_runlist_add(const void* run);
+void on_sync(const void* bo_obj, int dir, size_t size, size_t off);
+
+}  // namespace qwen3_tts::cap
