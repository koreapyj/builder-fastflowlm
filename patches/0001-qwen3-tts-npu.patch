+void to_bf16(const float* src, uint16_t* dst, size_t n) {
+    size_t i = 0;
+    for (; i + 32 <= n; i += 32) {
+        __m512bh v = _mm512_cvtne2ps_pbh(_mm512_loadu_ps(src + i + 16), _mm512_loadu_ps(src + i));
+        _mm512_storeu_si512(dst + i, (__m512i)v);
+    }
+    for (; i < n; i++) dst[i] = f2bf(src[i]);
+}
+
+SafeTensorFile::SafeTensorFile(const std::string& path) {
+    fd_ = open(path.c_str(), O_RDONLY);
+    if (fd_ < 0) throw std::runtime_error("cannot open " + path);
+    struct stat st;
+    fstat(fd_, &st);
+    size_ = st.st_size;
+    map_ = (uint8_t*)mmap(nullptr, size_, PROT_READ, MAP_PRIVATE, fd_, 0);
+    if (map_ == MAP_FAILED) throw std::runtime_error("mmap failed " + path);
+    uint64_t hlen;
+    std::memcpy(&hlen, map_, 8);
+    auto h = nlohmann::json::parse(std::string((const char*)map_ + 8, hlen));
+    const uint8_t* base = map_ + 8 + hlen;
+    for (auto& [k, v] : h.items()) {
+        if (k == "__metadata__") continue;
+        Info inf;
+        inf.dtype = v["dtype"];
+        for (auto& d : v["shape"]) inf.shape.push_back(d.get<int64_t>());
+        size_t a = v["data_offsets"][0], b = v["data_offsets"][1];
+        inf.data = base + a;
+        inf.bytes = b - a;
+        index_[k] = inf;
+    }
+}
+
+SafeTensorFile::~SafeTensorFile() {
+    if (map_) munmap(map_, size_);
+    if (fd_ >= 0) close(fd_);
+}
+
+const SafeTensorFile::Info& SafeTensorFile::info(const std::string& name) const {
+    auto it = index_.find(name);
+    if (it == index_.end()) throw std::runtime_error("tensor not found: " + name);
+    return it->second;
+}
+
+std::vector<float> SafeTensorFile::f32(const std::string& name) const {
+    const Info& i = info(name);
+    std::vector<float> v;
+    if (i.dtype == "F32") {
+        v.resize(i.bytes / 4);
+        std::memcpy(v.data(), i.data, i.bytes);
+    } else if (i.dtype == "BF16") {
+        v.resize(i.bytes / 2);
+        const uint16_t* p = (const uint16_t*)i.data;
+        for (size_t k = 0; k < v.size(); k++) v[k] = bf2f(p[k]);
+    } else {
+        throw std::runtime_error("unsupported dtype " + i.dtype + " for " + name);
+    }
+    return v;
+}
+
+std::vector<uint16_t> SafeTensorFile::bf16(const std::string& name) const {
+    const Info& i = info(name);
+    std::vector<uint16_t> v;
+    if (i.dtype == "BF16") {
+        v.resize(i.bytes / 2);
+        std::memcpy(v.data(), i.data, i.bytes);
+    } else {
+        auto f = f32(name);
+        v.resize(f.size());
+        to_bf16(f.data(), v.data(), f.size());
+    }
+    return v;
+}
+
+void pin_this_thread(int cpu) {
+    cpu_set_t set;
+    CPU_ZERO(&set);
+    CPU_SET(cpu, &set);
+    pthread_setaffinity_np(pthread_self(), sizeof set, &set);
+}
+
+std::vector<int> parse_cpus(const std::string& s) {
+    std::vector<int> out;
+    std::stringstream ss(s);
+    std::string part;
+    while (std::getline(ss, part, ',')) {
+        auto dash = part.find('-');
+        if (dash == std::string::npos) {
+            out.push_back(std::stoi(part));
+        } else {
+            int a = std::stoi(part.substr(0, dash)), b = std::stoi(part.substr(dash + 1));
+            for (int c = a; c <= b; c++) out.push_back(c);
+        }
+    }
+    return out;
+}
+
+ThreadPool::ThreadPool(std::vector<int> cpus) : cpus_(std::move(cpus)) {
+    for (int i = 1; i < (int)cpus_.size(); i++) threads_.emplace_back(&ThreadPool::worker, this, i);
+}
+
+ThreadPool::~ThreadPool() {
+    {
+        std::lock_guard<std::mutex> l(mu_);
+        stop_ = true;
+        generation_++;
+    }
+    cv_start_.notify_all();
+    for (auto& t : threads_) t.join();
+}
+
+void ThreadPool::pin_caller() { pin_this_thread(cpus_[0]); }
+
+// Workers spin briefly on the generation counter before sleeping, so back-to-back
+// small runs (the CPU predictor issues hundreds per frame) avoid futex round trips.
+void ThreadPool::worker(int idx) {
+    pin_this_thread(cpus_[idx]);
+    int seen = 0;
+    for (;;) {
+        int g = generation_.load(std::memory_order_acquire);
+        for (int spin = 0; g == seen && spin < 4000; spin++) {
+            _mm_pause();
+            g = generation_.load(std::memory_order_acquire);
+        }
+        if (g == seen) {
+            std::unique_lock<std::mutex> l(mu_);
+            cv_start_.wait(l, [&] { return generation_.load() != seen; });
+            g = generation_.load();
+        }
+        seen = g;
+        if (stop_) return;
+        const std::function<void(int)>* fn = fn_;
+        const int n = n_;
+        for (int t; (t = next_.fetch_add(1)) < n;) (*fn)(t);
+        busy_.fetch_sub(1, std::memory_order_release);
+    }
+}
+
+void ThreadPool::run(int n, const std::function<void(int)>& fn) {
+    if (n <= 0) return;
+    if (threads_.empty() || n == 1) {
+        for (int t = 0; t < n; t++) fn(t);
+        return;
+    }
+    fn_ = &fn;
+    n_ = n;
+    next_ = 0;
+    busy_ = (int)threads_.size();
+    {
+        std::lock_guard<std::mutex> l(mu_);
+        generation_.fetch_add(1, std::memory_order_release);
+    }
+    cv_start_.notify_all();
+    for (int t; (t = next_.fetch_add(1)) < n;) fn(t);
+    while (busy_.load(std::memory_order_acquire) != 0) _mm_pause();
+}
+
+template <class T> std::vector<T> read_file(const std::string& path) {
+    std::ifstream f(path, std::ios::binary | std::ios::ate);
+    if (!f) throw std::runtime_error("cannot read " + path);
+    std::vector<T> v(f.tellg() / sizeof(T));
+    f.seekg(0);
+    f.read(reinterpret_cast<char*>(v.data()), v.size() * sizeof(T));
+    return v;
+}
+template std::vector<float> read_file<float>(const std::string&);
+template std::vector<int32_t> read_file<int32_t>(const std::string&);
+
+void write_wav16(const std::string& path, const std::vector<float>& pcm, int sr) {
+    std::ofstream f(path, std::ios::binary);
+    const uint32_t data = (uint32_t)pcm.size() * 2;
+    auto u32 = [&](uint32_t v) { f.write((const char*)&v, 4); };
+    auto u16 = [&](uint16_t v) { f.write((const char*)&v, 2); };
+    f.write("RIFF", 4); u32(36 + data); f.write("WAVEfmt ", 8); u32(16); u16(1); u16(1);
+    u32(sr); u32(sr * 2); u16(2); u16(16); f.write("data", 4); u32(data);
+    for (float s : pcm) {
+        const int16_t v = (int16_t)std::lrint(std::clamp(s, -1.0f, 1.0f) * 32767.0f);
+        f.write((const char*)&v, 2);
+    }
+}
+
