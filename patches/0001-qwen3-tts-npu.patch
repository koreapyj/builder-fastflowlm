+#include "qwen3_tts/tts_text.hpp"
+
+#include <cctype>
+#include <chrono>
+
+namespace qwen3_tts {
+
+namespace {
+
+constexpr int kPauseSentenceMs = 350, kPauseCommaMs = 150;
+
+/// \brief decode one UTF-8 code point at s[i]; advances i (invalid bytes pass as U+FFFD)
+uint32_t next_cp(const std::string& s, size_t& i) {
+    const unsigned char c = (unsigned char)s[i];
+    int n = c < 0x80 ? 1 : (c >> 5) == 6 ? 2 : (c >> 4) == 14 ? 3 : (c >> 3) == 30 ? 4 : 0;
+    if (n == 0 || i + n > s.size()) { i++; return 0xFFFD; }
+    uint32_t cp = n == 1 ? c : n == 2 ? (c & 0x1F) : n == 3 ? (c & 0x0F) : (c & 0x07);
+    for (int k = 1; k < n; k++) cp = (cp << 6) | ((unsigned char)s[i + k] & 0x3F);
+    i += n;
+    return cp;
+}
+
+/// \brief a code point needs its whole UTF-8 sequence before it can be decoded
+bool complete_at(const std::string& s, size_t i) {
+    const unsigned char c = (unsigned char)s[i];
+    const size_t n = c < 0x80 ? 1 : (c >> 5) == 6 ? 2 : (c >> 4) == 14 ? 3 : (c >> 3) == 30 ? 4 : 1;
+    return i + n <= s.size();
+}
+
+void put_cp(std::string& out, uint32_t cp) {
+    if (cp < 0x80) out += (char)cp;
+    else if (cp < 0x800) { out += (char)(0xC0 | (cp >> 6)); out += (char)(0x80 | (cp & 0x3F)); }
+    else if (cp < 0x10000) {
+        out += (char)(0xE0 | (cp >> 12)); out += (char)(0x80 | ((cp >> 6) & 0x3F)); out += (char)(0x80 | (cp & 0x3F));
+    } else {
+        out += (char)(0xF0 | (cp >> 18)); out += (char)(0x80 | ((cp >> 12) & 0x3F));
+        out += (char)(0x80 | ((cp >> 6) & 0x3F)); out += (char)(0x80 | (cp & 0x3F));
+    }
+}
+
+/// \brief Japanese / Chinese script (not Hangul: Korean separates words with spaces)
+bool is_cjk(uint32_t c) {
+    return (c >= 0x3040 && c <= 0x30FF) || (c >= 0x3400 && c <= 0x4DBF) || (c >= 0x4E00 && c <= 0x9FFF) ||
+           (c >= 0xF900 && c <= 0xFAFF) || (c >= 0xFF66 && c <= 0xFF9F) || c == 0x3005;
+}
+bool is_space(uint32_t c) { return c == ' ' || c == '\t' || c == '\r' || c == 0x3000 || c == 0xA0; }
+bool is_cjk_term(uint32_t c) { return c == 0x3002 || c == 0xFF01 || c == 0xFF1F || c == 0x2026 || c == 0xFF0E; }
+bool is_ascii_term(uint32_t c) { return c == '.' || c == '!' || c == '?'; }
+bool is_closer(uint32_t c) {
+    return c == 0x300D || c == 0x300F || c == 0xFF09 || c == ')' || c == ']' || c == 0xFF3D || c == '"' ||
+           c == '\'' || c == 0x201D || c == 0x2019 || c == 0x3011;
+}
+/// \brief fullwidth / CJK punctuation, after which a space is dropped
+bool is_cjk_punct(uint32_t c) { return (c >= 0x3000 && c <= 0x303F) || (c >= 0xFF00 && c <= 0xFF65) || c == 0x2026; }
+bool is_markdown(uint32_t c) { return c == '*' || c == '#' || c == '`' || c == '|' || c == '~' || c == '_'; }
+bool is_comma(uint32_t c) { return c == 0x3001 || c == 0xFF0C || c == ','; }
+
+/// \brief last code point of a UTF-8 string (0 if empty)
+uint32_t last_cp(const std::string& s) {
+    if (s.empty()) return 0;
+    size_t i = s.size() - 1;
+    while (i > 0 && ((unsigned char)s[i] & 0xC0) == 0x80) i--;
+    return next_cp(s, i);
+}
+
+/// \brief "Dr." / "e.g." style abbreviation or a single initial before the period
+bool abbreviation_before(const std::string& out) {
+    size_t i = out.size() - 1;   // out ends with '.'
+    size_t j = i;
+    while (j > 0 && (std::isalpha((unsigned char)out[j - 1]) || out[j - 1] == '.')) j--;
+    const std::string w = out.substr(j, i - j);
+    if (w.size() == 1 && std::isupper((unsigned char)w[0])) return true;   // initial "J."
+    static const char* abbr[] = {"Mr", "Mrs", "Ms", "Dr", "St", "vs", "etc", "e.g", "i.e", "Jr", "Sr", "No"};
+    for (const char* a : abbr) if (w == a) return true;
+    return false;
+}
+
+std::string trim(const std::string& s) {
+    size_t a = 0, b = s.size();
+    while (a < b && (s[a] == ' ' || s[a] == '\n')) a++;
+    while (b > a && (s[b - 1] == ' ' || s[b - 1] == '\n')) b--;
+    return s.substr(a, b - a);
+}
+
+}  // namespace
+
+std::string Segmenter::normalize(const std::string& raw, bool final, std::vector<size_t>* ends) {
+    std::string out;
+    size_t i = 0;
+    bool line_start = true;
+    auto mark_end = [&] {
+        if (ends && !out.empty() && (ends->empty() || ends->back() != out.size())) ends->push_back(out.size());
+    };
+    while (i < raw.size()) {
+        if (!complete_at(raw, i)) break;   // partial UTF-8 sequence: wait for the rest
+        size_t j = i;
+        const uint32_t c = next_cp(raw, j);
+        if (c == '\n') {
+            mark_end();
+            line_start = true;
+            i = j;
+            continue;
+        }
+        if (line_start) {
+            // list bullets at the start of a line: "- ", "* ", "・", "•", "1. "
+            if (is_space(c)) { i = j; continue; }
+            size_t k = i;
+            while (k < raw.size() && std::isdigit((unsigned char)raw[k])) k++;
+            const bool numbered = k > i && k + 1 < raw.size() && (raw[k] == '.' || raw[k] == ')') && raw[k + 1] == ' ';
+            if (numbered) { i = k + 2; line_start = false; continue; }
+            if ((c == '-' || c == '*' || c == '+') && j < raw.size() && raw[j] == ' ') { i = j + 1; line_start = false; continue; }
+            if (c == 0x30FB || c == 0x2022) { i = j; line_start = false; continue; }
+            if ((c == '-' || c == '*' || c == '+' || std::isdigit((unsigned char)c)) && j >= raw.size() && !final) break;
+            if (c == '>') { i = j; continue; }
+            line_start = false;
+        }
+        if (is_markdown(c)) { i = j; continue; }
+        if (is_space(c)) {
+            // whitespace run: needs the next non-space character
+            size_t k = j;
+            while (k < raw.size() && complete_at(raw, k)) {
+                size_t m = k;
+                if (!is_space(next_cp(raw, m))) break;
+                k = m;
+            }
+            if (k >= raw.size() || !complete_at(raw, k)) {
+                if (!final) break;
+                i = raw.size();
+                continue;
+            }
+            size_t m = k;
+            const uint32_t nx = next_cp(raw, m);
+            const uint32_t pv = last_cp(out);
+            if (nx == '\n') { i = k; continue; }
+            if (is_cjk(pv) && is_cjk(nx)) {
+                put_cp(out, 0x3002);
+                mark_end();
+            } else if (!out.empty() && out.back() != ' ' && !is_cjk_punct(pv)) {
+                out += ' ';
+            }
+            i = k;
+            continue;
+        }
+        if (is_cjk_term(c) || is_ascii_term(c)) {
+            // a terminator run plus closing quotes / brackets stays with its sentence
+            std::string run;
+            put_cp(run, c);
+            size_t k = j;
+            bool more = false;
+            while (k < raw.size()) {
+                if (!complete_at(raw, k)) { more = true; break; }
+                size_t m = k;
+                const uint32_t d = next_cp(raw, m);
+                if (!(is_cjk_term(d) || is_ascii_term(d) || is_closer(d))) break;
+                put_cp(run, d);
+                k = m;
+            }
+            if ((k >= raw.size() || more) && !final) break;   // the run may continue
+            bool end = true;
+            if (is_ascii_term(c)) {
+                // ASCII: only before whitespace / end of text, and not "Dr." or "3.14"
+                uint32_t nx = 0;
+                if (k < raw.size()) { size_t m = k; nx = next_cp(raw, m); }
+                end = k >= raw.size() || is_space(nx) || nx == '\n' || is_cjk(nx);
+                if (end && c == '.' && run == ".") {
+                    out += '.';
+                    end = !abbreviation_before(out);
+                    out.pop_back();
+                }
+            }
+            out += run;
+            if (end) mark_end();
+            i = k;
+            continue;
+        }
+        put_cp(out, c);
+        i = j;
+    }
+    if (final) mark_end();
+    return out;
+}
+
+Segmenter::Segmenter(Encode encode, int min_tokens, int max_tokens)
+    : encode_(std::move(encode)), min_tokens_(min_tokens), max_tokens_(max_tokens) {}
+
+void Segmenter::push(const std::string& s) {
+    if (finished_) return;
+    raw_ += s;
+    update();
+}
+
+void Segmenter::finish() {
+    if (finished_) return;
+    finished_ = true;
+    update();
+}
+
+void Segmenter::update() {
+    std::vector<size_t> ends;
+    const std::string norm = normalize(raw_, finished_, &ends);
+    // group sentences into segments; closed segments are recomputed identically
+    std::vector<Segment> segs;
+    size_t start = 0;
+    auto close = [&](size_t end, int pause) {
+        Segment g;
+        g.text = trim(norm.substr(start, end - start));
+        start = end;
+        if (g.text.empty()) return;
+        g.tokens = encode_(g.text);
+        g.total_tokens = (int)g.tokens.size();
+        g.closed = true;
+        g.pause_ms = pause;
+        segs.push_back(std::move(g));
+    };
+    // a stretch longer than max_tokens without a sentence end: cut after the last comma
+    // before the limit (a hard cut if there is none)
+    auto split_long = [&](size_t end) {
+        for (;;) {
+            const std::string acc = trim(norm.substr(start, end - start));
+            if (acc.empty() || (int)encode_(acc).size() <= max_tokens_) return;
+            size_t cut = std::string::npos, i = start;
+            while (i < end) {
+                size_t j = i;
+                const uint32_t c = next_cp(norm, j);
+                if ((int)encode_(trim(norm.substr(start, j - start))).size() > max_tokens_) break;
+                if (is_comma(c)) cut = j;
+                i = j;
+            }
+            if (cut == std::string::npos || cut <= start) cut = i;
+            close(cut, kPauseCommaMs);
+        }
+    };
+    for (size_t e : ends) {
+        split_long(e);
+        const std::string acc = trim(norm.substr(start, e - start));
+        if (acc.empty()) { start = e; continue; }
+        const int n = (int)encode_(acc).size();
+        if (n >= min_tokens_) {
+            close(e, kPauseSentenceMs);
+        } else if (finished_ && e == norm.size()) {
+            close(e, kPauseSentenceMs);
+        }
+    }
+    split_long(norm.size());
+    const std::string tail = trim(norm.substr(start));
+    if (!tail.empty()) {
+        Segment g;
+        g.text = tail;
+        g.tokens = encode_(tail);
+        g.total_tokens = (int)g.tokens.size();
+        if (finished_) {
+            g.closed = true;
+            g.pause_ms = kPauseSentenceMs;
+        } else if (!g.tokens.empty()) {
+            g.tokens.pop_back();   // may still merge with what comes next
+        }
+        segs.push_back(std::move(g));
+    }
+    if (!segs.empty()) segs.back().pause_ms = finished_ && segs.back().closed ? 0 : segs.back().pause_ms;
+    // keep previously handed-out closed segments stable
+    for (size_t k = 0; k < segs_.size() && k < segs.size(); k++)
+        if (segs_[k].closed) segs[k] = segs_[k];
+    segs_ = std::move(segs);
+}
+
+TextInput::TextInput(Segmenter::Encode encode) : seg_(std::move(encode)) {}
+
+void TextInput::push(const std::string& s) {
+    { std::lock_guard<std::mutex> l(mu_); seg_.push(s); version_++; }
+    cv_.notify_all();
+}
+
+void TextInput::finish() {
+    { std::lock_guard<std::mutex> l(mu_); seg_.finish(); version_++; }
+    cv_.notify_all();
+}
+
+void TextInput::cancel() {
+    { std::lock_guard<std::mutex> l(mu_); cancelled_ = true; version_++; }
+    cv_.notify_all();
+}
+
+bool TextInput::cancelled() const {
+    std::lock_guard<std::mutex> l(mu_);
+    return cancelled_;
+}
+
+bool TextInput::segment(size_t k, Segment& out) const {
+    std::lock_guard<std::mutex> l(mu_);
+    if (k >= seg_.segments().size()) return false;
+    out = seg_.segments()[k];
+    return true;
+}
+
+bool TextInput::past_end(size_t k) const {
+    std::lock_guard<std::mutex> l(mu_);
+    return seg_.finished() && k >= seg_.segments().size();
+}
+
+uint64_t TextInput::version() const {
+    std::lock_guard<std::mutex> l(mu_);
+    return version_;
+}
+
+void TextInput::wait(uint64_t seen, int timeout_ms) {
+    std::unique_lock<std::mutex> l(mu_);
+    cv_.wait_for(l, std::chrono::milliseconds(timeout_ms), [&] { return version_ != seen; });
+}
+
+}  // namespace qwen3_tts
