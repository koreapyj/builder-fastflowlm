index 00000000..2d521f97
--- /dev/null
+++ b/src/common/qwen3_tts/npu_qwen3.cpp
@@ -0,0 +1,64 @@
+#include "qwen3_tts/npu_qwen3.hpp"
+
+#include <cmath>
+#include <stdexcept>
+
+#include "lm_config.hpp"
+#include "models/qwen3/flm/aie2p/qwen3_npu.hpp"
+#include "npu_utils/npu_utils.hpp"
+#include "qwen3_tts/xrt_capture.hpp"
+#include "tensor_utils/q4_npu_eXpress.hpp"
+
+namespace qwen3_tts {
+
+namespace {
+/// \brief keeps the capture scope open for the lifetime of the object
+struct CaptureScope {
+    CaptureScope() { cap::open(); }
+    ~CaptureScope() { cap::close(); }
+};
+}  // namespace
+
+NpuQwen3::NpuQwen3(npu_xclbin_manager* npu, const std::string& model_dir, int max_len, int fast_len, bool cache_all) {
+    LM_Config config;
+    config.from_pretrained(model_dir);
+    D_ = config.get("hidden_size");
+    eps_ = config.get<float>("rms_norm_eps", 1e-6f);
+    CaptureScope scope;
+    eng_ = std::make_unique<qwen3_npu>(config, npu, max_len);
+    {
+        Q4NX q4nx(model_dir);
+        eng_->load_weights(q4nx);
+    }
+    norm_w_ = cap::final_norm();
+    if ((int)norm_w_.size() != D_) throw std::runtime_error("qwen3_tts: engine weight load was not intercepted");
+    fast_ = std::make_unique<FastDecode>(eng_.get(), D_, fast_len, cache_all);
+    eng_->clear_context();
+    h_.resize(D_);
+    in_.resize(D_);
+}
+
+NpuQwen3::~NpuQwen3() = default;
+
+void NpuQwen3::clear() {
+    pos_ = 0;
+    fast_->hint(0);   // the fast path owns positions; no engine rebuild
+}
+
+const float* NpuQwen3::norm_hidden(const uint16_t* raw) {
+    double ss = 0;
+    for (int i = 0; i < D_; i++) { h_[i] = bf2f(raw[i]); ss += (double)h_[i] * h_[i]; }
+    const float r = 1.0f / std::sqrt((float)(ss / D_) + eps_);
+    for (int i = 0; i < D_; i++) h_[i] = h_[i] * r * norm_w_[i];
+    return h_.data();
+}
+
+const float* NpuQwen3::step(const float* e) {
+    if (pos_ >= fast_->max_len()) throw std::runtime_error("qwen3_tts: position beyond the fast-decode range");
+    to_bf16(e, in_.data(), D_);
+    const uint16_t* h = fast_->step(pos_, in_.data());
+    pos_++;
+    return norm_hidden(h);
+}
+
+}  // namespace qwen3_tts
