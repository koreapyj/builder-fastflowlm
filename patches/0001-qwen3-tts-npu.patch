@@ -0,0 +1,272 @@
+#include "qwen3_tts/fast_decode.hpp"
+
+#include <chrono>
+#include <condition_variable>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <stdexcept>
+#include <thread>
+#include <vector>
+
+#include "xrt/xrt_bo.h"
+#include "xrt/xrt_hw_context.h"
+#include "xrt/xrt_kernel.h"
+#include "xrt/experimental/xrt_elf.h"
+#include "xrt/experimental/xrt_ext.h"
+#include "xrt/experimental/xrt_module.h"
+
+#include "lm_config.hpp"
+#include "models/qwen3/flm/aie2p/qwen3_npu.hpp"
+#include "qwen3_tts/xrt_capture.hpp"
+
+namespace qwen3_tts {
+
+namespace {
+using clk = std::chrono::steady_clock;
+double ms_since(clk::time_point a) { return std::chrono::duration<double, std::milli>(clk::now() - a).count(); }
+constexpr size_t kRopeBytes = 256;
+}  // namespace
+
+struct FastDecode::Impl {
+
+    int D = 0, Lmax = 0;
+    bool cache_all = false;
+    // recipe from one captured engine rebuild
+    xrt::hw_context ctx;
+    std::string ctrl_name, layer_name;
+    size_t ctrl_size = 0, layer_size = 0;
+    std::vector<std::pair<int, uint32_t>> ctrl_scalars;
+    struct LayerArgs { std::vector<std::pair<int, uint32_t>> scalars; std::vector<std::pair<int, xrt::bo>> bos; };
+    std::vector<LayerArgs> layers;
+    xrt::bo in_bo, out_bo;
+    std::vector<xrt::bo> rtp_bo;
+    // harvested per-L data
+    std::vector<std::vector<uint8_t>> ctrl_elf, layer_elf, rope;
+    // built runlists
+    struct Built {
+        xrt::elf ce, le;
+        xrt::module cm, lm;
+        xrt::ext::kernel ck, lk;
+        xrt::runlist rl;
+        Built(const xrt::hw_context& ctx, const std::vector<uint8_t>& c, const std::vector<uint8_t>& l,
+              const std::string& cn, const std::string& ln)
+            : ce(c.data(), c.size()), le(l.data(), l.size()), cm(ce), lm(le),
+              ck(ctx, cm, cn), lk(ctx, lm, ln), rl(ctx) {}
+    };
+    std::map<int, std::unique_ptr<Built>> built;
+    std::mutex mu;
+    std::condition_variable cv;
+    int want = -1;           // builder: build [want, want + ahead)
+    bool stop = false;
+    std::thread builder;
+    static constexpr int kAhead = 3;
+
+    std::unique_ptr<Built> build(int L) {
+        auto b = std::make_unique<Built>(ctx, ctrl_elf[L], layer_elf[L], ctrl_name, layer_name);
+        xrt::run r(b->ck);
+        for (auto& [i, v] : ctrl_scalars) r.set_arg(i, v);
+        b->rl.add(std::move(r));
+        for (auto& la : layers) {
+            xrt::run lr(b->lk);
+            for (auto& [i, v] : la.scalars) lr.set_arg(i, v);
+            for (auto& [i, bo] : la.bos) lr.set_arg(i, bo);
+            b->rl.add(std::move(lr));
+        }
+        return b;
+    }
+
+    void builder_loop() {
+        for (;;) {
+            int L = -1;
+            {
+                std::unique_lock<std::mutex> l(mu);
+                cv.wait(l, [&] {
+                    if (stop) return true;
+                    for (int k = want; want >= 0 && k < std::min(Lmax, want + kAhead); k++)
+                        if (!built.count(k)) return true;
+                    return false;
+                });
+                if (stop) return;
+                for (int k = want; k < std::min(Lmax, want + kAhead); k++)
+                    if (!built.count(k)) { L = k; break; }
+                // drop runlists that can no longer be used (positions only grow, except reset)
+                for (auto it = built.begin(); it != built.end();)
+                    it = (it->first < want - 1 || it->first >= want + 2 * kAhead) ? built.erase(it) : std::next(it);
+            }
+            auto b = build(L);
+            {
+                std::lock_guard<std::mutex> l(mu);
+                built[L] = std::move(b);
+            }
+            cv.notify_all();
+        }
+    }
+};
+
+FastDecode::FastDecode(qwen3_npu* eng, int dim, int L_max, bool cache_all) : p_(std::make_unique<Impl>()) {
+    Impl& P = *p_;
+    P.D = dim;
+    P.Lmax = L_max;
+    P.cache_all = cache_all;
+    auto t0 = clk::now();
+    // 1. capture what the engine wires into one runlist
+    cap::build_begin();
+    eng->set_context_length(1);
+    const cap::Build& B = cap::build_end();
+    if (B.kernels.size() != 2 || B.runs.size() < 2) throw std::runtime_error("FastDecode: unexpected engine rebuild shape");
+    const int ki_ctrl = B.elfs[0].size() < B.elfs[1].size() ? 0 : 1, ki_layer = 1 - ki_ctrl;
+    P.ctx = *static_cast<const xrt::hw_context*>(cap::build_ctx());
+    P.ctrl_name = B.names[ki_ctrl];
+    P.layer_name = B.names[ki_layer];
+    for (size_t r = 0; r < B.runs.size(); r++) {
+        const cap::Run& run = B.runs[r];
+        if (run.kernel == B.kernels[ki_ctrl]) {
+            if (r != 0) throw std::runtime_error("FastDecode: control run not first");
+            P.ctrl_scalars = run.scalars;
+            continue;
+        }
+        Impl::LayerArgs la;
+        la.scalars = run.scalars;
+        for (int idx : run.bo_idx) la.bos.push_back({idx, *static_cast<const xrt::bo*>(cap::build_bo(r, idx))});
+        P.layers.push_back(std::move(la));
+    }
+    auto bo_at = [&](const Impl::LayerArgs& la, int idx) {
+        for (auto& [i, bo] : la.bos) if (i == idx) return bo;
+        throw std::runtime_error("FastDecode: missing bo arg " + std::to_string(idx));
+    };
+    P.in_bo = bo_at(P.layers[0], 3);
+    for (auto& la : P.layers) P.rtp_bo.push_back(bo_at(la, 6));
+    P.out_bo = *static_cast<const xrt::bo*>(cap::head_bo(5));
+    // 2. harvest streams and RoPE rows for every L
+    P.ctrl_elf.resize(L_max);
+    P.layer_elf.resize(L_max);
+    P.rope.resize(L_max);
+    std::vector<std::vector<uint8_t>> elfs, syncs;
+    for (int L = 0; L < L_max; L++) {
+        cap::harvest_begin(kRopeBytes);
+        eng->set_context_length(L);
+        cap::harvest_end(elfs, syncs);
+        if (elfs.size() != 2) throw std::runtime_error("FastDecode: harvest saw " + std::to_string(elfs.size()) + " ELFs");
+        const int c = elfs[0].size() < elfs[1].size() ? 0 : 1;
+        P.ctrl_elf[L] = std::move(elfs[c]);
+        P.layer_elf[L] = std::move(elfs[1 - c]);
+        // RTP syncs: one per layer, same RoPE row in each
+        if (syncs.size() != P.layers.size()) throw std::runtime_error("FastDecode: unexpected RTP sync count");
+        P.rope[L] = std::move(syncs[0]);
+    }
+    harvest_ms = ms_since(t0);
+    if (cache_all) {
+        for (int L = 0; L < L_max; L++) P.built[L] = P.build(L);
+    } else {
+        P.builder = std::thread([&P] { P.builder_loop(); });
+    }
+}
+
+FastDecode::~FastDecode() {
+    if (p_->builder.joinable()) {
+        { std::lock_guard<std::mutex> l(p_->mu); p_->stop = true; }
+        p_->cv.notify_all();
+        p_->builder.join();
+    }
+}
+
+int FastDecode::max_len() const { return p_->Lmax; }
+
+int FastDecode::layers() const { return (int)p_->layers.size(); }
+
+xrt::bo& layer_bo(FastDecode::Impl& P, int layer, int arg) {
+    for (auto& [i, bo] : P.layers.at(layer).bos) if (i == arg) return bo;
+    throw std::runtime_error("FastDecode: no bo arg " + std::to_string(arg));
+}
+
+size_t FastDecode::layer_bo_size(int layer, int arg) const { return layer_bo(*p_, layer, arg).size(); }
+
+void FastDecode::read_layer_bo(int layer, int arg, size_t off, size_t n, uint8_t* dst) {
+    auto& bo = layer_bo(*p_, layer, arg);
+    bo.sync(XCL_BO_SYNC_BO_FROM_DEVICE, n, off);
+    std::memcpy(dst, bo.map<uint8_t*>() + off, n);
+}
+
+void FastDecode::write_layer_bo(int layer, int arg, size_t off, size_t n, const uint8_t* src) {
+    auto& bo = layer_bo(*p_, layer, arg);
+    std::memcpy(bo.map<uint8_t*>() + off, src, n);
+    bo.sync(XCL_BO_SYNC_BO_TO_DEVICE, n, off);
+}
+
+void FastDecode::hint(int L) {
+    if (p_->cache_all) return;
+    { std::lock_guard<std::mutex> l(p_->mu); p_->want = L; }
+    p_->cv.notify_all();
+}
+
+const uint16_t* FastDecode::step(int L, const uint16_t* in) {
+    Impl& P = *p_;
+    if (L < 0 || L >= P.Lmax) throw std::runtime_error("FastDecode: L out of range");
+    auto a = clk::now();
+    Impl::Built* b = nullptr;
+    if (P.cache_all) {
+        b = P.built[L].get();
+    } else {
+        std::unique_lock<std::mutex> l(P.mu);
+        P.want = L;
+        P.cv.notify_all();
+        P.cv.wait(l, [&] { return P.built.count(L) != 0; });
+        b = P.built[L].get();
+    }
+    last_wait_build_ms = ms_since(a);
+    a = clk::now();
+    const size_t in_bytes = (size_t)P.D * 2;
+    std::memcpy(P.in_bo.map<uint8_t*>(), in, in_bytes);
+    P.in_bo.sync(XCL_BO_SYNC_BO_TO_DEVICE, in_bytes, 0);
+    for (auto& bo : P.rtp_bo) {
+        std::memcpy(bo.map<uint8_t*>(), P.rope[L].data(), kRopeBytes);
+        bo.sync(XCL_BO_SYNC_BO_TO_DEVICE, kRopeBytes, 0);
+    }
+    last_write_ms = ms_since(a);
+    a = clk::now();
+    bool timed_out = false;
+    try {
+        b->rl.execute();
+        timed_out = b->rl.wait(std::chrono::milliseconds(step_timeout_ms)) == std::cv_status::timeout;
+    } catch (const std::exception& e) {
+        throw NpuFault(std::string("NPU step failed: ") + e.what());
+    }
+    if (timed_out)
+        throw NpuFault("NPU step did not complete within " + std::to_string(step_timeout_ms) + " ms (L=" + std::to_string(L) + ")");
+    last_exec_ms = ms_since(a);
+    if (!P.cache_all) hint(L + 1);
+    a = clk::now();
+    P.out_bo.sync(XCL_BO_SYNC_BO_FROM_DEVICE, in_bytes, 0);
+    const uint16_t* h = P.out_bo.map<const uint16_t*>();
+    last_read_ms = ms_since(a);
+    return h;
+}
+
+}  // namespace qwen3_tts
+
+namespace qwen3_tts {
+
+static constexpr size_t kKvRegions = 4, kKvPerPos = 1024;
+
+std::vector<uint8_t> FastDecode::snapshot_kv(int n) {
+    std::vector<uint8_t> out((size_t)layers() * kKvRegions * n * kKvPerPos);
+    uint8_t* d = out.data();
+    for (int l = 0; l < layers(); l++) {
+        const size_t region = layer_bo_size(l, 7) / kKvRegions;
+        for (size_t r = 0; r < kKvRegions; r++, d += n * kKvPerPos)
+            read_layer_bo(l, 7, r * region, n * kKvPerPos, d);
+    }
+    return out;
+}
+
+void FastDecode::restore_kv(const std::vector<uint8_t>& snap, int n) {
+    const uint8_t* s = snap.data();
+    for (int l = 0; l < layers(); l++) {
+        const size_t region = layer_bo_size(l, 7) / kKvRegions;
+        for (size_t r = 0; r < kKvRegions; r++, s += n * kKvPerPos)
+            write_layer_bo(l, 7, r * region, n * kKvPerPos, s);
+    }
+}
+
+}  // namespace qwen3_tts
