+// Exact streaming port of Qwen3TTSTokenizerV2Decoder (qwen_tts 12 Hz tokenizer).
+//
+// Data is time-major [T][C] fp32 throughout. Every causal conv keeps its last
+// (k-1)*dilation input rows between calls; transposed convs (kernel 2s, stride s,
+// right-trimmed by s) are 2-tap causal convs at the input rate with s*Cout outputs,
+// which is the [T*s][Cout] output in memory; the transformer keeps a 72-position KV
+// cache (its sliding window) and a running position. Hence decoding in chunks gives
+// the same samples as decoding the whole utterance at once.
+#include "qwen3_tts/tts_decoder.hpp"
+
+#include <immintrin.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <stdexcept>
+
+namespace qwen3_tts {
+
+namespace {
+
+// ---------------------------------------------------------------- elementwise
+
+/// \brief sin^2 for SnakeBeta; sign of sin is irrelevant so reduce by pi
+inline __m512 sin2_ps(__m512 x) {
+    static const float C1 = 3.140625f;
+    static const float C2 = (float)(M_PI - 3.140625);
+    static const float C3 = (float)(M_PI - 3.140625 - (double)(float)(M_PI - 3.140625));
+    const __m512 k = _mm512_roundscale_ps(_mm512_mul_ps(x, _mm512_set1_ps((float)M_1_PI)),
+                                          _MM_FROUND_TO_NEAREST_INT | _MM_FROUND_NO_EXC);
+    __m512 r = _mm512_fnmadd_ps(k, _mm512_set1_ps(C1), x);
+    r = _mm512_fnmadd_ps(k, _mm512_set1_ps(C2), r);
+    r = _mm512_fnmadd_ps(k, _mm512_set1_ps(C3), r);
+    const __m512 r2 = _mm512_mul_ps(r, r);
+    __m512 p = _mm512_set1_ps(-2.5052108e-08f);           // -1/11!
+    p = _mm512_fmadd_ps(p, r2, _mm512_set1_ps(2.7557319e-06f));   // 1/9!
+    p = _mm512_fmadd_ps(p, r2, _mm512_set1_ps(-1.9841270e-04f));  // -1/7!
+    p = _mm512_fmadd_ps(p, r2, _mm512_set1_ps(8.3333333e-03f));   // 1/5!
+    p = _mm512_fmadd_ps(p, r2, _mm512_set1_ps(-1.6666667e-01f));  // -1/3!
+    p = _mm512_mul_ps(p, r2);
+    const __m512 s = _mm512_fmadd_ps(p, r, r);
+    return _mm512_mul_ps(s, s);
+}
+
+struct Snake {
+    int C = 0;
+    std::vector<float> a, ib;   // exp(alpha), 1/(exp(beta)+1e-9), padded to 16
+    void load(const SafeTensorFile& f, const std::string& p) {
+        auto al = f.f32(p + ".alpha"), be = f.f32(p + ".beta");
+        C = (int)al.size();
+        a.assign((C + 15) / 16 * 16, 0.0f);
+        ib.assign(a.size(), 0.0f);
+        for (int c = 0; c < C; c++) {
+            a[c] = std::exp(al[c]);
+            ib[c] = 1.0f / (std::exp(be[c]) + 1e-9f);
+        }
+    }
+    /// \brief y = x + ib * sin(a x)^2 over rows [T][C], in place (src may alias dst)
+    void apply(const float* src, float* dst, int T, int ld_src, int ld_dst, ThreadPool* pool) const {
+        const int rows_per = std::max(1, 32768 / std::max(C, 1));
+        const int tasks = (T + rows_per - 1) / rows_per;
+        auto job = [&](int t) {
+            for (int r = t * rows_per; r < std::min(T, (t + 1) * rows_per); r++) {
+                const float* x = src + (size_t)r * ld_src;
+                float* y = dst + (size_t)r * ld_dst;
+                int c = 0;
+                for (; c + 16 <= C; c += 16) {
+                    const __m512 v = _mm512_loadu_ps(x + c);
+                    const __m512 s = sin2_ps(_mm512_mul_ps(v, _mm512_loadu_ps(&a[c])));
+                    _mm512_storeu_ps(y + c, _mm512_fmadd_ps(s, _mm512_loadu_ps(&ib[c]), v));
+                }
+                for (; c < C; c++) {
+                    const float s = std::sin(x[c] * a[c]);
+                    y[c] = x[c] + ib[c] * s * s;
+                }
+            }
+        };
+        if (pool && tasks > 1) pool->run(tasks, job);
+        else for (int t = 0; t < tasks; t++) job(t);
+    }
+};
+
+// ---------------------------------------------------------------- conv layers
+
+/// \brief causal conv (or linear) with its own history-prefixed input buffer
+struct Conv {
+    PackedW W;
+    int Cin = 0, N = 0, taps = 1, dil = 1, hist = 0;
+    std::vector<float> in;   // [hist + T][Cin]; first `hist` rows are history
+    GemmInput gi;
+
+    /// \brief rows where the caller writes this call's T input rows
+    float* input(int T) {
+        const size_t need = (size_t)(hist + T) * Cin;
+        if (in.size() < need) in.resize(need, 0.0f);
+        return in.data() + (size_t)hist * Cin;
+    }
+    void reset() { std::fill(in.begin(), in.end(), 0.0f); }
+    /// \brief Y[T][N] (+)= conv(input rows); then keep the last `hist` rows as history
+    void run(int T, float* Y, int ldy, bool acc, ThreadPool* pool) {
+        const void* X = gi.prepare(W, in.data(), (size_t)(hist + T) * Cin, pool);
+        gemm(W, X, Cin, T, dil, Y, ldy, acc, pool);
+        if (hist) std::memmove(in.data(), in.data() + (size_t)T * Cin, (size_t)hist * Cin * sizeof(float));
+    }
+};
+
+/// \brief torch Conv1d weight [Cout][Cin][k], causal (left pad (k-1)*dil)
+void load_conv(Conv& c, const SafeTensorFile& f, const std::string& p, int dil, Prec prec) {
+    auto w = f.f32(p + ".weight");
+    const auto& sh = f.info(p + ".weight").shape;
+    const int Cout = (int)sh[0], Cin = (int)sh[1], k = (int)sh[2];
+    std::vector<float> b = f.has(p + ".bias") ? f.f32(p + ".bias") : std::vector<float>();
+    c.Cin = Cin; c.N = Cout; c.taps = k; c.dil = dil; c.hist = (k - 1) * dil;
+    pack_weights(c.W, Cin, Cout, k, prec,
+                 [&](int t, int ci, int co) { return w[((size_t)co * Cin + ci) * k + t]; },
+                 b.empty() ? nullptr : b.data());
+}
+
+/// \brief torch ConvTranspose1d weight [Cin][Cout][k], stride s, right-trimmed by k - s
+/// \note k == s: one tap; k == 2s: taps (x[q-1] -> W[..r+s], x[q] -> W[..r])
+void load_tconv(Conv& c, const SafeTensorFile& f, const std::string& p, int stride, Prec prec) {
+    auto w = f.f32(p + ".weight");
+    auto b = f.f32(p + ".bias");
+    const auto& sh = f.info(p + ".weight").shape;
+    const int Cin = (int)sh[0], Cout = (int)sh[1], k = (int)sh[2], s = stride;
+    if (k != s && k != 2 * s) throw std::runtime_error("unsupported transposed conv " + p);
+    std::vector<float> bias((size_t)s * Cout);
+    for (int r = 0; r < s; r++) std::copy(b.begin(), b.end(), bias.begin() + (size_t)r * Cout);
+    c.Cin = Cin; c.N = s * Cout; c.dil = 1;
+    c.taps = k == s ? 1 : 2;
+    c.hist = c.taps - 1;
+    pack_weights(c.W, Cin, s * Cout, c.taps, prec,
+                 [&](int t, int ci, int n) {
+                     const int r = n / Cout, co = n % Cout;
+                     const int j = c.taps == 1 ? r : (t == 0 ? r + s : r);
+                     return w[((size_t)ci * Cout + co) * k + j];
+                 }, bias.data());
+}
+
+// ---------------------------------------------------------------- ConvNeXt
+
+struct ConvNeXt {
+    int C = 0;
+    std::vector<float> dw_w, dw_b, ln_w, ln_b, gamma;   // dw_w [C][7]
+    std::vector<float> in;                               // [6 + T][C] history-prefixed
+    std::vector<float> h, mid;
+    PackedW pw1, pw2;
+    GemmInput g1, g2;
+
+    void load(const SafeTensorFile& f, const std::string& p, Prec prec) {
+        dw_w = f.f32(p + ".dwconv.conv.weight");
+        dw_b = f.f32(p + ".dwconv.conv.bias");
+        C = (int)dw_b.size();
+        ln_w = f.f32(p + ".norm.weight");
+        ln_b = f.f32(p + ".norm.bias");
+        gamma = f.f32(p + ".gamma");
+        auto w1 = f.f32(p + ".pwconv1.weight"), b1 = f.f32(p + ".pwconv1.bias");
+        auto w2 = f.f32(p + ".pwconv2.weight"), b2 = f.f32(p + ".pwconv2.bias");
+        pack_linear(pw1, w1.data(), C, 4 * C, prec, b1.data());
+        pack_linear(pw2, w2.data(), 4 * C, C, prec, b2.data());
+    }
+    float* input(int T) {
+        const size_t need = (size_t)(6 + T) * C;
+        if (in.size() < need) in.resize(need, 0.0f);
+        return in.data() + (size_t)6 * C;
+    }
+    void reset() { std::fill(in.begin(), in.end(), 0.0f); }
+    /// \brief out[T][C] = x + gamma * pw2(gelu(pw1(LN(dwconv(x)))))
+    void run(int T, float* out, ThreadPool* pool) {
+        h.resize((size_t)T * C);
+        mid.resize((size_t)T * 4 * C);
+        const float* x = in.data();
+        auto dw = [&](int t) {
+            float* y = &h[(size_t)t * C];
+            for (int c = 0; c < C; c++) {
+                float s = dw_b[c];
+                for (int j = 0; j < 7; j++) s += dw_w[(size_t)c * 7 + j] * x[(size_t)(t + j) * C + c];
+                y[c] = s;
+            }
+            double mean = 0, var = 0;
+            for (int c = 0; c < C; c++) mean += y[c];
+            mean /= C;
+            for (int c = 0; c < C; c++) var += (y[c] - mean) * (y[c] - mean);
+            var /= C;
+            const float inv = 1.0f / std::sqrt((float)var + 1e-6f);
+            for (int c = 0; c < C; c++) y[c] = (float)(y[c] - mean) * inv * ln_w[c] + ln_b[c];
+        };
+        if (pool) pool->run(T, dw); else for (int t = 0; t < T; t++) dw(t);
+        gemm(pw1, g1.prepare(pw1, h.data(), h.size(), pool), C, T, 1, mid.data(), 4 * C, false, pool);
+        const size_t n = mid.size();
+        auto gelu = [&](int t) {
+            for (size_t i = (size_t)t * 4 * C; i < std::min(n, (size_t)(t + 1) * 4 * C); i++)
+                mid[i] = 0.5f * mid[i] * (1.0f + std::erf(mid[i] * (float)M_SQRT1_2));
+        };
+        if (pool) pool->run(T, gelu); else for (int t = 0; t < T; t++) gelu(t);
+        gemm(pw2, g2.prepare(pw2, mid.data(), n, pool), 4 * C, T, 1, h.data(), C, false, pool);
+        for (int t = 0; t < T; t++)
+            for (int c = 0; c < C; c++)
+                out[(size_t)t * C + c] = x[(size_t)(t + 6) * C + c] + gamma[c] * h[(size_t)t * C + c];
+        std::memmove(in.data(), in.data() + (size_t)T * C, (size_t)6 * C * sizeof(float));
+    }
+};
+
+// ---------------------------------------------------------------- transformer
+
+struct DecTransformer {
+    static constexpr int D = 512, H = 16, HD = 64, I = 1024, WIN = 72;
+    static constexpr float EPS = 1e-5f;
+    struct Layer {
+        std::vector<float> ln1, ln2, s_attn, s_mlp;
+        PackedW qkv, o, gu, down;
+        std::vector<float> K, V;   // [n][H*HD], post-rope keys
+    };
+    std::vector<Layer> L;
+    std::vector<float> norm_w;
+    PackedW in_proj, out_proj;
+    std::vector<float> inv_freq;
+    long pos = 0;
+    std::vector<float> x, hbuf, qkv, att, gu, act;
+    GemmInput gi;
+
+    void load(const SafeTensorFile& f, const std::string& p, int layers, Prec prec) {
+        auto w = f.f32(p + ".input_proj.weight"), b = f.f32(p + ".input_proj.bias");
+        pack_linear(in_proj, w.data(), 1024, D, prec, b.data());
+        w = f.f32(p + ".output_proj.weight"); b = f.f32(p + ".output_proj.bias");
+        pack_linear(out_proj, w.data(), D, 1024, prec, b.data());
+        norm_w = f.f32(p + ".norm.weight");
+        L.resize(layers);
+        for (int l = 0; l < layers; l++) {
+            const std::string q = p + ".layers." + std::to_string(l);
+            Layer& y = L[l];
+            y.ln1 = f.f32(q + ".input_layernorm.weight");
+            y.ln2 = f.f32(q + ".post_attention_layernorm.weight");
+            y.s_attn = f.f32(q + ".self_attn_layer_scale.scale");
+            y.s_mlp = f.f32(q + ".mlp_layer_scale.scale");
+            auto wq = f.f32(q + ".self_attn.q_proj.weight"), wk = f.f32(q + ".self_attn.k_proj.weight"),
+                 wv = f.f32(q + ".self_attn.v_proj.weight");
+            std::vector<float> cat(wq);
+            cat.insert(cat.end(), wk.begin(), wk.end());
+            cat.insert(cat.end(), wv.begin(), wv.end());
+            pack_linear(y.qkv, cat.data(), D, 3 * H * HD, prec, nullptr);
+            auto wo = f.f32(q + ".self_attn.o_proj.weight");
+            pack_linear(y.o, wo.data(), H * HD, D, prec, nullptr);
+            auto wg = f.f32(q + ".mlp.gate_proj.weight"), wu = f.f32(q + ".mlp.up_proj.weight");
+            std::vector<float> gcat(wg);
+            gcat.insert(gcat.end(), wu.begin(), wu.end());
+            pack_linear(y.gu, gcat.data(), D, 2 * I, prec, nullptr);
+            auto wd = f.f32(q + ".mlp.down_proj.weight");
+            pack_linear(y.down, wd.data(), I, D, prec, nullptr);
+        }
+        inv_freq.resize(HD / 2);
+        for (int i = 0; i < HD / 2; i++) inv_freq[i] = (float)(1.0 / std::pow(10000.0, 2.0 * i / HD));
+    }
+    void reset() {
+        pos = 0;
+        for (auto& y : L) { y.K.clear(); y.V.clear(); }
+    }
+    static void rmsnorm(const float* x, const float* w, float* y, int n, float eps) {
+        double ss = 0;
+        for (int i = 0; i < n; i++) ss += (double)x[i] * x[i];
+        const float r = 1.0f / std::sqrt((float)(ss / n) + eps);
+        for (int i = 0; i < n; i++) y[i] = w[i] * (x[i] * r);
+    }
+    void rope(float* v, long p) const {   // one head, rotate_half convention
+        for (int i = 0; i < HD / 2; i++) {
+            const float a = (float)p * inv_freq[i];
+            const float c = std::cos(a), s = std::sin(a);
+            const float x1 = v[i], x2 = v[i + HD / 2];
+            v[i] = x1 * c - x2 * s;
+            v[i + HD / 2] = x2 * c + x1 * s;
+        }
+    }
+    /// \brief in [T][1024] -> out [T][1024]
+    void run(const float* in, int T, float* out, ThreadPool* pool) {
+        x.resize((size_t)T * D);
+        hbuf.resize((size_t)T * D);
+        qkv.resize((size_t)T * 3 * H * HD);
+        att.resize((size_t)T * H * HD);
+        gu.resize((size_t)T * 2 * I);
+        act.resize((size_t)T * I);
+        gemm(in_proj, gi.prepare(in_proj, in, (size_t)T * 1024, pool), 1024, T, 1, x.data(), D, false, pool);
+        const float scale = 1.0f / std::sqrt((float)HD);
+        for (auto& y : L) {
+            for (int t = 0; t < T; t++) rmsnorm(&x[(size_t)t * D], y.ln1.data(), &hbuf[(size_t)t * D], D, EPS);
+            gemm(y.qkv, gi.prepare(y.qkv, hbuf.data(), hbuf.size(), pool), D, T, 1, qkv.data(), 3 * H * HD, false, pool);
+            const int base = (int)(y.K.size() / (H * HD));   // cached positions before this chunk
+            for (int t = 0; t < T; t++) {
+                float* q = &qkv[(size_t)t * 3 * H * HD];
+                float* k = q + H * HD;
+                for (int h = 0; h < H; h++) { rope(q + h * HD, pos + t); rope(k + h * HD, pos + t); }
+                y.K.insert(y.K.end(), k, k + H * HD);
+                y.V.insert(y.V.end(), k + H * HD, k + 2 * H * HD);
+            }
+            auto head = [&](int job) {
+                const int t = job / H, h = job % H;
+                const float* q = &qkv[(size_t)t * 3 * H * HD + h * HD];
+                const int qi = base + t;                        // index of this query in K/V
+                const int lo = std::max(0, qi - (WIN - 1));     // kv > q - WIN
+                std::vector<float> sc(qi - lo + 1);
+                float mx = -1e30f;
+                for (int j = lo; j <= qi; j++) {
+                    const float* kk = &y.K[(size_t)j * H * HD + h * HD];
+                    float s = 0;
+                    for (int d = 0; d < HD; d++) s += q[d] * kk[d];
+                    sc[j - lo] = s * scale;
+                    mx = std::max(mx, sc[j - lo]);
+                }
+                float sum = 0;
+                for (auto& s : sc) { s = std::exp(s - mx); sum += s; }
+                float* o = &att[(size_t)t * H * HD + h * HD];
+                std::fill(o, o + HD, 0.0f);
+                for (int j = lo; j <= qi; j++) {
+                    const float wgt = sc[j - lo] / sum;
+                    const float* vv = &y.V[(size_t)j * H * HD + h * HD];
+                    for (int d = 0; d < HD; d++) o[d] += wgt * vv[d];
+                }
+            };
+            if (pool) pool->run(T * H, head); else for (int j = 0; j < T * H; j++) head(j);
+            gemm(y.o, gi.prepare(y.o, att.data(), att.size(), pool), H * HD, T, 1, hbuf.data(), D, false, pool);
+            for (size_t i = 0; i < x.size(); i++) x[i] += y.s_attn[i % D] * hbuf[i];
+            for (int t = 0; t < T; t++) rmsnorm(&x[(size_t)t * D], y.ln2.data(), &hbuf[(size_t)t * D], D, EPS);
+            gemm(y.gu, gi.prepare(y.gu, hbuf.data(), hbuf.size(), pool), D, T, 1, gu.data(), 2 * I, false, pool);
+            for (int t = 0; t < T; t++)
+                for (int i = 0; i < I; i++) {
+                    const float g = gu[(size_t)t * 2 * I + i], u = gu[(size_t)t * 2 * I + I + i];
+                    act[(size_t)t * I + i] = g / (1.0f + std::exp(-g)) * u;
+                }
+            gemm(y.down, gi.prepare(y.down, act.data(), act.size(), pool), I, T, 1, hbuf.data(), D, false, pool);
+            for (size_t i = 0; i < x.size(); i++) x[i] += y.s_mlp[i % D] * hbuf[i];
+            // keep the last WIN-1 positions: the next query only looks that far back
+            const int keep = std::min((int)(y.K.size() / (H * HD)), WIN - 1);
+            const size_t drop = y.K.size() - (size_t)keep * H * HD;
+            y.K.erase(y.K.begin(), y.K.begin() + drop);
+            y.V.erase(y.V.begin(), y.V.begin() + drop);
+        }
+        for (int t = 0; t < T; t++) rmsnorm(&x[(size_t)t * D], norm_w.data(), &hbuf[(size_t)t * D], D, EPS);
+        gemm(out_proj, gi.prepare(out_proj, hbuf.data(), hbuf.size(), pool), D, T, 1, out, 1024, false, pool);
+        pos += T;
+    }
+};
+
+// ---------------------------------------------------------------- decoder
+
+class CpuDecoder final : public AudioDecoder {
+public:
+    CpuDecoder(const std::string& path, Prec prec, std::vector<int> cpus) : pool_(std::move(cpus)) {
+        SafeTensorFile f(path);
+        const std::string p = "decoder.";
+        // RVQ codebooks: embedding_sum / max(cluster_usage, eps)
+        cb_.resize(16);
+        for (int i = 0; i < 16; i++) {
+            const std::string q = i == 0 ? p + "quantizer.rvq_first.vq.layers.0._codebook"
+                                         : p + "quantizer.rvq_rest.vq.layers." + std::to_string(i - 1) + "._codebook";
+            auto es = f.f32(q + ".embedding_sum"), cu = f.f32(q + ".cluster_usage");
+            cb_[i].resize(es.size());
+            for (size_t c = 0; c < cu.size(); c++)
+                for (int d = 0; d < 256; d++) cb_[i][c * 256 + d] = es[c * 256 + d] / std::max(cu[c], 1e-5f);
+        }
+        auto wf = f.f32(p + "quantizer.rvq_first.output_proj.weight");   // [512][256][1]
+        auto wr = f.f32(p + "quantizer.rvq_rest.output_proj.weight");
+        pack_linear(proj_first_, wf.data(), 256, 512, Prec::f32, nullptr);
+        pack_linear(proj_rest_, wr.data(), 256, 512, Prec::f32, nullptr);
+
+        load_conv(pre_conv_, f, p + "pre_conv.conv", 1, prec);
+        tf_.load(f, p + "pre_transformer", 8, prec);
+        for (int u = 0; u < 2; u++) {
+            load_tconv(up_[u], f, p + "upsample." + std::to_string(u) + ".0.conv", 2, prec);
+            cnx_[u].load(f, p + "upsample." + std::to_string(u) + ".1", prec);
+        }
+        load_conv(dec0_, f, p + "decoder.0.conv", 1, prec);
+        const int rates[4] = {8, 5, 4, 3};
+        for (int b = 0; b < 4; b++) {
+            const std::string q = p + "decoder." + std::to_string(b + 1) + ".block.";
+            Block& B = blk_[b];
+            B.s = rates[b];
+            B.in_act.load(f, q + "0");
+            load_tconv(B.up, f, q + "1.conv", rates[b], prec);
+            B.cout = B.up.N / rates[b];
+            const int dil[3] = {1, 3, 9};
+            for (int r = 0; r < 3; r++) {
+                const std::string u = q + std::to_string(r + 2);
+                B.ru[r].a1.load(f, u + ".act1");
+                B.ru[r].a2.load(f, u + ".act2");
+                load_conv(B.ru[r].c1, f, u + ".conv1.conv", dil[r], prec);
+                load_conv(B.ru[r].c2, f, u + ".conv2.conv", 1, prec);
+            }
+        }
+        out_act_.load(f, p + "decoder.5");
+        load_conv(out_conv_, f, p + "decoder.6.conv", 1, prec);
+        reset();
+    }
+
+    void reset() override {
+        pre_conv_.reset();
+        tf_.reset();
+        for (auto& u : up_) u.reset();
+        for (auto& c : cnx_) c.reset();
+        dec0_.reset();
+        for (auto& B : blk_) {
+            B.up.reset();
+            for (auto& r : B.ru) { r.c1.reset(); r.c2.reset(); }
+        }
+        out_conv_.reset();
+    }
+
+    void decode(const int32_t* codes, int F, std::vector<float>& pcm) override {
+        if (F <= 0) return;
+        pool_.pin_caller();
+        ThreadPool* P = &pool_;
+        // 1. RVQ -> [F][512]
+        std::vector<float> e0((size_t)F * 256, 0.0f), er((size_t)F * 256, 0.0f);
+        for (int t = 0; t < F; t++)
+            for (int i = 0; i < 16; i++) {
+                const int c = std::clamp(codes[t * 16 + i], 0, 2047);
+                const float* v = &cb_[i][(size_t)c * 256];
+                float* d = i == 0 ? &e0[(size_t)t * 256] : &er[(size_t)t * 256];
+                for (int k = 0; k < 256; k++) d[k] += v[k];
+            }
+        float* x512 = pre_conv_.input(F);
+        gemm(proj_first_, e0.data(), 256, F, 1, x512, 512, false, nullptr);
+        gemm(proj_rest_, er.data(), 256, F, 1, x512, 512, true, nullptr);
+        // 2. pre_conv -> [F][1024]; 3. transformer -> up_[0] input
+        h1024_.resize((size_t)F * 1024);
+        pre_conv_.run(F, h1024_.data(), 1024, false, P);
+        tf_.run(h1024_.data(), F, up_[0].input(F), P);
+        // 4. upsample x2 x2 with ConvNeXt
+        int T = F;
+        float* next_in = nullptr;
+        for (int u = 0; u < 2; u++) {
+            up_[u].run(T, cnx_[u].input(2 * T), up_[u].N, false, P);
+            T *= 2;
+            next_in = u == 0 ? up_[1].input(T) : dec0_.input(T);
+            cnx_[u].run(T, next_in, P);
+        }
+        // 5. decoder.0 conv 1024 -> 1536, then SnakeBeta into block 0's transposed conv
+        tmp_.resize((size_t)T * dec0_.N);
+        dec0_.run(T, tmp_.data(), dec0_.N, false, P);
+        float* bin = blk_[0].up.input(T);
+        blk_[0].in_act.apply(tmp_.data(), bin, T, dec0_.N, dec0_.N, P);
+        // 6. upsampling blocks
+        for (int b = 0; b < 4; b++) {
+            Block& B = blk_[b];
+            const int C = B.cout;
+            res_.resize((size_t)T * B.s * C);
+            B.up.run(T, res_.data(), B.up.N, false, P);
+            T *= B.s;
+            for (auto& r : B.ru) {
+                float* c1in = r.c1.input(T);
+                r.a1.apply(res_.data(), c1in, T, C, C, P);
+                float* c2in = r.c2.input(T);
+                r.c1.run(T, c2in, C, false, P);
+                r.a2.apply(c2in, c2in, T, C, C, P);
+                r.c2.run(T, res_.data(), C, true, P);   // residual add
+            }
+            if (b < 3) {
+                float* nin = blk_[b + 1].up.input(T);
+                blk_[b + 1].in_act.apply(res_.data(), nin, T, C, C, P);
+            } else {
+                float* oin = out_conv_.input(T);
+                out_act_.apply(res_.data(), oin, T, C, C, P);
+            }
+        }
+        // 7. final conv 96 -> 1, clamp
+        tmp_.resize((size_t)T);
+        out_conv_.run(T, tmp_.data(), 1, false, P);
+        const size_t at = pcm.size();
+        pcm.resize(at + T);
+        for (int t = 0; t < T; t++) pcm[at + t] = std::clamp(tmp_[t], -1.0f, 1.0f);
+    }
+
+private:
+    struct RU { Snake a1, a2; Conv c1, c2; };
+    struct Block { int s = 0, cout = 0; Snake in_act; Conv up; RU ru[3]; };
+
+    ThreadPool pool_;
+    std::vector<std::vector<float>> cb_;
+    PackedW proj_first_, proj_rest_;
+    Conv pre_conv_;
+    DecTransformer tf_;
+    Conv up_[2];
+    ConvNeXt cnx_[2];
+    Conv dec0_;
+    Block blk_[4];
+    Snake out_act_;
+    Conv out_conv_;
+    std::vector<float> h1024_, tmp_, res_;
+};
+
+}  // namespace
+
+std::unique_ptr<AudioDecoder> make_cpu_decoder(const std::string& path, Prec prec, std::vector<int> cpus) {
+    return std::make_unique<CpuDecoder>(path, prec, std::move(cpus));
+}
+
+}  // namespace qwen3_tts
diff --git a/src/common/qwen3_tts/tts_gemm.cpp b/src/common/qwen3_tts/tts_gemm.cpp
new file mode 100644
index 00000000..86599a78
--- /dev/null
+++ b/src/common/qwen3_tts/tts_gemm.cpp
@@ -0,0 +1,224 @@
+#include "qwen3_tts/tts_gemm.hpp"
+
+#include <immintrin.h>
+
+#include <algorithm>
+#include <array>
+#include <utility>
+#include <cassert>
+#include <stdexcept>
+
+namespace qwen3_tts {
+
+namespace {
+
+constexpr int NB = 32;   // output columns per block (two zmm of fp32)
+constexpr int MR = 12;   // rows per micro-kernel call
+constexpr int MT = 48;   // rows per task
+
+template <int R>
+inline void store_rows(__m512 (&c)[MR][2], float* Y, int ldy, int ncols, const float* bias, bool acc) {
+    const __mmask16 m0 = ncols >= 16 ? 0xffff : (__mmask16)((1u << ncols) - 1);
+    const __mmask16 m1 = ncols >= 32 ? 0xffff : ncols <= 16 ? 0 : (__mmask16)((1u << (ncols - 16)) - 1);
+    const __m512 b0 = _mm512_loadu_ps(bias), b1 = _mm512_loadu_ps(bias + 16);
+    for (int r = 0; r < R; r++) {
+        float* y = Y + (size_t)r * ldy;
+        __m512 v0 = _mm512_add_ps(c[r][0], b0), v1 = _mm512_add_ps(c[r][1], b1);
+        if (acc) {
+            v0 = _mm512_add_ps(v0, _mm512_maskz_loadu_ps(m0, y));
+            v1 = _mm512_add_ps(v1, _mm512_maskz_loadu_ps(m1, y + 16));
+        }
+        _mm512_mask_storeu_ps(y, m0, v0);
+        _mm512_mask_storeu_ps(y + 16, m1, v1);
+    }
+}
+
+template <int R>
+void mk_bf16(const uint16_t* X, int ldx, int K2, int taps, int dil, const uint16_t* B,
+             float* Y, int ldy, int ncols, const float* bias, bool acc) {
+    __m512 c[MR][2];
+    for (int r = 0; r < R; r++) c[r][0] = c[r][1] = _mm512_setzero_ps();
+    for (int t = 0; t < taps; t++) {
+        const uint16_t* Bt = B + (size_t)t * K2 * 64;
+        const uint16_t* Xt = X + (size_t)t * dil * ldx;
+        for (int p = 0; p < K2; p++) {
+            const __m512bh b0 = (__m512bh)_mm512_loadu_si512(Bt + (size_t)p * 64);
+            const __m512bh b1 = (__m512bh)_mm512_loadu_si512(Bt + (size_t)p * 64 + 32);
+            for (int r = 0; r < R; r++) {
+                int32_t pair;
+                __builtin_memcpy(&pair, Xt + (size_t)r * ldx + 2 * p, 4);
+                const __m512bh a = (__m512bh)_mm512_set1_epi32(pair);
+                c[r][0] = _mm512_dpbf16_ps(c[r][0], a, b0);
+                c[r][1] = _mm512_dpbf16_ps(c[r][1], a, b1);
+            }
+        }
+    }
+    store_rows<R>(c, Y, ldy, ncols, bias, acc);
+}
+
+template <int R>
+void mk_f32(const float* X, int ldx, int K, int taps, int dil, const float* B,
+            float* Y, int ldy, int ncols, const float* bias, bool acc) {
+    __m512 c[MR][2];
+    for (int r = 0; r < R; r++) c[r][0] = c[r][1] = _mm512_setzero_ps();
+    for (int t = 0; t < taps; t++) {
+        const float* Bt = B + (size_t)t * K * NB;
+        const float* Xt = X + (size_t)t * dil * ldx;
+        for (int k = 0; k < K; k++) {
+            const __m512 b0 = _mm512_loadu_ps(Bt + (size_t)k * NB);
+            const __m512 b1 = _mm512_loadu_ps(Bt + (size_t)k * NB + 16);
+            for (int r = 0; r < R; r++) {
+                const __m512 a = _mm512_set1_ps(Xt[(size_t)r * ldx + k]);
+                c[r][0] = _mm512_fmadd_ps(a, b0, c[r][0]);
+                c[r][1] = _mm512_fmadd_ps(a, b1, c[r][1]);
+            }
+        }
+    }
+    store_rows<R>(c, Y, ldy, ncols, bias, acc);
+}
+
+template <int R>
+void mk_bf16w(const float* X, int ldx, int K, int taps, int dil, const uint16_t* B,
+              float* Y, int ldy, int ncols, const float* bias, bool acc) {
+    __m512 c[MR][2];
+    for (int r = 0; r < R; r++) c[r][0] = c[r][1] = _mm512_setzero_ps();
+    for (int t = 0; t < taps; t++) {
+        const uint16_t* Bt = B + (size_t)t * K * NB;
+        const float* Xt = X + (size_t)t * dil * ldx;
+        for (int k = 0; k < K; k++) {
+            // bf16 -> fp32 is a 16-bit left shift
+            const __m512 b0 = _mm512_castsi512_ps(_mm512_slli_epi32(
+                _mm512_cvtepu16_epi32(_mm256_loadu_si256((const __m256i*)(Bt + (size_t)k * NB))), 16));
+            const __m512 b1 = _mm512_castsi512_ps(_mm512_slli_epi32(
+                _mm512_cvtepu16_epi32(_mm256_loadu_si256((const __m256i*)(Bt + (size_t)k * NB + 16))), 16));
+            for (int r = 0; r < R; r++) {
+                const __m512 a = _mm512_set1_ps(Xt[(size_t)r * ldx + k]);
+                c[r][0] = _mm512_fmadd_ps(a, b0, c[r][0]);
+                c[r][1] = _mm512_fmadd_ps(a, b1, c[r][1]);
+            }
+        }
+    }
+    store_rows<R>(c, Y, ldy, ncols, bias, acc);
+}
+
+using mk_bf16_t = void (*)(const uint16_t*, int, int, int, int, const uint16_t*, float*, int, int, const float*, bool);
+using mk_f32_t = void (*)(const float*, int, int, int, int, const float*, float*, int, int, const float*, bool);
+
+template <int... Rs>
+constexpr auto make_bf16_table(std::integer_sequence<int, Rs...>) {
+    return std::array<mk_bf16_t, sizeof...(Rs)>{&mk_bf16<Rs + 1>...};
+}
+using mk_bf16w_t = void (*)(const float*, int, int, int, int, const uint16_t*, float*, int, int, const float*, bool);
+template <int... Rs>
+constexpr auto make_bf16w_table(std::integer_sequence<int, Rs...>) {
+    return std::array<mk_bf16w_t, sizeof...(Rs)>{&mk_bf16w<Rs + 1>...};
+}
+template <int... Rs>
+constexpr auto make_f32_table(std::integer_sequence<int, Rs...>) {
+    return std::array<mk_f32_t, sizeof...(Rs)>{&mk_f32<Rs + 1>...};
+}
+const auto kBf16 = make_bf16_table(std::make_integer_sequence<int, MR>{});
+const auto kF32 = make_f32_table(std::make_integer_sequence<int, MR>{});
+const auto kBf16w = make_bf16w_table(std::make_integer_sequence<int, MR>{});
+
+}  // namespace
+
+void pack_weights(PackedW& P, int K, int N, int taps, Prec prec,
+                  const std::function<float(int, int, int)>& w, const float* bias) {
+    if (prec == Prec::bf16 && (K & 1)) throw std::runtime_error("bf16 GEMM needs even K");
+    P.K = K; P.N = N; P.taps = taps; P.prec = prec;
+    P.nblocks = (N + NB - 1) / NB;
+    P.bias.assign((size_t)P.nblocks * NB, 0.0f);
+    P.has_bias = bias != nullptr;
+    if (bias) std::copy(bias, bias + N, P.bias.begin());
+    if (prec == Prec::bf16) {
+        const int K2 = K / 2;
+        P.wb.assign((size_t)P.nblocks * taps * K2 * 64, 0);
+        for (int nb = 0; nb < P.nblocks; nb++)
+            for (int t = 0; t < taps; t++)
+                for (int p = 0; p < K2; p++) {
+                    uint16_t* d = &P.wb[(((size_t)nb * taps + t) * K2 + p) * 64];
+                    for (int j = 0; j < NB; j++) {
+                        const int n = nb * NB + j;
+                        if (n >= N) continue;
+                        d[2 * j] = f2bf(w(t, 2 * p, n));
+                        d[2 * j + 1] = f2bf(w(t, 2 * p + 1, n));
+                    }
+                }
+    } else if (prec == Prec::bf16w) {
+        P.wb.assign((size_t)P.nblocks * taps * K * NB, 0);
+        for (int nb = 0; nb < P.nblocks; nb++)
+            for (int t = 0; t < taps; t++)
+                for (int k = 0; k < K; k++) {
+                    uint16_t* d = &P.wb[(((size_t)nb * taps + t) * K + k) * NB];
+                    for (int j = 0; j < NB; j++) {
+                        const int n = nb * NB + j;
+                        if (n < N) d[j] = f2bf(w(t, k, n));
+                    }
+                }
+    } else {
+        P.wf.assign((size_t)P.nblocks * taps * K * NB, 0.0f);
+        for (int nb = 0; nb < P.nblocks; nb++)
+            for (int t = 0; t < taps; t++)
+                for (int k = 0; k < K; k++) {
+                    float* d = &P.wf[(((size_t)nb * taps + t) * K + k) * NB];
+                    for (int j = 0; j < NB; j++) {
+                        const int n = nb * NB + j;
+                        if (n < N) d[j] = w(t, k, n);
+                    }
+                }
+    }
+}
+
+void pack_linear(PackedW& P, const float* w_nk, int K, int N, Prec prec, const float* bias) {
+    pack_weights(P, K, N, 1, prec, [&](int, int k, int n) { return w_nk[(size_t)n * K + k]; }, bias);
+}
+
+void pack_linear_bf16(PackedW& P, const uint16_t* w_nk, int K, int N, const float* bias, Prec prec) {
+    pack_weights(P, K, N, 1, prec, [&](int, int k, int n) { return bf2f(w_nk[(size_t)n * K + k]); }, bias);
+}
+
+void gemm(const PackedW& P, const void* X, int ldx, int M, int dil, float* Y, int ldy,
+          bool accumulate, ThreadPool* pool) {
+    if (M <= 0) return;
+    const int mtiles = (M + MT - 1) / MT;
+    const int ntasks = P.nblocks * mtiles;
+    auto task = [&](int t) {
+        const int nb = t % P.nblocks, mt = t / P.nblocks;
+        const int ncols = std::min(NB, P.N - nb * NB);
+        const float* bias = &P.bias[(size_t)nb * NB];
+        for (int m0 = mt * MT; m0 < std::min(M, (mt + 1) * MT); m0 += MR) {
+            const int rows = std::min(MR, M - m0);
+            float* y = Y + (size_t)m0 * ldy + nb * NB;
+            if (P.prec == Prec::bf16) {
+                const int K2 = P.K / 2;
+                kBf16[rows - 1]((const uint16_t*)X + (size_t)m0 * ldx, ldx, K2, P.taps, dil,
+                                &P.wb[(size_t)nb * P.taps * K2 * 64], y, ldy, ncols, bias, accumulate);
+            } else if (P.prec == Prec::bf16w) {
+                kBf16w[rows - 1]((const float*)X + (size_t)m0 * ldx, ldx, P.K, P.taps, dil,
+                                 &P.wb[(size_t)nb * P.taps * P.K * NB], y, ldy, ncols, bias, accumulate);
+            } else {
+                kF32[rows - 1]((const float*)X + (size_t)m0 * ldx, ldx, P.K, P.taps, dil,
+                               &P.wf[(size_t)nb * P.taps * P.K * NB], y, ldy, ncols, bias, accumulate);
+            }
+        }
+    };
+    if (pool && ntasks > 1) pool->run(ntasks, task);
+    else for (int t = 0; t < ntasks; t++) task(t);
+}
+
+const void* GemmInput::prepare(const PackedW& P, const float* src, size_t n, ThreadPool* pool) {
+    if (P.prec != Prec::bf16) return src;
+    if (b.size() < n) b.resize(n);
+    constexpr size_t chunk = 1 << 16;
+    const int tasks = (int)((n + chunk - 1) / chunk);
+    auto conv = [&](int t) {
+        const size_t a = (size_t)t * chunk, e = std::min(n, a + chunk);
+        to_bf16(src + a, b.data() + a, e - a);
+    };
+    if (pool && tasks > 1) pool->run(tasks, conv);
+    else for (int t = 0; t < tasks; t++) conv(t);
+    return b.data();
+}
+
+}  // namespace qwen3_tts
