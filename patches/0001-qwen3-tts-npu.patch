diff --git a/src/include/qwen3_tts/fast_decode.hpp b/src/include/qwen3_tts/fast_decode.hpp
new file mode 100644
index 00000000..e4643b2d
--- /dev/null
+++ b/src/include/qwen3_tts/fast_decode.hpp
@@ -0,0 +1,61 @@
+#pragma once
+// Decode-step dispatch for a stock FLM qwen3_npu engine without its per-step rebuild.
+//
+// The engine regenerates its control and layer instruction streams (ELFs) and the RoPE
+// rows of its per-layer runtime-parameter buffers for every context length L. Both are a
+// deterministic function of L. FastDecode harvests them once at load by calling the
+// engine's public set_context_length(L), captures the kernels and buffer arguments the
+// engine wires into its runlist, and then executes decode steps itself:
+//   write the input row (D bf16) and the RoPE row (256 B per layer), syncing only those
+//   bytes; execute a runlist for L that was built ahead of time; read the pre-norm hidden.
+// Runlists are cached (predictor: all L of a frame, reused every frame) or built ahead on
+// a background thread (talker), so no instruction generation is on the critical path.
+#include <cstdint>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+class qwen3_npu;
+
+namespace qwen3_tts {
+
+/// \brief an NPU dispatch that failed or did not complete; the device may need a reset
+struct NpuFault : std::runtime_error {
+    using std::runtime_error::runtime_error;
+};
+
+class FastDecode {
+public:
+    /// \param L_max  largest context length to harvest (positions 0 .. L_max-1)
+    /// \param cache_all  keep every built runlist (small L_max) instead of a ring
+    FastDecode(qwen3_npu* engine, int dim, int L_max, bool cache_all);
+    ~FastDecode();
+    int max_len() const;
+    /// \brief one decode step for the token at position L (= tokens already cached)
+    /// \return pre-norm hidden state, D bf16 values, valid until the next call
+    const uint16_t* step(int L, const uint16_t* input_bf16);
+    /// \brief tell the background builder which positions come next
+    void hint(int L_next);
+    /// \brief timing of the last step (ms): host writes+syncs, NPU execute+wait, read
+    double last_write_ms = 0, last_exec_ms = 0, last_read_ms = 0, last_wait_build_ms = 0;
+    /// \brief per-layer buffer access (debug / KV snapshots): arg index 3..7 of layer run i
+    int layers() const;
+    size_t layer_bo_size(int layer, int arg) const;
+    void read_layer_bo(int layer, int arg, size_t off, size_t n, uint8_t* dst);
+    void write_layer_bo(int layer, int arg, size_t off, size_t n, const uint8_t* src);
+    /// \brief KV cache of positions [0, n): arg7 of every layer holds four equal regions,
+    ///        each with 1 KiB per position at offset 1024 * pos
+    std::vector<uint8_t> snapshot_kv(int n);
+    void restore_kv(const std::vector<uint8_t>& snap, int n);
+    /// \brief a step that takes longer throws NpuFault (normal steps take < 40 ms)
+    int step_timeout_ms = 2000;
+    /// \brief harvest time at load (ms)
+    double harvest_ms = 0;
+
+    struct Impl;
+private:
+    std::unique_ptr<Impl> p_;
+};
+
+}  // namespace qwen3_tts
diff --git a/src/include/qwen3_tts/npu_qwen3.hpp b/src/include/qwen3_tts/npu_qwen3.hpp
new file mode 100644
index 00000000..d9d294a7
--- /dev/null
+++ b/src/include/qwen3_tts/npu_qwen3.hpp
@@ -0,0 +1,50 @@
+#pragma once
+// A stock FLM qwen3_npu engine driven with injected input embeddings: each decode step
+// writes the input vector into the engine's input buffer, runs the layers through
+// FastDecode, reads the pre-norm hidden state from the output head's input buffer and
+// applies the final RMSNorm on the CPU. The engine's own output head is never run.
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "qwen3_tts/fast_decode.hpp"
+#include "qwen3_tts/tts_common.hpp"
+
+class npu_xclbin_manager;
+class qwen3_npu;
+
+namespace qwen3_tts {
+
+class NpuQwen3 {
+public:
+    /// \param model_dir  stock Qwen3 Q4NX package; its basename selects the xclbins
+    /// \param max_len    engine context length (KV cache size)
+    /// \param fast_len   positions served by FastDecode (all decode steps must stay below)
+    /// \param cache_all  build every runlist up front (small fast_len, e.g. predictor)
+    NpuQwen3(npu_xclbin_manager* npu, const std::string& model_dir, int max_len, int fast_len, bool cache_all);
+    ~NpuQwen3();
+    int dim() const { return D_; }
+    int max_pos() const { return fast_->max_len(); }
+    /// \brief restart at position 0 (no engine rebuild)
+    void clear();
+    /// \brief one decode step with input embedding e[D]; returns the post-norm hidden
+    const float* step(const float* e);
+    /// \brief set the position counter, e.g. after restoring a KV snapshot
+    void set_pos(int p) { pos_ = p; }
+    int pos() const { return pos_; }
+    FastDecode* fast() { return fast_.get(); }
+    /// \brief per-step timing of the last call (ms)
+    double last_exec_ms() const { return fast_->last_exec_ms; }
+
+private:
+    const float* norm_hidden(const uint16_t* v);
+    std::unique_ptr<qwen3_npu> eng_;
+    std::unique_ptr<FastDecode> fast_;
+    int pos_ = 0;
+    std::vector<float> norm_w_, h_;
+    std::vector<uint16_t> in_;
+    float eps_ = 1e-6f;
+    int D_ = 0;
+};
+
+}  // namespace qwen3_tts
diff --git a/src/include/qwen3_tts/qwen3_tts.hpp b/src/include/qwen3_tts/qwen3_tts.hpp
new file mode 100644
index 00000000..65031086
--- /dev/null
+++ b/src/include/qwen3_tts/qwen3_tts.hpp
@@ -0,0 +1,108 @@
+#pragma once
+// Qwen3-TTS-12Hz-1.7B-CustomVoice on the NPU: model package loading, voices and the
+// serving loop.
+//
+// Generation: the talker and code predictor run on two stock qwen3_npu engines
+// (NpuQwen3 / FastDecode); text and codec embeddings, heads, sampling and the speech
+// decoder run on the CPU. Text arrives through a TextInput (possibly while generating) and
+// is spoken segment by segment (see tts_text.hpp); every segment restarts from the voice's
+// KV-cache snapshot.
+//
+// Serving policy per utterance:
+//   segment 0 streams as it is generated. Later segments are generated ahead (at most two
+//   segments ahead of the one playing) and checked before they are sent; a segment whose
+//   check fails is regenerated with another seed (up to 2 retries). If the listener would
+//   run out of audio first, the attempt in progress streams instead (opportunistic retry).
+//   Check: talker code0 entropy over a 25-frame window, length against the text, and a
+//   hard frame cap from the text length.
+//   Joins: a pause after each segment, loudness matched to the first segment.
+// Audio out: 24 kHz mono 16-bit PCM.
+//
+// NPU faults (an XRT error, a step timeout, or an amdxdna error in the kernel log) stop
+// the engine for good: the current utterance ends with an error and every later request
+// is refused until flm is restarted (after reloading the amdxdna module if needed).
+#include <atomic>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "device_runtime.hpp"
+#include "nlohmann/json.hpp"
+#include "qwen3_tts/tts_text.hpp"
+
+namespace qwen3_tts {
+
+struct TtsOptions {
+    std::string cpus = "0-7";        // host heads / embeddings thread pool (first = generator thread)
+    std::string dec_cpus = "8-11";   // speech decoder thread pool
+    float temperature = 0.9f;
+    int top_k = 50;
+    float repetition_penalty = 1.05f;
+    int min_lead = 8;                // text tokens needed before a still-open segment starts
+    bool warmup = true;
+    /// \brief from FLM_TTS_* environment variables, defaults otherwise
+    static TtsOptions from_env();
+};
+
+struct TtsRequest {
+    std::string voice;               // speaker; empty = default
+    std::string language;            // empty = the speaker's own language; "auto" = no language tag
+    uint64_t seed = 0;               // 0 = random
+    float temperature = 0.0f;        // 0 = default
+    bool events = false;             // report segment / lead events through the sink
+};
+
+struct TtsSink {
+    /// \brief 24 kHz mono PCM16; return false if the client is gone (cancels the utterance)
+    std::function<bool(const int16_t* pcm, size_t n)> audio;
+    /// \brief progress events (only when TtsRequest::events)
+    std::function<void(const nlohmann::ordered_json&)> event;
+};
+
+struct TtsResult {
+    enum Status { ok, cancelled, error, fault } status = ok;
+    std::string message;
+    nlohmann::ordered_json metrics;
+};
+
+class Qwen3Tts {
+public:
+    static constexpr int kSampleRate = 24000;
+    /// \brief model_list entry is a Qwen3-TTS package
+    static bool is_tts_model(const nlohmann::ordered_json& model_info);
+
+    /// \brief load the package in model_dir (see src/tools/qwen3_tts/README.md); builds
+    ///        every speaker's voice prefix and runs one warm-up generation
+    Qwen3Tts(flm_rt::device* device, const std::string& model_dir, const TtsOptions& opt = TtsOptions::from_env());
+    ~Qwen3Tts();
+
+    /// \brief speak everything that arrives through `text` until it is finished; blocks.
+    ///        `cancelled` is polled every frame (and while waiting for text).
+    TtsResult speak(const TtsRequest& req, TextInput& text, TtsSink& sink, const std::function<bool()>& cancelled);
+
+    /// \brief a new TextInput using this model's tokenizer
+    std::unique_ptr<TextInput> make_input() const;
+
+    std::vector<std::string> voices() const;
+    std::vector<std::string> languages() const;
+    /// \brief empty if the voice / language pair is usable, else the reason
+    std::string check_voice(const std::string& voice, const std::string& language) const;
+    std::string default_voice() const;
+
+    /// \brief one tiny NPU dispatch: keeps the device out of runtime suspend (the amdxdna
+    ///        driver suspends it after ~5 s idle; the first dispatch after that costs ~135 ms)
+    void keep_warm();
+    /// \brief seconds since the last utterance ended (or since load)
+    double idle_s() const;
+
+    bool faulted() const;
+    std::string fault_message() const;
+
+    struct Impl;
+private:
+    std::unique_ptr<Impl> p_;
+};
+
+}  // namespace qwen3_tts
diff --git a/src/include/qwen3_tts/tts_common.hpp b/src/include/qwen3_tts/tts_common.hpp
new file mode 100644
index 00000000..d9e84fc2
--- /dev/null
+++ b/src/include/qwen3_tts/tts_common.hpp
@@ -0,0 +1,102 @@
+#pragma once
+// Shared pieces for the Qwen3-TTS spike: safetensors reader, pinned thread pool,
+// bf16 helpers, timing.
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <cstring>
+#include <functional>
+#include <map>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "nlohmann/json.hpp"
+
+namespace qwen3_tts {
+
+using clk = std::chrono::steady_clock;
+inline double ms_since(clk::time_point a) {
+    return std::chrono::duration<double, std::milli>(clk::now() - a).count();
+}
+
+// ---- bf16 ----
+inline float bf2f(uint16_t v) {
+    uint32_t u = (uint32_t)v << 16;
+    float f;
+    std::memcpy(&f, &u, 4);
+    return f;
+}
+inline uint16_t f2bf(float f) {   // round to nearest even
+    uint32_t u;
+    std::memcpy(&u, &f, 4);
+    if ((u & 0x7fffffff) > 0x7f800000) return (uint16_t)((u >> 16) | 0x40);
+    u += 0x7fff + ((u >> 16) & 1);
+    return (uint16_t)(u >> 16);
+}
+/// \brief fp32 -> bf16 for n values (AVX-512 BF16)
+void to_bf16(const float* src, uint16_t* dst, size_t n);
+
+// ---- safetensors ----
+class SafeTensorFile {
+public:
+    explicit SafeTensorFile(const std::string& path);
+    ~SafeTensorFile();
+    SafeTensorFile(const SafeTensorFile&) = delete;
+    SafeTensorFile& operator=(const SafeTensorFile&) = delete;
+
+    struct Info { std::string dtype; std::vector<int64_t> shape; const uint8_t* data; size_t bytes; };
+    bool has(const std::string& name) const { return index_.count(name) != 0; }
+    const Info& info(const std::string& name) const;
+    /// \brief tensor as fp32 (F32 or BF16 on disk)
+    std::vector<float> f32(const std::string& name) const;
+    /// \brief tensor as bf16 bits (BF16 on disk, or F32 rounded)
+    std::vector<uint16_t> bf16(const std::string& name) const;
+
+private:
+    int fd_ = -1;
+    size_t size_ = 0;
+    uint8_t* map_ = nullptr;
+    std::map<std::string, Info> index_;
+};
+
+// ---- thread pool ----
+/// \brief fixed set of workers, each pinned to one CPU; the caller is worker 0
+class ThreadPool {
+public:
+    /// \param cpus logical CPU per worker; cpus[0] is the calling thread (pinned on first run)
+    explicit ThreadPool(std::vector<int> cpus);
+    ~ThreadPool();
+    int size() const { return (int)cpus_.size(); }
+    /// \brief run fn(task) for task in [0, n) across the workers; blocks until done
+    void run(int n, const std::function<void(int)>& fn);
+    /// \brief pin the calling thread to cpus[0] (call from the thread that will call run())
+    void pin_caller();
+
+private:
+    void worker(int idx);
+    std::vector<int> cpus_;
+    std::vector<std::thread> threads_;
+    std::mutex mu_;
+    std::condition_variable cv_start_;
+    const std::function<void(int)>* fn_ = nullptr;
+    int n_ = 0;
+    std::atomic<int> next_{0};
+    std::atomic<int> generation_{0}, busy_{0};
+    std::atomic<bool> stop_{false};
+};
+
+/// \brief pin the calling thread to one logical CPU
+void pin_this_thread(int cpu);
+
+/// \brief "8-11" or "0,2,4" -> {8,9,10,11}
+std::vector<int> parse_cpus(const std::string& s);
+
+/// \brief whole binary file as T[]
+template <class T> std::vector<T> read_file(const std::string& path);
+/// \brief 16-bit PCM mono WAV
+void write_wav16(const std::string& path, const std::vector<float>& pcm, int sample_rate);
+
+}  // namespace qwen3_tts
