@@ -0,0 +1,212 @@
+"""Client for FLM's text-to-speech endpoints: speak text, stream text, or speak LLM output.
+
+usage:
+  tts_client.py speak "text" [-o out.wav] [--voice V] [--language L]
+      POST /v1/audio/speech with streamed audio; reports time to first audio
+  tts_client.py stream (--text T | --file F) [--chunk 4 --rate 40] [-o out.wav]
+      WebSocket /v1/audio/speech/stream; feeds the text in --chunk characters at --rate
+      chunks/s (an LLM-like text stream)
+  tts_client.py llm --prompt P --llm-url URL --llm-model M [--paced] [-o out.wav]
+      streams an OpenAI-compatible chat completion into the WebSocket. --paced keeps the
+      text lead (the server's "lead" events) near --min-lead tokens by asking the LLM for
+      one sentence at a time, instead of streaming the whole reply at once.
+      The LLM key is read from $LLM_API_KEY; --llm-extra adds JSON to the request body
+      (e.g. '{"chat_template_kwargs": {"enable_thinking": false}}').
+common: --server http://127.0.0.1:52625  --cancel-after S (send input.cancel after S s)
+Reports: time to first audio, playback underruns (audio that would arrive after the
+player needed it, playback starting at the first chunk), cancel latency, server metrics.
+Needs: websockets (pip install websockets==15.0.1); everything else is the standard library.
+"""
+import argparse, asyncio, json, os, struct, sys, time, urllib.request, wave
+
+RATE = 24000
+
+
+def save_wav(path, pcm: bytes):
+    with wave.open(path, "wb") as w:
+        w.setnchannels(1); w.setsampwidth(2); w.setframerate(RATE); w.writeframes(pcm)
+
+
+class Playback:
+    """virtual player: starts at the first chunk and plays continuously"""
+    def __init__(self):
+        self.t0 = None; self.samples = 0; self.underruns = 0; self.worst_late = 0.0; self.first = None
+
+    def chunk(self, n_bytes, now):
+        if self.t0 is None:
+            self.t0 = now; self.first = now
+        due = self.t0 + self.samples / RATE
+        if now > due + 0.005:
+            self.underruns += 1; self.worst_late = max(self.worst_late, now - due)
+            self.t0 += now - due            # the player stalls, then continues
+        self.samples += n_bytes // 2
+
+
+def cmd_speak(a):
+    body = {"input": a.text, "voice": a.voice, "language": a.language, "response_format": "wav",
+            "stream": True, "stream_format": "audio"}
+    if a.seed: body["seed"] = a.seed
+    req = urllib.request.Request(a.server + "/v1/audio/speech", data=json.dumps(body).encode(),
+                                 headers={"Content-Type": "application/json"})
+    t0 = time.time(); first = None; data = b""; pb = Playback()
+    with urllib.request.urlopen(req) as r:
+        while True:
+            b = r.read1(65536) if hasattr(r, "read1") else r.read(65536)
+            if not b: break
+            now = time.time()
+            if first is None: first = now
+            data += b
+            pb.chunk(len(b), now)
+    pcm = data[44:]
+    save_wav(a.output, pcm)
+    print(json.dumps({"audio_s": len(pcm) / 2 / RATE, "first_audio_ms": round(1000 * (first - t0)) if first else None,
+                      "underruns": pb.underruns, "worst_late_ms": round(1000 * pb.worst_late), "out": a.output}))
+
+
+async def ws_session(a, feeder):
+    import websockets
+    url = a.server.replace("http", "ws", 1) + "/v1/audio/speech/stream"
+    pcm = bytearray(); pb = Playback(); events = []; t_cancel = None; t_last_audio = None
+    async with websockets.connect(url, max_size=None) as ws:
+        cfg = {"type": "session.config", "voice": a.voice, "language": a.language}
+        if a.seed: cfg["seed"] = a.seed
+        await ws.send(json.dumps(cfg))
+        state = {"lead": 0, "t_first_text": None, "done": False}
+
+        async def reader():
+            nonlocal t_last_audio
+            async for msg in ws:
+                now = time.time()
+                if isinstance(msg, bytes):
+                    pcm.extend(msg); pb.chunk(len(msg), now); t_last_audio = now
+                    continue
+                e = json.loads(msg)
+                if e["type"] == "lead": state["lead"] = e["lead"]
+                elif e["type"] in ("segment", "audio.done", "error", "audio.start"): events.append(e)
+                if e["type"] == "error": print("server error:", e.get("message"), file=sys.stderr)
+                if e["type"] == "session.done":
+                    state["done"] = True
+                    return
+
+        async def canceller():
+            nonlocal t_cancel
+            await asyncio.sleep(a.cancel_after)
+            t_cancel = time.time()
+            await ws.send(json.dumps({"type": "input.cancel"}))
+
+        rd = asyncio.create_task(reader())
+        tasks = [asyncio.create_task(canceller())] if a.cancel_after else []
+        await feeder(ws, state)
+        await ws.send(json.dumps({"type": "input.done"}))
+        await rd
+        for t in tasks: t.cancel()
+        await ws.send(json.dumps({"type": "session.close"}))
+    done = next((e for e in events if e["type"] == "audio.done"), {})
+    m = done.get("metrics") or {}
+    out = {"audio_s": round(len(pcm) / 2 / RATE, 2), "status": done.get("status"),
+           "first_audio_from_first_text_ms": round(1000 * (pb.first - state["t_first_text"])) if pb.first and state["t_first_text"] else None,
+           "underruns": pb.underruns, "worst_late_ms": round(1000 * pb.worst_late),
+           "segments": m.get("segments"), "retries": m.get("retries"), "server_ttfa_ms": m.get("ttfa_ms"),
+           "frame_ms_mean": m.get("frame_ms_mean"), "frame_ms_p99": m.get("frame_ms_p99"), "out": a.output}
+    if t_cancel:
+        out["cancel_to_last_audio_ms"] = round(1000 * ((t_last_audio or t_cancel) - t_cancel))
+    save_wav(a.output, bytes(pcm))
+    if a.events:
+        with open(a.events, "w") as f:
+            json.dump({"summary": out, "events": events, "metrics": m}, f, ensure_ascii=False, indent=1)
+    print(json.dumps(out, ensure_ascii=False))
+
+
+def cmd_stream(a):
+    text = a.text if a.text is not None else open(a.file, encoding="utf-8").read()
+
+    async def feeder(ws, state):
+        state["t_first_text"] = time.time()
+        for i in range(0, len(text), a.chunk):
+            await ws.send(json.dumps({"type": "input.text", "text": text[i:i + a.chunk]}))
+            await asyncio.sleep(1.0 / a.rate)
+    asyncio.run(ws_session(a, feeder))
+
+
+def llm_stream(a, messages, max_tokens):
+    """yield content deltas of a streamed chat completion (blocking; run in a thread)"""
+    body = {"model": a.llm_model, "messages": messages, "stream": True, "max_tokens": max_tokens}
+    if a.llm_extra: body.update(json.loads(a.llm_extra))
+    req = urllib.request.Request(a.llm_url.rstrip("/") + "/chat/completions", data=json.dumps(body).encode(),
+                                 headers={"Content-Type": "application/json",
+                                          "Authorization": "Bearer " + os.environ.get("LLM_API_KEY", "")})
+    with urllib.request.urlopen(req) as r:
+        for line in r:
+            line = line.decode("utf-8").strip()
+            if not line.startswith("data:") or line == "data: [DONE]": continue
+            d = json.loads(line[5:])
+            if d.get("choices") and d["choices"][0].get("delta", {}).get("content"):
+                yield d["choices"][0]["delta"]["content"]
+
+
+def cmd_llm(a):
+    system = a.system or ("あなたは親切な日本語のアシスタントです。音声で読み上げられるので、記号や箇条書きを使わず、"
+                          "自然な話し言葉の文章だけで答えてください。")
+    messages = [{"role": "system", "content": system}, {"role": "user", "content": a.prompt}]
+
+    async def feeder(ws, state):
+        loop = asyncio.get_running_loop()
+        q = asyncio.Queue()
+
+        def pump(msgs, max_tokens):
+            for d in llm_stream(a, msgs, max_tokens): loop.call_soon_threadsafe(q.put_nowait, d)
+            loop.call_soon_threadsafe(q.put_nowait, None)
+
+        reply = ""
+        for turn in range(a.max_requests if a.paced else 1):
+            if a.paced and turn:
+                # next sentence only when the text lead runs low
+                while state["lead"] >= a.min_lead and not state["done"]: await asyncio.sleep(0.02)
+                msgs = messages + [{"role": "assistant", "content": reply},
+                                   {"role": "user", "content": "続けてください。次の一文だけを話してください。"}]
+            else:
+                msgs = messages
+            loop.run_in_executor(None, pump, msgs, a.sentence_tokens if a.paced else a.max_tokens)
+            got = ""
+            while True:
+                d = await q.get()
+                if d is None: break
+                if state["t_first_text"] is None: state["t_first_text"] = time.time()
+                got += d
+                state["lead"] += 1   # until the server's next lead event
+                await ws.send(json.dumps({"type": "input.text", "text": d}))
+            reply += got
+            if not got: break
+    asyncio.run(ws_session(a, feeder))
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    sub = p.add_subparsers(dest="cmd", required=True)
+    for name in ("speak", "stream", "llm"):
+        s = sub.add_parser(name)
+        s.add_argument("--server", default="http://127.0.0.1:52625")
+        s.add_argument("--voice", default="ono_anna")
+        s.add_argument("--language", default="")
+        s.add_argument("--seed", type=int, default=0)
+        s.add_argument("-o", "--output", default="out.wav")
+        s.add_argument("--events", default="", help="write events and metrics to this JSON file")
+        s.add_argument("--cancel-after", type=float, default=0.0)
+        if name == "speak":
+            s.add_argument("text")
+        if name == "stream":
+            s.add_argument("--text"); s.add_argument("--file")
+            s.add_argument("--chunk", type=int, default=4); s.add_argument("--rate", type=float, default=40.0)
+        if name == "llm":
+            s.add_argument("--prompt", required=True); s.add_argument("--system", default="")
+            s.add_argument("--llm-url", required=True); s.add_argument("--llm-model", required=True)
+            s.add_argument("--llm-extra", default="")
+            s.add_argument("--paced", action="store_true"); s.add_argument("--min-lead", type=int, default=8)
+            s.add_argument("--sentence-tokens", type=int, default=40); s.add_argument("--max-requests", type=int, default=12)
+            s.add_argument("--max-tokens", type=int, default=400)
+    a = p.parse_args()
+    {"speak": cmd_speak, "stream": cmd_stream, "llm": cmd_llm}[a.cmd](a)
+
+
+if __name__ == "__main__":
+    main()
