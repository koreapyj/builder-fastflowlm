+"""Extract the host-side talker tensors (everything the NPU engines do not hold).
+
+usage: trim_host.py <tts_dir> <out.safetensors>
+
+Keeps every talker.* tensor of model.safetensors except the transformer layers
+(talker.model.layers.*, talker.code_predictor.model.layers.*), which live in the Q4NX
+packages: codec/text embeddings, text projection, final norms, codec_head and the
+code predictor's embeddings, projection and heads. Dtypes are unchanged (BF16).
+"""
+import argparse
+from pathlib import Path
+
+from safetensors import safe_open
+from safetensors.torch import save_file
+
+DROP = ("talker.model.layers.", "talker.code_predictor.model.layers.")
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("tts_dir", type=Path)
+    ap.add_argument("out", type=Path)
+    a = ap.parse_args()
+    tensors = {}
+    with safe_open(a.tts_dir / "model.safetensors", "pt") as f:
+        for k in sorted(f.keys()):
+            if k.startswith("talker.") and not k.startswith(DROP):
+                tensors[k] = f.get_tensor(k).contiguous()
+    save_file(tensors, a.out, metadata={"format": "pt"})
+    print(f"wrote {a.out}: {len(tensors)} tensors, {sum(t.numel() for t in tensors.values()) / 1e6:.1f}M params")
+
+
+if __name__ == "__main__":
+    main()
