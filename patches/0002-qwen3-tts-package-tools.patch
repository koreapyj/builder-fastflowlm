diff --git a/src/tools/qwen3_tts/calibrate_entropy.py b/src/tools/qwen3_tts/calibrate_entropy.py
new file mode 100644
index 00000000..b524a980
--- /dev/null
+++ b/src/tools/qwen3_tts/calibrate_entropy.py
@@ -0,0 +1,186 @@
+"""Calibrate the garble detector's entropy threshold on the deployed NPU path.
+
+The serving engine fails a segment attempt when the talker's code0 entropy, averaged over
+the last `entropy_window` frames, exceeds `entropy_threshold` (see detector.json). That
+statistic depends on the talker package and the NPU numerics, so it is calibrated by
+generating real segments with flm and labeling them by ASR.
+
+usage:
+  1. start flm with checks off and every segment recorded:
+       FLM_TTS_CALIBRATION_DIR=<dir> flm serve qwen3-tts:1.7b
+  2. calibrate_entropy.py generate --dir <dir> [--texts calib_entropy_texts.json] [--seeds 6]
+       speaks every text with each seed (the server segments them as in production); the
+       server writes <dir>/segments.jsonl (text, frames, per-frame entropy) and one WAV per
+       segment. Stop flm afterwards.
+  3. calibrate_entropy.py label --dir <dir> [--threads 8]
+       Whisper large-v3-turbo transcribes each segment; CER against its text ->
+       <dir>/labels.jsonl. Clean: CER < 0.25, failed: CER > 0.5, in between: unused.
+  4. calibrate_entropy.py fit --dir <dir> [--max-fp 0.0075]
+       per segment the maximum windowed mean entropy; picks the lowest threshold on a 0.1
+       grid whose false-positive rate on clean segments is <= --max-fp; prints the table;
+       writes <dir>/fit.json
+  5. calibrate_entropy.py write --dir <dir> --package <package_dir> [--update-default]
+       puts the threshold and the calibration record into <package_dir>/package.json
+       ("detector"); --update-default also updates detector.json next to this script, from
+       which future packages are built.
+
+Expect about 3 h of audio for 6 seeds (about 1800 segments, of which 2-3% fail): about 2 h
+of generation and 3 h of ASR on 8 CPU threads. Fewer than ~30 failed segments or ~400 clean
+ones give a noisy threshold.
+"""
+import argparse, datetime, json, sys, unicodedata, urllib.request
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+PUNCT = set("、。，．,.!?！？「」『』（）()・…ー〜~：:；;\"' 　")
+
+
+def norm(s):
+    return "".join(c for c in unicodedata.normalize("NFKC", s) if c not in PUNCT and not c.isspace())
+
+
+def edit(a, b):
+    prev = list(range(len(b) + 1))
+    for i in range(1, len(a) + 1):
+        cur = [i] + [0] * len(b)
+        for j in range(1, len(b) + 1):
+            cur[j] = min(prev[j - 1] + (a[i - 1] != b[j - 1]), prev[j] + 1, cur[j - 1] + 1)
+        prev = cur
+    return prev[-1]
+
+
+def segments(d):
+    return [json.loads(l) for l in open(d / "segments.jsonl", encoding="utf-8")]
+
+
+def cmd_generate(a):
+    texts = json.load(open(a.texts, encoding="utf-8"))
+    for seed in range(1, a.seeds + 1):
+        for t in texts:
+            body = {"input": t["text"], "voice": t.get("voice", a.voice), "language": t.get("language", ""),
+                    "seed": seed, "response_format": "pcm"}
+            req = urllib.request.Request(a.server + "/v1/audio/speech", data=json.dumps(body).encode(),
+                                         headers={"Content-Type": "application/json"})
+            with urllib.request.urlopen(req) as r:
+                r.read()
+            print(f"seed {seed} {t['id']}", flush=True)
+    print(f"{len(segments(a.dir))} segments recorded in {a.dir}")
+
+
+def cmd_label(a):
+    import soundfile as sf
+    import torch, torchaudio
+    from transformers import WhisperForConditionalGeneration, WhisperProcessor
+    torch.set_num_threads(a.threads)
+    proc = WhisperProcessor.from_pretrained(a.asr)
+    asr = WhisperForConditionalGeneration.from_pretrained(a.asr).eval()
+    out = a.dir / "labels.jsonl"
+    done = {json.loads(l)["id"] for l in open(out, encoding="utf-8")} if out.exists() else set()
+    with open(out, "a", encoding="utf-8") as f:
+        for s in segments(a.dir):
+            if s["id"] in done:
+                continue
+            x, sr = sf.read(a.dir / f"{s['id']}.wav", dtype="float32")
+            hyp = ""
+            for i in range(0, len(x), int(28 * sr)):   # Whisper windows are 30 s
+                y = torchaudio.functional.resample(torch.from_numpy(x[i: i + int(28 * sr)]), sr, 16000).numpy()
+                feats = proc(y, sampling_rate=16000, return_tensors="pt").input_features
+                with torch.no_grad():
+                    ids = asr.generate(feats, language=a.asr_language, task="transcribe", max_new_tokens=220)
+                hyp += proc.batch_decode(ids, skip_special_tokens=True)[0]
+            ref = norm(s["text"])
+            cer = edit(norm(hyp), ref) / max(1, len(ref))
+            f.write(json.dumps({"id": s["id"], "cer": cer, "hyp": hyp}, ensure_ascii=False) + "\n")
+            f.flush()
+            print(f"{s['id']} CER {cer:.2f}", flush=True)
+
+
+def cmd_fit(a):
+    import numpy as np
+    labels = {r["id"]: r["cer"] for r in map(json.loads, open(a.dir / "labels.jsonl", encoding="utf-8"))}
+    det = json.load(open(HERE / "detector.json"))
+    W = a.window or det["entropy_window"]
+    ok, bad = [], []
+    for s in segments(a.dir):
+        cer = labels.get(s["id"])
+        if cer is None or 0.25 <= cer <= 0.5:
+            continue
+        H = np.asarray(s["entropy"], dtype=np.float64)
+        wmax = float(np.convolve(H, np.ones(W) / W, mode="valid").max()) if len(H) >= W else 0.0
+        long_ = s["frames"] >= det["length_factor"] * det["frames_per_token"] * s["text_tokens"] + det["length_slack"]
+        (bad if cer > 0.5 else ok).append((wmax, long_ or s.get("capped", False)))
+    if not ok or not bad:
+        sys.exit("need clean and failed segments; label more data")
+    okw = np.array([w for w, _ in ok]); badw = np.array([w for w, _ in bad]); badl = np.array([l for _, l in bad])
+    print(f"segments: clean {len(ok)}, failed {len(bad)} (window {W} frames)")
+    print(f"clean max-window entropy: p50 {np.median(okw):.2f} p99 {np.percentile(okw, 99):.2f} max {okw.max():.2f}")
+    rows, pick = [], None
+    for thr in np.round(np.arange(1.0, 3.0001, 0.1), 2):
+        fp = float((okw > thr).mean())
+        caught = int((badw > thr).sum()); both = int(((badw > thr) | badl).sum())
+        rows.append({"threshold": float(thr), "false_positive_rate": fp, "caught": caught, "caught_with_length": both})
+        print(f"  {thr:.1f}: false positives {fp * 100:4.1f}% | failed caught {caught}/{len(bad)}, with length check {both}/{len(bad)}")
+        if pick is None and fp <= a.max_fp:
+            pick = rows[-1]
+    if pick is None:
+        sys.exit("no threshold meets --max-fp")
+    print(f"threshold {pick['threshold']} (false positives {pick['false_positive_rate'] * 100:.2f}%, "
+          f"caught {pick['caught']}/{len(bad)}, with length check {pick['caught_with_length']}/{len(bad)})")
+    fit = {"entropy_threshold": pick["threshold"], "entropy_window": W, "max_fp": a.max_fp,
+           "clean": len(ok), "failed": len(bad), "pick": pick, "table": rows,
+           "clean_p50": float(np.median(okw)), "clean_p99": float(np.percentile(okw, 99)), "clean_max": float(okw.max())}
+    json.dump(fit, open(a.dir / "fit.json", "w"), indent=1)
+
+
+def cmd_write(a):
+    fit = json.load(open(a.dir / "fit.json"))
+    seg0 = segments(a.dir)[0]
+    pkg_path = a.package / "package.json"
+    pkg = json.load(open(pkg_path, encoding="utf-8"))
+    det = pkg.get("detector") or json.load(open(HERE / "detector.json"))
+    det["entropy_threshold"] = fit["entropy_threshold"]
+    det["entropy_window"] = fit["entropy_window"]
+    p = fit["pick"]
+    det["calibration"] = {
+        "date": datetime.date.today().isoformat(),
+        "talker": a.talker_note or f"package {a.package.name} (talker sha256 in its build log)",
+        "path": f"NPU talker (fast dispatch), bf16 host heads, T={seg0['temperature']}, voice {seg0['voice']}",
+        "data": f"{fit['clean'] + fit['failed']} segments generated by flm in calibration mode, labeled by Whisper "
+                f"CER: {fit['clean']} clean (CER < 0.25), {fit['failed']} failed (CER > 0.5)",
+        "entropy": "recorded while generating (FLM_TTS_CALIBRATION_DIR)",
+        "false_positive_rate": round(p["false_positive_rate"], 4),
+        "failed_caught_by_entropy": f"{p['caught']}/{fit['failed']}",
+        "failed_caught_with_length_check": f"{p['caught_with_length']}/{fit['failed']}",
+        "clean_window_entropy": {"p50": round(fit["clean_p50"], 3), "p99": round(fit["clean_p99"], 3),
+                                 "max": round(fit["clean_max"], 3)},
+        "rule": f"lowest threshold on a 0.1 grid with false-positive rate <= {fit['max_fp']}",
+    }
+    pkg["detector"] = det
+    pkg_path.write_text(json.dumps(pkg, indent=2, ensure_ascii=False) + "\n")
+    print("updated", pkg_path)
+    if a.update_default:
+        (HERE / "detector.json").write_text(json.dumps(det, indent=2, ensure_ascii=False) + "\n")
+        print("updated", HERE / "detector.json")
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    g = sub.add_parser("generate"); g.add_argument("--dir", type=Path, required=True)
+    g.add_argument("--server", default="http://127.0.0.1:52625")
+    g.add_argument("--texts", default=str(HERE / "calib_entropy_texts.json"))
+    g.add_argument("--seeds", type=int, default=6); g.add_argument("--voice", default="ono_anna")
+    l = sub.add_parser("label"); l.add_argument("--dir", type=Path, required=True)
+    l.add_argument("--threads", type=int, default=8)
+    l.add_argument("--asr", default="openai/whisper-large-v3-turbo"); l.add_argument("--asr-language", default="ja")
+    f = sub.add_parser("fit"); f.add_argument("--dir", type=Path, required=True)
+    f.add_argument("--max-fp", type=float, default=0.0075); f.add_argument("--window", type=int, default=0)
+    w = sub.add_parser("write"); w.add_argument("--dir", type=Path, required=True)
+    w.add_argument("--package", type=Path, required=True); w.add_argument("--update-default", action="store_true")
+    w.add_argument("--talker-note", default="")
+    a = ap.parse_args()
+    {"generate": cmd_generate, "label": cmd_label, "fit": cmd_fit, "write": cmd_write}[a.cmd](a)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/src/tools/qwen3_tts/capture_calib.py b/src/tools/qwen3_tts/capture_calib.py
new file mode 100644
index 00000000..f8a73380
--- /dev/null
+++ b/src/tools/qwen3_tts/capture_calib.py
@@ -0,0 +1,82 @@
+"""Capture talker activation statistics from official TTS runs, for GPTQ / AWQ.
+
+usage: capture_calib.py <tts_dir> <out_dir> [--max-rows 4096] [--threads 8]
+
+Runs the official FP32 pipeline (default sampling, seed 7) on the sentences of
+calib_runs.json (disjoint from the evaluation sentences), with forward pre-hooks on
+every talker linear input:
+  attn : input of q/k/v_proj (after input_layernorm)            [2048]
+  o    : input of o_proj (attention output)                     [2048]
+  mlp  : input of gate/up_proj (after post_attention_layernorm) [2048]
+  down : input of down_proj (silu(gate) * up)                   [6144]
+For each, <out_dir>/<layer>.<input>.pt holds H = sum x x^T (fp32), n rows, and a
+reservoir sample of rows (fp16) for AWQ.
+"""
+import argparse
+import json
+import time
+from pathlib import Path
+
+import numpy as np
+import torch
+from qwen_tts import Qwen3TTSModel
+
+HERE = Path(__file__).resolve().parent
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("tts_dir")
+    ap.add_argument("out", type=Path)
+    ap.add_argument("--max-rows", type=int, default=4096)
+    ap.add_argument("--texts", type=Path, default=HERE / "calib_runs.json")
+    ap.add_argument("--threads", type=int, default=8)
+    a = ap.parse_args()
+    calib = json.loads(a.texts.read_text())
+    a.out.mkdir(parents=True, exist_ok=True)
+    torch.set_num_threads(a.threads)
+    torch.manual_seed(7)
+    tts = Qwen3TTSModel.from_pretrained(a.tts_dir, device_map="cpu", dtype=torch.float32)
+    rng = np.random.default_rng(0)
+    max_rows = a.max_rows
+
+    stats = {}
+
+    def make_hook(key, dim):
+        stats[key] = {"H": torch.zeros(dim, dim), "n": 0, "rows": [], "seen": 0}
+
+        def hook(mod, args):
+            x = args[0].detach().reshape(-1, dim).float()
+            st = stats[key]
+            st["H"].addmm_(x.T, x)
+            st["n"] += x.shape[0]
+            for r in x:  # reservoir sample of rows
+                st["seen"] += 1
+                if len(st["rows"]) < max_rows:
+                    st["rows"].append(r.half())
+                else:
+                    j = rng.integers(0, st["seen"])
+                    if j < max_rows:
+                        st["rows"][j] = r.half()
+        return hook
+
+    for l, layer in enumerate(tts.model.talker.model.layers):
+        at, mlp = layer.self_attn, layer.mlp
+        at.q_proj.register_forward_pre_hook(make_hook(f"{l}.attn", at.q_proj.in_features))
+        at.o_proj.register_forward_pre_hook(make_hook(f"{l}.o", at.o_proj.in_features))
+        mlp.gate_proj.register_forward_pre_hook(make_hook(f"{l}.mlp", mlp.gate_proj.in_features))
+        mlp.down_proj.register_forward_pre_hook(make_hook(f"{l}.down", mlp.down_proj.in_features))
+
+    t0 = time.time()
+    for i, (text, spk, lang) in enumerate(calib):
+        wavs, sr = tts.generate_custom_voice(text=text, speaker=spk, language=lang)
+        print(f"[{i + 1}/{len(calib)}] {len(wavs[0]) / sr:.1f}s audio, rows so far {stats['0.attn']['n']} "
+              f"({time.time() - t0:.0f}s)", flush=True)
+
+    for key, st in stats.items():
+        torch.save({"H": st["H"], "n": st["n"], "rows": torch.stack(st["rows"])}, a.out / f"{key}.pt")
+    print("saved", len(stats), "inputs to", a.out)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/src/tools/qwen3_tts/capture_tf.py b/src/tools/qwen3_tts/capture_tf.py
new file mode 100644
index 00000000..e00cc62d
--- /dev/null
+++ b/src/tools/qwen3_tts/capture_tf.py
@@ -0,0 +1,88 @@
+"""Add teacher-forced activation statistics to a calibration capture.
+
+usage: capture_tf.py <tts_dir> <traj_dir> <base_calib_dir> <out_dir> [--max-rows 4096] [--threads 8]
+
+For every <traj_dir>/codes/<sentence>_s<seed>.i32 (from gen_trajectories.py): rebuild the
+talker inputs (prefill + per-frame codec embedding sums + tts_pad), run the official FP32
+talker once over the whole sequence with input hooks, and add sum x x^T, n and a quarter
+of the rows (random) to the base capture (capture_calib.py). The row pool is then
+subsampled back to max_rows per input.
+"""
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+import torch
+from safetensors import safe_open
+from qwen_tts.core.models.configuration_qwen3_tts import Qwen3TTSConfig
+from qwen_tts.core.models.modeling_qwen3_tts import Qwen3TTSTalkerModel
+
+KEYS = {"attn": "self_attn.q_proj", "o": "self_attn.o_proj", "mlp": "mlp.gate_proj", "down": "mlp.down_proj"}
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    for name in ("tts_dir", "traj_dir", "base", "out"):
+        ap.add_argument(name, type=Path)
+    ap.add_argument("--max-rows", type=int, default=4096)
+    ap.add_argument("--threads", type=int, default=8)
+    a = ap.parse_args()
+    a.out.mkdir(parents=True, exist_ok=True)
+    torch.set_num_threads(a.threads)
+    cfg = Qwen3TTSConfig.from_pretrained(a.tts_dir).talker_config
+    cfg._attn_implementation = "eager"
+    model = Qwen3TTSTalkerModel(cfg).float().eval()
+    f = safe_open(a.tts_dir / "model.safetensors", "pt")
+    model.load_state_dict({k[len("talker.model."):]: f.get_tensor(k).float()
+                           for k in f.keys() if k.startswith("talker.model.")})
+    cp_emb = [f.get_tensor(f"talker.code_predictor.model.codec_embedding.{k}.weight").float() for k in range(15)]
+
+    stats = {}
+    for l in range(cfg.num_hidden_layers):
+        for k in KEYS:
+            stats[f"{l}.{k}"] = torch.load(a.base / f"{l}.{k}.pt")
+    rng = np.random.default_rng(1)
+    added = {key: [] for key in stats}
+
+    def make_hook(key):
+        def hook(mod, args):
+            x = args[0].detach().reshape(-1, args[0].shape[-1]).float()
+            stats[key]["H"].addmm_(x.T, x)
+            stats[key]["n"] += x.shape[0]
+            added[key].append(x[rng.permutation(x.shape[0])[: max(1, x.shape[0] // 4)]].half())
+        return hook
+
+    for l, layer in enumerate(model.layers):
+        for k, path in KEYS.items():
+            mod = layer
+            for part in path.split("."):
+                mod = getattr(mod, part)
+            mod.register_forward_pre_hook(make_hook(f"{l}.{k}"))
+
+    files = sorted((a.traj_dir / "codes").glob("*.i32"))
+    rows = 0
+    for i, cf in enumerate(files):
+        d = a.traj_dir / "prompts" / cf.name.split("_s")[0]
+        P = json.loads((d / "meta.json").read_text())["P"]
+        E = torch.from_numpy(np.fromfile(d / "prefill.f32", dtype=np.float32)).view(P, -1)
+        pad = torch.from_numpy(np.fromfile(d / "tts_pad.f32", dtype=np.float32))
+        codes = torch.from_numpy(np.fromfile(cf, dtype=np.int32).reshape(-1, 16)).long()
+        steps = [model.codec_embedding.weight[codes[:, 0]]] + [cp_emb[k][codes[:, k + 1]] for k in range(15)]
+        X = torch.cat([E, (sum(steps) + pad)[:-1]], 0)[None]   # inputs up to the last generated frame
+        with torch.no_grad():
+            model(inputs_embeds=X, use_cache=False)
+        rows += X.shape[1]
+        if (i + 1) % 20 == 0:
+            print(f"[{i + 1}/{len(files)}] rows added {rows}", flush=True)
+
+    for key, st in stats.items():
+        new = torch.cat(added[key]) if added[key] else st["rows"][:0]
+        pool = torch.cat([st["rows"], new])
+        keep = torch.from_numpy(rng.permutation(pool.shape[0])[:a.max_rows])
+        torch.save({"H": st["H"], "n": st["n"], "rows": pool[keep]}, a.out / f"{key}.pt")
+    print(f"done: {len(files)} trajectories, {rows} rows added; n(0.attn) = {stats['0.attn']['n']}")
+
+
+if __name__ == "__main__":
+    main()
