new file mode 100644
index 00000000..21d9b64c
--- /dev/null
+++ b/src/tools/qwen3_tts/gen_trajectories.py
@@ -0,0 +1,80 @@
+"""Generate FP32 talker trajectories with the official pipeline, for teacher-forced calibration.
+
+usage: gen_trajectories.py <tts_dir> <out_dir> [--seeds 3] [--threads 8]
+
+For every sentence of calib_trajectories.json and seed s in 0..seeds-1, runs the official
+FP32 pipeline (non-streaming text, default sampling from generation_config.json:
+T 0.9, top-k 50, repetition penalty 1.05, sub-talker T 0.9 / top-k 50) after
+torch.manual_seed(s). The audio decoder is skipped. Writes:
+  <out>/prompts/<id>/prefill.f32  [P, D] talker prefill inputs_embeds
+  <out>/prompts/<id>/tts_pad.f32  [D]    tts_pad_embed added to every decode-step input
+  <out>/prompts/<id>/meta.json    sentence, speaker, language, P, D
+  <out>/codes/<id>_s<s>.i32       [T, 16] generated codes (EOS frame excluded)
+Existing outputs are kept, so an interrupted run resumes where it stopped.
+"""
+import argparse
+import json
+import time
+from pathlib import Path
+
+import numpy as np
+import torch
+from qwen_tts import Qwen3TTSModel
+
+HERE = Path(__file__).resolve().parent
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("tts_dir")
+    ap.add_argument("out", type=Path)
+    ap.add_argument("--texts", type=Path, default=HERE / "calib_trajectories.json")
+    ap.add_argument("--seeds", type=int, default=3)
+    ap.add_argument("--threads", type=int, default=8)
+    a = ap.parse_args()
+    sentences = json.loads(a.texts.read_text())
+    torch.set_num_threads(a.threads)
+    tts = Qwen3TTSModel.from_pretrained(a.tts_dir, device_map="cpu", dtype=torch.float32)
+    talker = tts.model.talker
+    real_generate = talker.generate
+    cap = {}
+
+    def grab_generate(**kw):
+        cap["prefill"] = kw["inputs_embeds"][0].float().numpy()
+        cap["pad"] = kw["tts_pad_embed"].reshape(-1).float().numpy()
+        return real_generate(**kw)
+
+    def grab_decode(items, *args, **kw):  # keep the codes, skip the audio decoder
+        cap["codes"] = items[0]["audio_codes"].cpu().numpy().astype(np.int32)
+        return [np.zeros(1, dtype=np.float32)], 24000
+
+    talker.generate = grab_generate
+    tts.model.speech_tokenizer.decode = grab_decode
+    (a.out / "codes").mkdir(parents=True, exist_ok=True)
+    t0, frames = time.time(), 0
+    for sid, text, speaker, lang in sentences:
+        pd = a.out / "prompts" / sid
+        for seed in range(a.seeds):
+            cf = a.out / "codes" / f"{sid}_s{seed}.i32"
+            if cf.exists() and (pd / "meta.json").exists():
+                continue
+            torch.manual_seed(seed)
+            tts.generate_custom_voice(text=text, speaker=speaker, language=lang, non_streaming_mode=True)
+            if not (pd / "meta.json").exists():
+                pd.mkdir(parents=True, exist_ok=True)
+                cap["prefill"].astype(np.float32).tofile(pd / "prefill.f32")
+                cap["pad"].astype(np.float32).tofile(pd / "tts_pad.f32")
+                P, D = cap["prefill"].shape
+                (pd / "meta.json").write_text(json.dumps(
+                    {"id": sid, "text": text, "speaker": speaker, "language": lang, "P": P, "D": D},
+                    ensure_ascii=False, indent=1))
+            tmp = cf.with_suffix(".tmp")
+            cap["codes"].tofile(tmp)
+            tmp.rename(cf)
+            frames += cap["codes"].shape[0]
+            print(f"{sid} s{seed}: {cap['codes'].shape[0]} frames ({time.time() - t0:.0f}s)", flush=True)
+    print(f"done: {len(sentences)} sentences x {a.seeds} seeds, {frames} new frames")
+
+
+if __name__ == "__main__":
+    main()
