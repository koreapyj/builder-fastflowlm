+"""Write package.json, the provenance record of a Qwen3-TTS NPU model package.
+
+usage: write_package_json.py <tts_dir> <package_dir> [--repo Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice]
+                             [--revision <commit>] [--sha256 <model.safetensors sha256>]
+                             [--detector detector.json]
+
+--sha256 skips hashing the 3.8 GB checkpoint when the caller already has the digest.
+The garble detector's settings (with their reason and calibration record) come from
+detector.json next to this script; flm reads them from package.json at load.
+calibrate_entropy.py replaces them after a recalibration.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+TOOLS_VERSION = "1"
+
+
+def sha256(path, chunk=1 << 24):
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        while b := f.read(chunk):
+            h.update(b)
+    return h.hexdigest()
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("tts_dir", type=Path)
+    ap.add_argument("package_dir", type=Path)
+    ap.add_argument("--repo", default="Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice")
+    ap.add_argument("--revision", default=None)
+    ap.add_argument("--sha256", default=None)
+    ap.add_argument("--detector", type=Path, default=Path(__file__).resolve().parent / "detector.json")
+    a = ap.parse_args()
+    source = {"repo": a.repo}
+    if a.revision:
+        source["revision"] = a.revision
+    source["model_safetensors_sha256"] = a.sha256 or sha256(a.tts_dir / "model.safetensors")
+    pkg = {"format": 1, "source": source, "talker_quant": "awq_gptq", "tools_version": TOOLS_VERSION,
+           "detector": json.loads(a.detector.read_text())}
+    (a.package_dir / "package.json").write_text(json.dumps(pkg, indent=2, ensure_ascii=False) + "\n")
+    print("wrote", a.package_dir / "package.json")
+
+
+if __name__ == "__main__":
+    main()
