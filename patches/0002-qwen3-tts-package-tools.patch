+#!/usr/bin/env bash
+# Build the Qwen3-TTS-12Hz-1.7B-CustomVoice NPU model package for FastFlowLM.
+#
+# usage: build_package.sh <hf_model_dir> <out_package_dir> [--threads N] [--work DIR]
+#   hf_model_dir     local snapshot of Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice (see README.md)
+#   out_package_dir  e.g. $FLM_MODEL_PATH/<model_path>/Qwen3-TTS-12Hz-1.7B-CustomVoice-NPU2
+#   --threads N      CPU threads for torch (default 8); outputs are bit-reproducible for a
+#                    fixed thread count, CPU and requirements.txt environment
+#   --work DIR       intermediates (calibration statistics, ~15 GB; default <out>.work)
+# environment:
+#   PYTHON    interpreter with requirements.txt installed (default: python3)
+#   CPU_LIST  optional taskset CPU list to pin every step to (e.g. 8-15)
+#
+# Nothing is downloaded. Every step writes to a temporary name and records a marker in
+# <work>/done/ when it finishes, so an interrupted build resumes at the first unfinished step.
+set -euo pipefail
+
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+KNOWN_SHA256=38b1d5971bdbd982b561cccec982669a53b0537c3cf5e9bd4778ed07bb2f5137
+KNOWN_REVISION=0c0e3051f131929182e2c023b9537f8b1c68adfe
+REPO=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
+
+usage() { sed -n '4,12p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 2; }
+[ $# -ge 2 ] || usage
+HF="$(cd "$1" && pwd)"
+OUT="$2"
+shift 2
+THREADS=8
+WORK=""
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --threads) THREADS="$2"; shift 2 ;;
+        --work) WORK="$2"; shift 2 ;;
+        *) usage ;;
+    esac
+done
+mkdir -p "$OUT"
+OUT="$(cd "$OUT" && pwd)"
+WORK="${WORK:-$OUT.work}"
+mkdir -p "$WORK/done"
+WORK="$(cd "$WORK" && pwd)"
+
+PYTHON="${PYTHON:-python3}"
+export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
+export OMP_NUM_THREADS="$THREADS" MKL_NUM_THREADS="$THREADS"
+PIN=()
+[ -n "${CPU_LIST:-}" ] && PIN=(taskset -c "$CPU_LIST")
+py() { "${PIN[@]}" "$PYTHON" -I "$@"; }
+
+for f in config.json generation_config.json model.safetensors vocab.json merges.txt tokenizer_config.json \
+         speech_tokenizer/config.json speech_tokenizer/model.safetensors; do
+    [ -f "$HF/$f" ] || { echo "missing $HF/$f" >&2; exit 1; }
+done
+
+# step <name> <command...>: run once, record wall time
+step() {
+    local name="$1"; shift
+    if [ -f "$WORK/done/$name" ]; then
+        echo "== $name: done ($(cat "$WORK/done/$name"))"
+        return
+    fi
+    echo "== $name"
+    local t0=$SECONDS
+    "$@"
+    echo "$((SECONDS - t0)) s" > "$WORK/done/$name"
+    echo "== $name: $((SECONDS - t0)) s"
+}
+
+s_checkpoint() {
+    sha256sum "$HF/model.safetensors" | cut -d' ' -f1 > "$WORK/model.sha256.tmp"
+    mv "$WORK/model.sha256.tmp" "$WORK/model.sha256"
+    if [ "$(cat "$WORK/model.sha256")" != "$KNOWN_SHA256" ]; then
+        echo "warning: model.safetensors is not $REPO@$KNOWN_REVISION; continuing" >&2
+    fi
+}
+
+# original HF config plus the minimum FLM version that can load the package (flm reads
+# flm_version from every model's config.json)
+s_config() {
+  "$PYTHON" -I -c 'import json, sys; c = json.load(open(sys.argv[1])); c["flm_version"] = sys.argv[3]
+json.dump(c, open(sys.argv[2], "w"), indent=2, ensure_ascii=False)' "$HF/config.json" "$OUT/config.json.tmp" 1.0.9 \
+    && mv "$OUT/config.json.tmp" "$OUT/config.json"
+}
+
+s_tokenizer() { py "$HERE/export_tokenizer.py" "$HF" "$OUT/tokenizer.json"; }
+
+s_host() {
+    py "$HERE/trim_host.py" "$HF" "$OUT/host.safetensors.tmp"
+    mv "$OUT/host.safetensors.tmp" "$OUT/host.safetensors"
+}
+
+s_speech_tokenizer() {
+    cp "$HF/speech_tokenizer/model.safetensors" "$OUT/speech_tokenizer.safetensors.tmp"
+    mv "$OUT/speech_tokenizer.safetensors.tmp" "$OUT/speech_tokenizer.safetensors"
+}
+
+# packaged engine models are built under <work> and moved into <out> when complete
+s_predictor() {
+    rm -rf "$WORK/predictor" "$OUT/Qwen3-0.6B-NPU2"
+    py "$HERE/make_predictor.py" "$HF" "$WORK/predictor/Qwen3-0.6B-NPU2" --threads "$THREADS"
+    mv "$WORK/predictor/Qwen3-0.6B-NPU2" "$OUT/" && rmdir "$WORK/predictor"
+}
+
+s_calib_runs() {
+    rm -rf "$WORK/calib_runs.tmp"
+    py "$HERE/capture_calib.py" "$HF" "$WORK/calib_runs.tmp" --threads "$THREADS"
+    rm -rf "$WORK/calib_runs" && mv "$WORK/calib_runs.tmp" "$WORK/calib_runs"
+}
+
+# resumable internally: finished trajectories are kept
+s_trajectories() { py "$HERE/gen_trajectories.py" "$HF" "$WORK/trajectories" --threads "$THREADS"; }
+
+s_calib_tf() {
+    rm -rf "$WORK/calib_all.tmp"
+    py "$HERE/capture_tf.py" "$HF" "$WORK/trajectories" "$WORK/calib_runs" "$WORK/calib_all.tmp" --threads "$THREADS"
+    rm -rf "$WORK/calib_all" && mv "$WORK/calib_all.tmp" "$WORK/calib_all"
+}
+
+s_talker() {
+    rm -rf "$WORK/talker" "$OUT/Qwen3-1.7B-NPU2"
+    py "$HERE/quantize_talker.py" "$HF" "$WORK/calib_all" "$WORK/talker/Qwen3-1.7B-NPU2" --threads "$THREADS"
+    mv "$WORK/talker/Qwen3-1.7B-NPU2" "$OUT/" && rmdir "$WORK/talker"
+}
+
+s_package_json() {
+    local sha rev=()
+    sha="$(cat "$WORK/model.sha256")"
+    [ "$sha" = "$KNOWN_SHA256" ] && rev=(--revision "$KNOWN_REVISION")
+    py "$HERE/write_package_json.py" "$HF" "$OUT" --repo "$REPO" "${rev[@]}" --sha256 "$sha"
+}
+
+step checkpoint s_checkpoint
+step config s_config
+step tokenizer s_tokenizer
+step host s_host
+step speech_tokenizer s_speech_tokenizer
+step predictor s_predictor
+step calib_runs s_calib_runs
+step trajectories s_trajectories
+step calib_tf s_calib_tf
+step talker s_talker
+step package_json s_package_json
+
+echo "== package $OUT"
+(cd "$OUT" && find . -type f ! -name '*.tmp' | sort | xargs sha256sum)
