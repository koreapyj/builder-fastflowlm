index 00000000..082d324d
--- /dev/null
+++ b/src/tools/qwen3_tts/make_predictor.py
@@ -0,0 +1,55 @@
+"""Package the Qwen3-TTS code predictor as a stock Qwen3 Q4NX model for the qwen3_npu engine.
+
+usage: make_predictor.py <tts_dir> <out_model_dir>
+  out_model_dir must end in Qwen3-0.6B-NPU2 (the engine picks xclbins by folder name)
+
+talker.code_predictor.model.* has Qwen3-0.6B shapes with 5 layers. Linears are min/max
+quantized to Q4NX; norms stay BF16.
+  embed_tokens: zero scratch rows; the runtime injects each input embedding into one
+  lm_head:      identity, so the engine returns the final normed hidden state
+"""
+import argparse
+import json
+import sys
+from pathlib import Path
+
+import torch
+from safetensors import safe_open
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE))
+import q4nx  # noqa: E402
+
+PREFIX = "talker.code_predictor.model."
+VOCAB = 151936   # engine vocab; must stay the stock size, identity fills the first D rows
+QUANT = ("q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj")
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("tts_dir", type=Path)
+    ap.add_argument("out", type=Path)
+    ap.add_argument("--threads", type=int, default=8)
+    a = ap.parse_args()
+    assert a.out.name == "Qwen3-0.6B-NPU2", a.out
+    torch.set_num_threads(a.threads)
+    a.out.mkdir(parents=True, exist_ok=True)
+    sub = json.loads((a.tts_dir / "config.json").read_text())["talker_config"]["code_predictor_config"]
+    D = sub["hidden_size"]
+
+    tensors = {"model.embed_tokens.weight": torch.zeros(VOCAB, D)}
+    with safe_open(a.tts_dir / "model.safetensors", "pt") as f:
+        for k in sorted(f.keys()):
+            if not (k.startswith(PREFIX + "layers.") or k == PREFIX + "norm.weight"):
+                continue
+            name = "model." + k[len(PREFIX):]
+            t = f.get_tensor(k)
+            tensors[name] = q4nx.quantize(t) if any(p in name for p in QUANT) else t
+    tensors["lm_head.weight"] = q4nx.identity_head(VOCAB, D)
+    q4nx.write(a.out / "model.q4nx", tensors)
+    q4nx.write_config(HERE / "configs/Qwen3-0.6B-NPU2.json", sub, VOCAB, a.out / "config.json")
+    print("wrote", a.out, len(tensors), "tensors")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/src/tools/qwen3_tts/q4nx.py b/src/tools/qwen3_tts/q4nx.py
new file mode 100644
index 00000000..f9da2b1e
--- /dev/null
+++ b/src/tools/qwen3_tts/q4nx.py
@@ -0,0 +1,124 @@
+"""Writer for FastFlowLM's Q4NX format, plus the engine config.json for a packaged model.
+
+A quantized [rows, cols] matrix is split into 32x256 tiles, stored row-block-major as
+I8 [n_tiles, 5120]. Each tile:
+  bytes    0..511   bf16 scale S[g*32 + r]   (g = 32-col group 0..7, r = row 0..31)
+  bytes  512..1023  bf16 offset M[g*32 + r]
+  bytes 1024..5119  codes: byte[(h*256 + c)*8 + t], low nibble -> row h*16+2t, high -> row h*16+2t+1
+  w = q * S + M   (q in 0..15; the NPU kernels use this offset form, not (q - Z) * S)
+
+The container is safetensors-shaped: u64 header length, JSON header, raw tensor data.
+Non-quantized tensors are stored BF16.
+"""
+import json
+import struct
+from pathlib import Path
+
+import numpy as np
+import torch
+
+TILE_R, TILE_C, GROUP = 32, 256, 32
+
+# config.json fields taken from the TTS sub-model; everything else comes from the stock template
+ARCH_KEYS = ("hidden_size", "intermediate_size", "num_hidden_layers", "num_attention_heads",
+             "num_key_value_heads", "head_dim", "rms_norm_eps", "rope_theta")
+
+
+def quantize(w: torch.Tensor, fixed_scale: float = None) -> np.ndarray:
+    """min/max quantization: [rows, cols] float -> uint8 [n_tiles, 5120]
+
+    fixed_scale: use this scale with offset 0 everywhere, for matrices whose
+    entries are exact multiples of it (the identity lm_head uses 0.125).
+    """
+    w = w.float()
+    rows, cols = w.shape
+    assert rows % TILE_R == 0 and cols % TILE_C == 0, (rows, cols)
+    g = w.view(rows, cols // GROUP, GROUP)
+    if fixed_scale is not None:
+        s = torch.full(g.shape[:2], fixed_scale)
+        m = torch.zeros(g.shape[:2])
+    else:
+        lo = g.amin(-1)
+        hi = g.amax(-1)
+        s = ((hi - lo) / 15).clamp(min=1e-8).to(torch.bfloat16).float()
+        m = lo.to(torch.bfloat16).float()
+    q = torch.round((g - m[..., None]) / s[..., None]).clamp(0, 15).to(torch.uint8).view(rows, cols)
+    return pack(q, s, m)
+
+
+def pack(q: torch.Tensor, s: torch.Tensor, m: torch.Tensor) -> np.ndarray:
+    """codes q uint8 [rows, cols] in 0..15, scale s and offset m [rows, cols/32] -> tiles.
+    w = q * s + m; s and m are stored as bf16 (round them before choosing q)."""
+    rows, cols = q.shape
+    rb, cb = rows // TILE_R, cols // TILE_C
+
+    def tile_sz(x):  # [rows, cols/32] -> [rb, cb, g(8), r(32)]
+        x = x.to(torch.bfloat16).view(rb, TILE_R, cb, TILE_C // GROUP)
+        return x.permute(0, 2, 3, 1).contiguous().view(torch.int16).numpy().view(np.uint8).reshape(rb, cb, 512)
+
+    S, M = tile_sz(s), tile_sz(m)
+    # codes: [rows, cols] -> [rb, cb, h(2), c(256), t(8), pair(2)]
+    qt = q.view(rb, 2, 8, 2, cb, TILE_C).permute(0, 4, 1, 5, 2, 3).contiguous()
+    codes = (qt[..., 0] | (qt[..., 1] << 4)).numpy().reshape(rb, cb, 4096)
+    return np.concatenate([S, M, codes], axis=-1).reshape(rb * cb, 5120)
+
+
+def dequantize(t: np.ndarray, rows: int, cols: int) -> torch.Tensor:
+    """tiles -> [rows, cols] fp32 (inverse of pack; for verifying packages)"""
+    rb, cb = rows // TILE_R, cols // TILE_C
+    t = t.reshape(rb, cb, 5120)
+
+    def untile_sz(x):
+        x = torch.from_numpy(np.ascontiguousarray(x)).view(torch.bfloat16).float().view(rb, cb, 8, 32)
+        return x.permute(0, 3, 1, 2).reshape(rows, cols // GROUP)
+
+    S, M = untile_sz(t[..., :512]), untile_sz(t[..., 512:1024])
+    c = torch.from_numpy(np.ascontiguousarray(t[..., 1024:])).view(rb, cb, 2, TILE_C, 8)
+    q = torch.stack([c & 15, c >> 4], -1).permute(0, 2, 4, 5, 1, 3).reshape(rows, cols).float()
+    return (q.view(rows, cols // GROUP, GROUP) * S[..., None] + M[..., None]).view(rows, cols)
+
+
+def identity_head(vocab: int, dim: int) -> np.ndarray:
+    """lm_head = identity in the first dim rows, so the engine's logits are the final normed hidden state"""
+    return quantize(torch.eye(vocab, dim), fixed_scale=0.125)
+
+
+def write(path, tensors: dict):
+    """tensors: name -> torch.Tensor (stored bf16) or np.uint8 array (stored I8), in file order"""
+    header, blobs, off = {}, [], 0
+    for name, t in tensors.items():
+        if isinstance(t, np.ndarray):
+            raw, dtype, shape = t.tobytes(), "I8", list(t.shape)
+        else:
+            t = t.to(torch.bfloat16).contiguous()
+            raw, dtype, shape = t.view(torch.int16).numpy().tobytes(), "BF16", list(t.shape)
+        header[name] = {"dtype": dtype, "shape": shape, "data_offsets": [off, off + len(raw)]}
+        blobs.append(raw)
+        off += len(raw)
+    h = json.dumps(header, separators=(",", ":")).encode()
+    h += b" " * ((8 - len(h) % 8) % 8)
+    with open(path, "wb") as f:
+        f.write(struct.pack("<Q", len(h)))
+        f.write(h)
+        for b in blobs:
+            f.write(b)
+
+
+def read(path) -> dict:
+    """model.q4nx -> name -> (dtype, shape, raw np.uint8 bytes); for verifying packages"""
+    with open(path, "rb") as f:
+        n = struct.unpack("<Q", f.read(8))[0]
+        header = json.loads(f.read(n))
+        data = np.fromfile(f, dtype=np.uint8)
+    return {k: (v["dtype"], v["shape"], data[v["data_offsets"][0]:v["data_offsets"][1]]) for k, v in header.items()}
+
+
+def write_config(template: Path, sub_cfg: dict, vocab: int, out: Path):
+    """stock engine config.json with the architecture fields of the TTS sub-model"""
+    cfg = json.loads(Path(template).read_text())
+    for k in ARCH_KEYS:
+        if cfg.get(k) != sub_cfg.get(k):
+            print(f"config {k}: {cfg.get(k)} -> {sub_cfg[k]}")
+            cfg[k] = sub_cfg[k]
+    cfg["vocab_size"] = vocab
+    Path(out).write_text(json.dumps(cfg, indent=2))
diff --git a/src/tools/qwen3_tts/quantize_talker.py b/src/tools/qwen3_tts/quantize_talker.py
