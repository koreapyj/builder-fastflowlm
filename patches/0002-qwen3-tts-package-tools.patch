new file mode 100644
index 00000000..2ca9fd5f
--- /dev/null
+++ b/src/tools/qwen3_tts/export_tokenizer.py
@@ -0,0 +1,74 @@
+"""Export the Qwen3-TTS text tokenizer as a single HF `tokenizers` tokenizer.json.
+
+usage: export_tokenizer.py <tts_dir> <out/tokenizer.json>
+
+The HF checkpoint ships vocab.json + merges.txt + tokenizer_config.json only. This loads the
+tokenizer exactly as qwen_tts does (AutoProcessor, fix_mistral_regex=True) and saves its
+fast backend. Note: with that flag and the checkpoint's transformers_version (4.57.3),
+transformers replaces the Qwen2 pre-tokenizer regex with the corrected Mistral one, so
+the official pipeline splits English contractions / case runs differently from a plain
+AutoTokenizer; the export follows the official pipeline.
+
+The written file is re-loaded with the `tokenizers` library (the same Rust crate as
+tokenizers-cpp) and must encode the calibration sentences, mixed-script probes and the
+assistant prompt template identically to the official tokenizer.
+"""
+import argparse
+import json
+from pathlib import Path
+
+from tokenizers import Tokenizer
+from transformers import AutoConfig, AutoProcessor, AutoTokenizer
+from qwen_tts.core.models.configuration_qwen3_tts import Qwen3TTSConfig
+from qwen_tts.core.models.processing_qwen3_tts import Qwen3TTSProcessor
+
+HERE = Path(__file__).resolve().parent
+PROBES = [
+    "Hello! This is a quick test of text to speech running on the NPU.",
+    "I'm sure it's fine, don't WORRY. They'll say we've done it; HelloWorld OK'S",
+    "こんにちは。今日はとてもいい天気ですね。",
+    "令和七年三月十五日、約二千五百人が参加し、売上高は前年比百十二パーセントに達しました。",
+    "このNPUで I'll test 123,456円! ＡＢＣ　全角 and emoji 🎉 tabs\tand\nnewlines\r\n",
+    "안녕하세요. 오늘 날씨가 정말 좋네요.",
+]
+
+
+def official_tokenizer(tts_dir):
+    AutoConfig.register("qwen3_tts", Qwen3TTSConfig)
+    AutoProcessor.register(Qwen3TTSConfig, Qwen3TTSProcessor)
+    return AutoProcessor.from_pretrained(tts_dir, fix_mistral_regex=True).tokenizer
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("tts_dir")
+    ap.add_argument("out", type=Path)
+    a = ap.parse_args()
+    tok = official_tokenizer(a.tts_dir)
+    tmp = a.out.with_suffix(".tmp")
+    tok.backend_tokenizer.save(str(tmp), pretty=True)
+
+    texts = list(PROBES)
+    for name in ("calib_runs.json", "calib_trajectories.json"):
+        texts += [row[-3] for row in json.loads((HERE / name).read_text())]
+    texts += [f"<|im_start|>assistant\n{t}<|im_end|>\n<|im_start|>assistant\n" for t in texts]
+    exported = Tokenizer.from_file(str(tmp))
+    plain = AutoTokenizer.from_pretrained(a.tts_dir)
+    bad, plain_diff = 0, 0
+    for t in texts:
+        ref = tok(t)["input_ids"]
+        got = exported.encode(t).ids
+        if got != ref:
+            bad += 1
+            print("MISMATCH", repr(t[:60]), ref[:12], got[:12])
+        plain_diff += plain(t)["input_ids"] != ref
+    print(f"checked {len(texts)} strings: {bad} mismatches vs the official tokenizer "
+          f"({plain_diff} differ between plain AutoTokenizer and the official tokenizer)")
+    if bad:
+        raise SystemExit(1)
+    tmp.rename(a.out)
+    print("wrote", a.out)
+
+
+if __name__ == "__main__":
+    main()
