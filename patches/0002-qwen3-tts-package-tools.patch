--- /dev/null
+++ b/src/tools/qwen3_tts/quantize_talker.py
@@ -0,0 +1,197 @@
+"""Quantize the Qwen3-TTS talker to Q4NX with AWQ + GPTQ, as a stock Qwen3-1.7B model.
+
+usage: quantize_talker.py <tts_dir> <calib_dir> <out_model_dir> [--threads 8]
+  calib_dir: activation statistics from capture_calib.py + capture_tf.py
+  out_model_dir must end in Qwen3-1.7B-NPU2 (the engine picks xclbins by folder name)
+
+Q4NX group = 32 consecutive input features of one output row, asymmetric:
+w = q * S + M, q in 0..15, S/M bf16.
+  AWQ:  per-input-channel scales for q/k/v (folded into input_layernorm), gate/up
+        (folded into post_attention_layernorm), down (folded into up_proj) and o
+        (folded into v_proj, one scale per v channel shared by its query heads)
+  GPTQ: column-wise error feedback on the scaled weights with the calibration Hessian;
+        each group's (S, M) is a weighted-MSE clipping search on the updated weights
+embed_tokens is zero scratch rows (inputs are injected at run time); lm_head is identity.
+"""
+import argparse
+import json
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+import torch
+from safetensors import safe_open
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE))
+import q4nx  # noqa: E402
+
+G = 32
+VOCAB = 151936
+LINEARS = {"attn": ["q_proj", "k_proj", "v_proj"], "o": ["o_proj"], "mlp": ["gate_proj", "up_proj"], "down": ["down_proj"]}
+PARENT = {"q_proj": "self_attn", "k_proj": "self_attn", "v_proj": "self_attn", "o_proj": "self_attn",
+          "gate_proj": "mlp", "up_proj": "mlp", "down_proj": "mlp"}
+SHRINK = torch.tensor([1.0, 0.95, 0.9, 0.85, 0.8, 0.75, 0.7])
+
+
+def bf16(x):
+    return x.to(torch.bfloat16).float()
+
+
+def fit_groups(W, imp=None, search=True):
+    """W [N, K] -> (q uint8 [N, K], s [N, K/G], m [N, K/G]); weighted-MSE search over clipping."""
+    N, K = W.shape
+    g = W.view(N, K // G, G)
+    lo, hi = g.amin(-1), g.amax(-1)
+    w8 = None if imp is None else imp.view(1, K // G, G)
+    best_err = torch.full((N, K // G), float("inf"))
+    best_s, best_m = torch.zeros(N, K // G), torch.zeros(N, K // G)
+    cands = [(a, b) for a in SHRINK for b in SHRINK] if search else [(1.0, 1.0)]
+    for a, b in cands:
+        l, h = lo * a, hi * b
+        s = bf16(((h - l) / 15).clamp(min=1e-10))
+        m = bf16(l)
+        q = torch.round((g - m[..., None]) / s[..., None]).clamp(0, 15)
+        e = (q * s[..., None] + m[..., None] - g) ** 2
+        err = (e * w8).sum(-1) if w8 is not None else e.sum(-1)
+        better = err < best_err
+        best_err = torch.where(better, err, best_err)
+        best_s = torch.where(better, s, best_s)
+        best_m = torch.where(better, m, best_m)
+    q = torch.round((g - best_m[..., None]) / best_s[..., None]).clamp(0, 15).to(torch.uint8).view(N, K)
+    return q, best_s, best_m
+
+
+def dequant(q, s, m):
+    N, K = q.shape
+    return (q.view(N, K // G, G).float() * s[..., None] + m[..., None]).view(N, K)
+
+
+def gptq(W, H, search=True, block=128, damp=0.01):
+    """GPTQ with 32-column groups whose (S, M) are fit on the error-updated weights."""
+    W = W.clone()
+    N, K = W.shape
+    H = H.clone()
+    dead = torch.diag(H) == 0
+    H[dead, dead] = 1
+    W[:, dead] = 0
+    H += damp * torch.mean(torch.diag(H)) * torch.eye(K)
+    Hinv = torch.linalg.cholesky(torch.cholesky_inverse(torch.linalg.cholesky(H)), upper=True)
+    imp = torch.diag(H)
+    Q = torch.zeros(N, K, dtype=torch.uint8)
+    S = torch.zeros(N, K // G)
+    M = torch.zeros(N, K // G)
+    for i1 in range(0, K, block):
+        i2 = min(i1 + block, K)
+        W1 = W[:, i1:i2].clone()
+        Err1 = torch.zeros_like(W1)
+        Hinv1 = Hinv[i1:i2, i1:i2]
+        for i in range(i2 - i1):
+            col = i1 + i
+            if col % G == 0:
+                _, s, m = fit_groups(W1[:, i:i + G], imp[col:col + G], search)
+                S[:, col // G], M[:, col // G] = s[:, 0], m[:, 0]
+            s, m = S[:, col // G], M[:, col // G]
+            w = W1[:, i]
+            q = torch.round((w - m) / s).clamp(0, 15)
+            Q[:, col] = q.to(torch.uint8)
+            err = (w - (q * s + m)) / Hinv1[i, i]
+            W1[:, i:] -= err[:, None] * Hinv1[i, i:][None, :]
+            Err1[:, i] = err
+        W[:, i2:] -= Err1 @ Hinv[i1:i2, i2:]
+    return Q, S, M
+
+
+def awq_scale(X, Ws, alphas=np.linspace(0, 1, 21), rows=2048):
+    """per-input-channel scales s minimizing ||X W^T - (X/s) Q(W s)^T|| over the group's linears"""
+    X = X[:rows].float()
+    xm = X.abs().mean(0).clamp(min=1e-6)
+    Wcat = torch.cat(Ws, 0)
+    Y = X @ Wcat.T
+    best, best_s, best_a = float("inf"), torch.ones_like(xm), 0.0
+    for a in alphas:
+        s = xm.pow(float(a))
+        s = s / (s.max() * s.min()).sqrt()
+        Wq = dequant(*fit_groups(Wcat * s[None, :], search=False))
+        loss = ((X / s) @ Wq.T - Y).pow(2).mean().item()
+        if loss < best:
+            best, best_s, best_a = loss, s, float(a)
+    return best_s, best_a
+
+
+def quantize_layer(get, calib, l, nh, nkv, hd):
+    """-> ({linear name: (q, s, m)}, {norm name: folded fp32 weight}) for talker layer l"""
+    p = f"talker.model.layers.{l}."
+    W = {n: get(p + f"{PARENT[n]}.{n}.weight") for n in PARENT}
+    ln1, ln2 = get(p + "input_layernorm.weight"), get(p + "post_attention_layernorm.weight")
+    st = {k: torch.load(calib / f"{l}.{k}.pt") for k in LINEARS}
+    Hs = {k: st[k]["H"] / st[k]["n"] for k in LINEARS}
+
+    s_attn, a1 = awq_scale(st["attn"]["rows"], [W["q_proj"], W["k_proj"], W["v_proj"]])
+    s_mlp, a2 = awq_scale(st["mlp"]["rows"], [W["gate_proj"], W["up_proj"]])
+    s_down, a3 = awq_scale(st["down"]["rows"], [W["down_proj"]])
+    s_o, a4 = awq_scale(st["o"]["rows"], [W["o_proj"]])
+    # o's input channel (q head h, dim d) comes from v head h // (nh/nkv): tie the pair
+    so = s_o.view(nkv, nh // nkv, hd).log().mean(1).exp()       # [nkv, hd]
+    s_o = so[:, None, :].expand(nkv, nh // nkv, hd).reshape(-1)
+    for n in ("q_proj", "k_proj", "v_proj"):
+        W[n] = W[n] * s_attn[None, :]
+    ln1 = ln1 / s_attn
+    for n in ("gate_proj", "up_proj"):
+        W[n] = W[n] * s_mlp[None, :]
+    ln2 = ln2 / s_mlp
+    W["down_proj"] = W["down_proj"] * s_down[None, :]
+    W["up_proj"] = W["up_proj"] / s_down[:, None]
+    W["o_proj"] = W["o_proj"] * s_o[None, :]
+    W["v_proj"] = W["v_proj"] / so.reshape(-1)[:, None]
+    scale = {"attn": s_attn, "mlp": s_mlp, "down": s_down, "o": s_o}
+    Hs = {k: Hs[k] / scale[k][:, None] / scale[k][None, :] for k in Hs}
+    if l % 7 == 0:
+        print(f"  layer {l} awq alphas attn {a1:.2f} mlp {a2:.2f} down {a3:.2f} o {a4:.2f}", flush=True)
+
+    quant = {}
+    for key, names in LINEARS.items():
+        for n in names:
+            quant[f"{PARENT[n]}.{n}.weight"] = gptq(W[n], Hs[key])
+    return quant, {"input_layernorm.weight": ln1, "post_attention_layernorm.weight": ln2}
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("tts_dir", type=Path)
+    ap.add_argument("calib", type=Path)
+    ap.add_argument("out", type=Path)
+    ap.add_argument("--threads", type=int, default=8)
+    a = ap.parse_args()
+    assert a.out.name == "Qwen3-1.7B-NPU2", a.out
+    torch.set_num_threads(a.threads)
+    sub = json.loads((a.tts_dir / "config.json").read_text())["talker_config"]
+    L, D = sub["num_hidden_layers"], sub["hidden_size"]
+    nh, nkv, hd = sub["num_attention_heads"], sub["num_key_value_heads"], sub["head_dim"]
+    f = safe_open(a.tts_dir / "model.safetensors", "pt")
+    get = lambda k: f.get_tensor(k).float()  # noqa: E731
+
+    tensors = {"model.embed_tokens.weight": torch.zeros(VOCAB, D)}
+    t0 = time.time()
+    for l in range(L):
+        quant, norms = quantize_layer(get, a.calib, l, nh, nkv, hd)
+        p = f"talker.model.layers.{l}."
+        for n in ("self_attn.q_norm.weight", "self_attn.k_norm.weight"):
+            tensors[f"model.layers.{l}.{n}"] = f.get_tensor(p + n)
+        for n, w in norms.items():
+            tensors[f"model.layers.{l}.{n}"] = w
+        for n in PARENT:
+            name = f"{PARENT[n]}.{n}.weight"
+            tensors[f"model.layers.{l}.{name}"] = q4nx.pack(*quant[name])
+        print(f"layer {l} done ({time.time() - t0:.0f}s)", flush=True)
+    tensors["model.norm.weight"] = f.get_tensor("talker.model.norm.weight")
+    tensors["lm_head.weight"] = q4nx.identity_head(VOCAB, D)
+    a.out.mkdir(parents=True, exist_ok=True)
+    q4nx.write(a.out / "model.q4nx", tensors)
+    q4nx.write_config(HERE / "configs/Qwen3-1.7B-NPU2.json", sub, VOCAB, a.out / "config.json")
+    print("wrote", a.out)
+
+
+if __name__ == "__main__":
+    main()
