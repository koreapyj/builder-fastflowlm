# Upstream FastFlowLM the patches apply to. Read by support/prepare-source.sh (CI and
# the Makefile). FLM_REF may be a tag or a commit; the Qwen3-TTS integration was
# validated at this commit (v1.0.9-41-gd8767c0a). Moving it: see README "Updating FLM_REF".
FLM_REPO=https://github.com/ROCm/FastFlowLM.git
FLM_REF=d8767c0a08febd4037356546d2df1bba99bba76e
# `git describe --tags --always` of FLM_REF: the version upstream's CI derives from it.
# Packages and releases are versioned <this>+g<this repository's commit>.
FLM_DESCRIBE=v1.0.9-41-gd8767c0a
